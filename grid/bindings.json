// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.grid/normal", "bindings": [
      {"key": "z >", "action": "ochazuke.grid.resize-column", "args": {"delta": 1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z <", "action": "ochazuke.grid.resize-column", "args": {"delta": -1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z =", "action": "ochazuke.grid.reset-columns", "hidden": true}
    ]},
    {"context": "ochazuke.grid/count_pending", "extends": "normal", "bindings": []}
  ]
}
