// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.collection/normal", "bindings": [
      {"key": "h", "action": "ochazuke.collection.column", "args": {"delta": -1}, "when": "table-column-left", "from": {"steps": "count"}},
      {"key": "h", "action": "ochazuke.collection.scroll-columns", "args": {"delta": -1}, "when": "table-scrolls-left", "from": {"steps": "count"}},
      {"key": "h", "action": "ochazuke.focus.previous", "when": "table-spills-left"},
      {"key": "h", "action": "ochazuke.collection.column", "args": {"delta": -1}, "when": "table-cells", "from": {"steps": "count"}},
      {"key": "h", "action": "ochazuke.collection.scroll-columns", "args": {"delta": -1}, "when": "table-scrolls-clamp", "from": {"steps": "count"}},
      {"key": "left", "action": "ochazuke.collection.column", "args": {"delta": -1}, "when": "table-column-left", "from": {"steps": "count"}},
      {"key": "left", "action": "ochazuke.collection.scroll-columns", "args": {"delta": -1}, "when": "table-scrolls-left", "from": {"steps": "count"}},
      {"key": "left", "action": "ochazuke.focus.previous", "when": "table-spills-left"},
      {"key": "left", "action": "ochazuke.collection.column", "args": {"delta": -1}, "when": "table-cells", "from": {"steps": "count"}},
      {"key": "left", "action": "ochazuke.collection.scroll-columns", "args": {"delta": -1}, "when": "table-scrolls-clamp", "from": {"steps": "count"}},
      {"key": "l", "action": "ochazuke.collection.column", "args": {"delta": 1}, "when": "table-column-right", "from": {"steps": "count"}},
      {"key": "l", "action": "ochazuke.collection.scroll-columns", "args": {"delta": 1}, "when": "table-scrolls-right", "from": {"steps": "count"}},
      {"key": "l", "action": "ochazuke.focus.next", "when": "table-spills-right"},
      {"key": "l", "action": "ochazuke.collection.column", "args": {"delta": 1}, "when": "table-cells", "from": {"steps": "count"}},
      {"key": "l", "action": "ochazuke.collection.scroll-columns", "args": {"delta": 1}, "when": "table-scrolls-clamp", "from": {"steps": "count"}},
      {"key": "right", "action": "ochazuke.collection.column", "args": {"delta": 1}, "when": "table-column-right", "from": {"steps": "count"}},
      {"key": "right", "action": "ochazuke.collection.scroll-columns", "args": {"delta": 1}, "when": "table-scrolls-right", "from": {"steps": "count"}},
      {"key": "right", "action": "ochazuke.focus.next", "when": "table-spills-right"},
      {"key": "right", "action": "ochazuke.collection.column", "args": {"delta": 1}, "when": "table-cells", "from": {"steps": "count"}},
      {"key": "right", "action": "ochazuke.collection.scroll-columns", "args": {"delta": 1}, "when": "table-scrolls-clamp", "from": {"steps": "count"}},
      {"key": "home", "action": "ochazuke.collection.column", "args": {"to": "first"}, "when": "table-cells"},
      {"key": "end", "action": "ochazuke.collection.column", "args": {"to": "last"}, "when": "table-cells"},
      {"key": "$", "action": "ochazuke.collection.column", "args": {"to": "last"}, "when": "table-cells"},
      {"key": "^", "action": "ochazuke.collection.column", "args": {"to": "first"}, "when": "table-cells"},
      {"key": "0", "action": "ochazuke.collection.column", "args": {"to": "first"}, "when": "no-count"},
      {"key": "|", "action": "ochazuke.collection.column", "when": "table-cells", "from": {"index": "count"}},
      {"key": "g c", "action": "ochazuke.collection.choose-column"},
      {"key": "y", "action": "ochazuke.collection.yank", "args": {"what": "cell"}, "when": "table-cells", "hidden": true},
      {"key": "Y", "action": "ochazuke.collection.yank", "args": {"what": "row"}, "hidden": true},
      {"key": "z >", "action": "ochazuke.collection.resize-column", "args": {"delta": 1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z <", "action": "ochazuke.collection.resize-column", "args": {"delta": -1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z f", "action": "ochazuke.collection.fit-column", "from": {"width": "line"}, "hidden": true},
      {"key": "z F", "action": "ochazuke.collection.fit-columns", "hidden": true},
      {"key": "z =", "action": "ochazuke.collection.reset-columns", "hidden": true},
      {"key": "z p", "action": "ochazuke.collection.toggle-pin-column", "when": "table-cells", "hidden": true},
      {"key": "$", "action": "ochazuke.collection.scroll-columns", "args": {"to": "last"}},
      {"key": "^", "action": "ochazuke.collection.scroll-columns", "args": {"to": "first"}},
      {"key": "0", "action": "ochazuke.collection.scroll-columns", "args": {"to": "first"}, "when": "row-table-no-count"}
    ]}
  ]
}
