// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "modes": {
    "leader_pending": {"pending": true},
    "terminal": {"passthrough": true}
  },
  "bindings": [
    {"context": "ochazuke.terminal/leader_pending", "bindings": [
      {"key": "d", "action": "ochazuke.terminal.detach"},
      {"key": "o", "action": "ochazuke.focus.next", "hidden": true},
      {"key": "a", "action": "ochazuke.terminal.send", "args": {"keys": "{terminal-leader}"}, "hidden": true},
      {"key": "{terminal-leader}", "action": "ochazuke.terminal.send", "args": {"keys": "{terminal-leader}"}}
    ]},
    {"context": "ochazuke.terminal/terminal", "bindings": [
      {"key": "{terminal-leader}", "action": "ochazuke.mode.enter", "args": {"mode": "leader_pending", "prefix": "{terminal-leader}", "request": {"args": {"keys": "{terminal-leader}"}, "noun": "ochazuke.terminal", "verb": "send"}}, "hint": "leader: d detaches, {terminal-leader} sends {terminal-leader}"},
      {"key": "paste", "action": "ochazuke.terminal.paste", "from": {"text": "text"}, "hidden": true},
      {"key": "any", "action": "ochazuke.terminal.send", "from": {"keys": "key"}, "hidden": true}
    ]}
  ]
}
