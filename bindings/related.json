// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.related-section/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.related-section.toggle", "when": "related-on-heading"},
      {"key": "z a", "action": "ochazuke.related-section.toggle", "hidden": true},
      {"key": "z o", "action": "ochazuke.related-section.open", "hidden": true},
      {"key": "z c", "action": "ochazuke.related-section.close", "hidden": true},
      {"key": "z R", "action": "ochazuke.related-section.open-all"},
      {"key": "z M", "action": "ochazuke.related-section.close-all"},
      {"key": "] ]", "action": "ochazuke.related-section.next", "hidden": true},
      {"key": "[ [", "action": "ochazuke.related-section.previous", "hidden": true},
      {"key": "n", "action": "ochazuke.related-section.new", "when": "related-on-heading"},
      {"key": "a", "action": "ochazuke.related-section.associate", "when": "related-on-heading"},
      {"key": "d u", "action": "ochazuke.related-section.unassociate", "when": "related-on-row"},
      {"key": "g f", "action": "ochazuke.related-section.jump", "hint": "jump"},
      {"key": "enter", "action": "ochazuke.related-section.jump", "when": "related-on-row", "hidden": true},
      {"key": "F", "action": "ochazuke.related-section.create", "hidden": true},
      {"key": "r", "action": "ochazuke.related-section.edit", "hidden": true},
      {"key": "b", "action": "ochazuke.related-section.first", "hidden": true},
      {"key": "v", "action": "ochazuke.related-section.get", "hidden": true},
      {"key": "H", "action": "ochazuke.related-section.history", "hidden": true},
      {"key": "c", "action": "ochazuke.related-section.last", "hidden": true},
      {"key": "ctrl+g", "action": "ochazuke.related-section.list", "hidden": true},
      {"key": "m", "action": "ochazuke.related-section.move-down", "hidden": true},
      {"key": "o", "action": "ochazuke.related-section.move-up", "hidden": true},
      {"key": "g r", "action": "ochazuke.related-section.refresh", "hidden": true},
      {"key": "*", "action": "ochazuke.related-section.set", "hidden": true},
      {"key": "g v", "action": "ochazuke.related-section.show", "hidden": true},
      {"key": "w", "action": "ochazuke.related-section.watch", "hidden": true},
      {"key": "p", "action": "ochazuke.related-section.yank", "hidden": true},
      {"key": "X", "action": "ochazuke.related-section.duplicate", "hidden": true},
      {"key": "ctrl+h", "action": "ochazuke.related-section.hide", "hidden": true},
      {"key": "ctrl+n", "action": "ochazuke.related-section.restore", "hidden": true}
    ]}
  ]
}
