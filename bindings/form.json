// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.form/normal", "bindings": [
      {"key": "q", "action": "ochazuke.form.leave", "when": "no-modal", "help": "Leave a form placed on a page; in a modal form q reaches the modal noun (modal.close, which leaves it) and esc leaves insert"},
      {"key": "esc", "action": "ochazuke.form.leave", "when": "no-modal", "help": "Leave a form placed on a page; in a modal form q reaches the modal noun (modal.close, which leaves it) and esc leaves insert"},
      {"key": "u", "action": "ochazuke.form.undo", "when": "input-no-undo"},
      {"key": "ctrl+r", "action": "ochazuke.form.redo", "when": "input-no-redo"},
      {"key": "C", "action": "ochazuke.form.clear", "hint": "clear"},
      {"key": "f", "action": "ochazuke.form.choose", "hidden": true},
      {"key": "s", "action": "ochazuke.form.item-move-down", "hidden": true},
      {"key": "t", "action": "ochazuke.form.item-move-up", "hidden": true},
      {"key": "F", "action": "ochazuke.form.next", "hidden": true},
      {"key": "ctrl+h", "action": "ochazuke.form.chip-toggle", "hidden": true},
      {"key": "ctrl+n", "action": "ochazuke.form.invert", "hidden": true},
      {"key": "ctrl+q", "action": "ochazuke.form.item-add", "hidden": true},
      {"key": "ctrl+s", "action": "ochazuke.form.item-delete", "hidden": true},
      {"key": "ctrl+z", "action": "ochazuke.form.item-edit", "hidden": true},
      {"key": "alt+b", "action": "ochazuke.form.item-first", "hidden": true},
      {"key": "alt+c", "action": "ochazuke.form.item-last", "hidden": true},
      {"key": "alt+d", "action": "ochazuke.form.item-next", "hidden": true},
      {"key": "alt+f", "action": "ochazuke.form.item-previous", "hidden": true},
      {"key": "alt+g", "action": "ochazuke.form.item-yank", "hidden": true},
      {"key": "alt+i", "action": "ochazuke.form.next-missing", "hidden": true},
      {"key": "alt+j", "action": "ochazuke.form.previous", "hidden": true},
      {"key": "alt+k", "action": "ochazuke.form.run", "hidden": true},
      {"key": "alt+enter", "action": "ochazuke.form.run", "when": "form-enter-moves", "hint": "run"},
      {"key": "alt+l", "action": "ochazuke.form.suggest", "hidden": true}
    ]},
    {"context": "ochazuke.form/insert", "bindings": [
      {"key": "alt+enter", "action": "ochazuke.form.run", "when": "form-enter-moves", "hint": "run"}
    ]},
    {"context": "ochazuke.form-chip/normal", "bindings": [
      {"key": "j", "action": "ochazuke.form.chip-line", "args": {"delta": 1}},
      {"key": "down", "action": "ochazuke.form.chip-line", "args": {"delta": 1}},
      {"key": "j", "action": "ochazuke.form.next"},
      {"key": "down", "action": "ochazuke.form.next"},
      {"key": "k", "action": "ochazuke.form.chip-line", "args": {"delta": -1}},
      {"key": "up", "action": "ochazuke.form.chip-line", "args": {"delta": -1}},
      {"key": "k", "action": "ochazuke.form.previous"},
      {"key": "up", "action": "ochazuke.form.previous"},
      {"key": "l", "action": "ochazuke.form.chip-move", "args": {"delta": 1}},
      {"key": "right", "action": "ochazuke.form.chip-move", "args": {"delta": 1}},
      {"key": "h", "action": "ochazuke.form.chip-move", "args": {"delta": -1}},
      {"key": "left", "action": "ochazuke.form.chip-move", "args": {"delta": -1}},
      {"key": "space", "action": "ochazuke.form.chip-toggle", "hint": "toggle"},
      {"key": "!", "action": "ochazuke.form.invert", "hint": "not"},
      {"key": "0", "action": "ochazuke.form.chip-edge", "args": {"edge": "first-col"}, "hidden": true},
      {"key": "$", "action": "ochazuke.form.chip-edge", "args": {"edge": "last-col"}, "hidden": true},
      {"key": "g g", "action": "ochazuke.form.chip-edge", "args": {"edge": "first"}, "hidden": true},
      {"key": "G", "action": "ochazuke.form.chip-edge", "args": {"edge": "last"}, "hidden": true}
    ]},
    {"context": "ochazuke.form-item/normal", "bindings": [
      {"key": "j", "action": "ochazuke.form.item-next"},
      {"key": "down", "action": "ochazuke.form.item-next"},
      {"key": "k", "action": "ochazuke.form.item-previous"},
      {"key": "up", "action": "ochazuke.form.item-previous"},
      {"key": "enter", "action": "ochazuke.form.item-edit", "hint": "enter/i form.item-edit"},
      {"key": "i", "action": "ochazuke.form.item-edit", "hidden": true},
      {"key": "n", "action": "ochazuke.form.item-add"},
      {"key": "d d", "action": "ochazuke.form.item-delete"},
      {"key": "g g", "action": "ochazuke.form.item-first", "hidden": true},
      {"key": "G", "action": "ochazuke.form.item-last", "hidden": true}
    ]},
    {"context": "ochazuke.form-choice/normal", "bindings": [
      {"key": "j", "action": "ochazuke.form.next"},
      {"key": "down", "action": "ochazuke.form.next"},
      {"key": "k", "action": "ochazuke.form.previous"},
      {"key": "up", "action": "ochazuke.form.previous"},
      {"key": "enter", "action": "ochazuke.form.run", "when": "form-enter-runs"},
      {"key": "enter", "action": "ochazuke.form.next-missing"},
      {"key": "enter", "action": "ochazuke.form.choose"},
      {"key": "space", "action": "ochazuke.form.choose"},
      {"key": "i", "action": "ochazuke.form.choose"},
      {"key": "/", "action": "ochazuke.form.suggest"}
    ]},
    {"context": "ochazuke.form-field/insert", "bindings": [
      {"key": "enter", "action": "ochazuke.form.run", "when": "form-enter-runs"},
      {"key": "enter", "action": "ochazuke.form.next-missing", "args": {"insert": true}},
      {"key": "enter", "action": "ochazuke.form.leave", "when": "form-one-field", "help": "In a form of one field that writes each change (edit {field}: r, m), enter writes it and closes the form"},
      {"key": "enter", "action": "ochazuke.form.next", "args": {"insert": true}},
      {"key": "tab", "action": "ochazuke.form.next", "args": {"insert": true}},
      {"key": "shift+tab", "action": "ochazuke.form.previous", "args": {"insert": true}}
    ]},
    {"context": "ochazuke.form-field/normal", "bindings": [
      {"key": "!", "action": "ochazuke.form.invert", "hint": "not"},
      {"key": "enter", "action": "ochazuke.form.run", "when": "form-enter-runs"},
      {"key": "enter", "action": "ochazuke.form.next-missing"},
      {"key": "enter", "action": "ochazuke.form.leave", "when": "form-one-field", "help": "In a form of one field that writes each change (edit {field}: r, m), enter writes it and closes the form"},
      {"key": "enter", "action": "ochazuke.form.next", "when": "form-enter-moves", "help": "In a form whose enter never runs it (RecordSpec.EnterMoves), enter moves to the next field and alt+enter runs it"},
      {"key": "j", "action": "ochazuke.form.next"},
      {"key": "down", "action": "ochazuke.form.next"},
      {"key": "k", "action": "ochazuke.form.previous"},
      {"key": "up", "action": "ochazuke.form.previous"}
    ]},
    {"context": "ochazuke.form-option/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.form-option.pick"},
      {"key": "space", "action": "ochazuke.form-option.pick"}
    ]},
    {"context": "ochazuke.form-suggest/insert", "bindings": [
      {"key": "enter", "action": "ochazuke.form.run", "when": "form-enter-runs"},
      {"key": "enter", "action": "ochazuke.form.next-missing", "args": {"insert": true}},
      {"key": "enter", "action": "ochazuke.form.next", "args": {"insert": true}},
      {"key": "tab", "action": "ochazuke.form.next", "args": {"insert": true}},
      {"key": "shift+tab", "action": "ochazuke.form.previous", "args": {"insert": true}},
      {"key": "ctrl+space", "action": "ochazuke.form.suggest"}
    ]},
    {"context": "ochazuke.form-suggest/normal", "bindings": [
      {"key": "j", "action": "ochazuke.form.next"},
      {"key": "down", "action": "ochazuke.form.next"},
      {"key": "k", "action": "ochazuke.form.previous"},
      {"key": "up", "action": "ochazuke.form.previous"},
      {"key": "enter", "action": "ochazuke.form.run", "when": "form-enter-runs"},
      {"key": "enter", "action": "ochazuke.form.next-missing"},
      {"key": "enter", "action": "ochazuke.form.suggest"},
      {"key": "ctrl+space", "action": "ochazuke.form.suggest"}
    ]},
    {"context": "ochazuke.form-text/insert", "bindings": [
      {"key": "tab", "action": "ochazuke.form.next", "args": {"insert": true}},
      {"key": "shift+tab", "action": "ochazuke.form.previous", "args": {"insert": true}}
    ]}
  ]
}
