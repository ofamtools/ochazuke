{
  "bindings": [
    {"context": "ochazuke.form/normal", "bindings": {
      "q": "ochazuke.form.leave",
      "esc": "ochazuke.form.leave",
      "u": "ochazuke.form.undo",
      "ctrl+r": "ochazuke.form.redo"
    }},
    {"context": "ochazuke.form-choice/normal", "bindings": {
      "j": "ochazuke.form.next",
      "down": "ochazuke.form.next",
      "k": "ochazuke.form.previous",
      "up": "ochazuke.form.previous",
      "enter": "ochazuke.form.choose",
      "space": "ochazuke.form.choose",
      "i": "ochazuke.form.choose"
    }},
    {"context": "ochazuke.form-field/insert", "bindings": {
      "enter": {"action": "ochazuke.form.next", "args": {"insert": true}},
      "tab": {"action": "ochazuke.form.next", "args": {"insert": true}},
      "shift+tab": {"action": "ochazuke.form.previous", "args": {"insert": true}}
    }},
    {"context": "ochazuke.form-field/normal", "bindings": {
      "j": "ochazuke.form.next",
      "down": "ochazuke.form.next",
      "k": "ochazuke.form.previous",
      "up": "ochazuke.form.previous"
    }},
    {"context": "ochazuke.form-option/normal", "bindings": {
      "enter": "ochazuke.form-option.pick",
      "space": "ochazuke.form-option.pick",
      "q": "ochazuke.modal.pop"
    }},
    {"context": "ochazuke.form-suggest/insert", "bindings": {
      "enter": {"action": "ochazuke.form.next", "args": {"insert": true}},
      "tab": {"action": "ochazuke.form.next", "args": {"insert": true}},
      "shift+tab": {"action": "ochazuke.form.previous", "args": {"insert": true}},
      "ctrl+space": "ochazuke.form.suggest"
    }},
    {"context": "ochazuke.form-suggest/normal", "bindings": {
      "j": "ochazuke.form.next",
      "down": "ochazuke.form.next",
      "k": "ochazuke.form.previous",
      "up": "ochazuke.form.previous",
      "enter": "ochazuke.form.suggest",
      "ctrl+space": "ochazuke.form.suggest"
    }},
    {"context": "ochazuke.form-text/insert", "bindings": {
      "tab": {"action": "ochazuke.form.next", "args": {"insert": true}},
      "shift+tab": {"action": "ochazuke.form.previous", "args": {"insert": true}}
    }}
  ]
}
