// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "modes": {
    "count_pending": {"pending": true},
    "macro_pending": {"pending": true},
    "register_pending": {"pending": true},
    "replay_pending": {"pending": true}
  },
  "bindings": [
    {"context": "app/count_pending", "extends": "normal", "bindings": [
      {"key": "0", "action": "ochazuke.count.append", "args": {"digit": 0}},
      {"key": "digit", "action": "ochazuke.count.append", "from": {"digit": "digit"}},
      {"key": "any", "action": "ochazuke.mode.leave", "when": "no-input", "replay": true}
    ]},
    {"context": "app/macro_pending", "bindings": [
      {"key": "esc", "action": "ochazuke.input.cancel"},
      {"key": "any", "action": "ochazuke.macro.start", "from": {"register": "key"}}
    ]},
    {"context": "app/normal", "bindings": [
      {"key": "\"", "action": "ochazuke.mode.enter", "args": {"mode": "register_pending"}, "hidden": true, "help": "Pick the register the next yank, delete or paste uses (\"a)"},
      {"key": "q", "action": "ochazuke.mode.enter", "args": {"mode": "macro_pending"}, "hidden": true, "help": "Record a macro into the register typed next (qa); q again stops"},
      {"key": "@", "action": "ochazuke.mode.enter", "args": {"mode": "replay_pending"}, "from": {"count": "count"}, "hidden": true, "help": "Replay the macro in the register typed next (@a), count times"},
      {"key": "digit-0", "action": "ochazuke.mode.enter", "args": {"mode": "count_pending"}, "from": {"count": "digit"}, "hidden": true, "help": "Start a count for the next key (3j)"}
    ]},
    {"context": "app/register_pending", "bindings": [
      {"key": "esc", "action": "ochazuke.input.cancel"},
      {"key": "any", "action": "ochazuke.register.select", "from": {"name": "key"}}
    ]},
    {"context": "app/replay_pending", "bindings": [
      {"key": "esc", "action": "ochazuke.input.cancel"},
      {"key": "any", "action": "ochazuke.macro.replay", "from": {"register": "key", "steps": "count"}}
    ]},
    {"context": "app/visual", "bindings": [
      {"key": "\"", "action": "ochazuke.mode.enter", "args": {"mode": "register_pending"}, "hidden": true, "help": "Pick the register the next yank, delete or paste uses (\"a)"},
      {"key": "q", "action": "ochazuke.mode.enter", "args": {"mode": "macro_pending"}, "hidden": true, "help": "Record a macro into the register typed next (qa); q again stops"},
      {"key": "@", "action": "ochazuke.mode.enter", "args": {"mode": "replay_pending"}, "from": {"count": "count"}, "hidden": true, "help": "Replay the macro in the register typed next (@a), count times"}
    ]},
    {"context": "app/visual_count_pending", "extends": "visual", "bindings": []},
    {"context": "app/visual-line", "extends": "visual", "bindings": []},
    {"context": "app/visual-block", "extends": "visual", "bindings": []}
  ]
}
