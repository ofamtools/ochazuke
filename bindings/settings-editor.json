// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.setting/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting.edit", "args": {"scope": "file"}},
      {"key": "l", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "right", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "space", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "h", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "hint": "h/l setting.cycle", "when": "setting-steps"},
      {"key": "left", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "n", "action": "ochazuke.setting.add", "when": "setting-list"},
      {"key": "r", "action": "ochazuke.setting.reset", "args": {"scope": "file"}},
      {"key": "backspace", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true},
      {"key": "delete", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true}
    ]},
    {"context": "ochazuke.setting-item/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-item.edit", "hint": "enter/i setting-item.edit"},
      {"key": "i", "action": "ochazuke.setting-item.edit", "hidden": true},
      {"key": "n", "action": "ochazuke.setting-item.add"},
      {"key": "d d", "action": "ochazuke.setting-item.delete"},
      {"key": "r", "action": "ochazuke.setting-item.reset"}
    ]},
    {"context": "ochazuke.setting-value/insert", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-value.commit"},
      {"key": "esc", "action": "ochazuke.setting-value.cancel"}
    ]},
    {"context": "ochazuke.settings-page/normal", "bindings": [
      {"key": "tab", "action": "ochazuke.settings.section", "args": {"step": 1}},
      {"key": "]", "action": "ochazuke.settings.section", "args": {"step": 1}, "hidden": true},
      {"key": "shift+tab", "action": "ochazuke.settings.section", "args": {"step": -1}, "hidden": true},
      {"key": "[", "action": "ochazuke.settings.section", "args": {"step": -1}, "hidden": true},
      {"key": "u", "action": "ochazuke.settings.undo", "when": "settings-undo"},
      {"key": "ctrl+z", "action": "ochazuke.settings.undo", "when": "settings-undo", "hidden": true},
      {"key": "q", "action": "ochazuke.settings.close"},
      {"key": "esc", "action": "ochazuke.settings.close"}
    ]}
  ]
}
