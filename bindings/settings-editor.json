// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.setting/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting.edit", "args": {"scope": "file"}},
      {"key": "l", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "right", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "space", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "h", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "hint": "h/l setting.cycle", "when": "setting-steps"},
      {"key": "left", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "n", "action": "ochazuke.setting.add", "when": "setting-list"},
      {"key": "r", "action": "ochazuke.setting.reset", "args": {"scope": "file"}},
      {"key": "backspace", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true},
      {"key": "delete", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true},
      {"key": "h", "action": "ochazuke.focus.previous", "hidden": true}
    ]},
    {"context": "ochazuke.settings-section/normal", "bindings": [
      {"key": "l", "action": "ochazuke.settings.section", "args": {"step": 1}, "when": "settings-narrow", "hidden": true},
      {"key": "right", "action": "ochazuke.settings.section", "args": {"step": 1}, "when": "settings-narrow", "hidden": true},
      {"key": "h", "action": "ochazuke.settings.section", "args": {"step": -1}, "when": "settings-narrow", "hint": "h/l settings.section"},
      {"key": "left", "action": "ochazuke.settings.section", "args": {"step": -1}, "when": "settings-narrow", "hidden": true},
      {"key": "j", "action": "ochazuke.settings-section.open", "when": "settings-narrow", "hidden": true},
      {"key": "down", "action": "ochazuke.settings-section.open", "when": "settings-narrow", "hidden": true},
      {"key": "s", "action": "ochazuke.settings-section.pick", "when": "settings-narrow"},
      {"key": "enter", "action": "ochazuke.settings-section.pick", "when": "settings-narrow", "hidden": true},
      {"key": "l", "action": "ochazuke.settings-section.open", "hint": "l/enter settings-section.open"},
      {"key": "right", "action": "ochazuke.settings-section.open", "hidden": true},
      {"key": "enter", "action": "ochazuke.settings-section.open", "hidden": true}
    ]},
    {"context": "ochazuke.setting-item/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-item.edit", "hint": "enter/i setting-item.edit"},
      {"key": "i", "action": "ochazuke.setting-item.edit", "hidden": true},
      {"key": "n", "action": "ochazuke.setting-item.add"},
      {"key": "d d", "action": "ochazuke.setting-item.delete"},
      {"key": "r", "action": "ochazuke.setting-item.reset"}
    ]},
    {"context": "ochazuke.setting-value/insert", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-value.commit"},
      {"key": "esc", "action": "ochazuke.setting-value.cancel"}
    ]},
    {"context": "ochazuke.settings-page/normal", "bindings": [
      {"key": "]", "action": "ochazuke.settings.tab", "args": {"step": 1}, "hint": "]/[ settings.tab"},
      {"key": "[", "action": "ochazuke.settings.tab", "args": {"step": -1}, "hidden": true},
      {"key": "g t", "action": "ochazuke.settings.tab", "args": {"step": 1}, "hidden": true},
      {"key": "g T", "action": "ochazuke.settings.tab", "args": {"step": -1}, "hidden": true},
      {"key": "tab", "action": "ochazuke.settings.section", "args": {"step": 1, "across": true}, "hidden": true},
      {"key": "shift+tab", "action": "ochazuke.settings.section", "args": {"step": -1, "across": true}, "hidden": true},
      {"key": "A", "action": "ochazuke.settings.all"},
      {"key": "u", "action": "ochazuke.settings.undo", "when": "settings-undo"},
      {"key": "ctrl+z", "action": "ochazuke.settings.undo", "when": "settings-undo", "hidden": true},
      {"key": "q", "action": "ochazuke.settings.close"},
      {"key": "esc", "action": "ochazuke.settings.close"}
    ]},
    {"context": "ochazuke.setting-change/normal", "bindings": [
      {"key": "w", "action": "ochazuke.setting.write", "from": {"name": "row:name"}},
      {"key": "r", "action": "ochazuke.setting.revert", "from": {"name": "row:name"}},
      {"key": "s", "action": "ochazuke.list.move", "args": {"delta": 1}, "hint": "skip"},
      {"key": "space", "action": "ochazuke.list.move", "args": {"delta": 1}, "hidden": true}
    ]},
    {"context": "ochazuke.settings-review/normal", "bindings": [
      {"key": "W", "action": "ochazuke.settings.write"},
      {"key": "R", "action": "ochazuke.settings.revert"},
      {"key": "q", "action": "ochazuke.modal.pop"}
    ]}
  ]
}
