// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.setting/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting.edit", "args": {"scope": "file"}},
      {"key": "l", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "right", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "space", "action": "ochazuke.setting.cycle", "args": {"step": 1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "h", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "hint": "h/l setting.cycle", "when": "setting-steps"},
      {"key": "left", "action": "ochazuke.setting.cycle", "args": {"step": -1, "scope": "file"}, "when": "setting-steps", "hidden": true},
      {"key": "n", "action": "ochazuke.setting.add", "when": "setting-list"},
      {"key": "r", "action": "ochazuke.setting.reset", "args": {"scope": "file"}},
      {"key": "backspace", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true},
      {"key": "delete", "action": "ochazuke.setting.reset", "args": {"scope": "file"}, "hidden": true},
      {"key": "h", "action": "ochazuke.focus.previous", "hidden": true},
      {"key": "a", "action": "ochazuke.setting.append", "hidden": true},
      {"key": "b", "action": "ochazuke.setting.apply", "hidden": true},
      {"key": "d a", "action": "ochazuke.setting.archive", "hidden": true},
      {"key": "c", "action": "ochazuke.setting.complete", "hidden": true},
      {"key": "F", "action": "ochazuke.setting.create", "hidden": true},
      {"key": "e", "action": "ochazuke.setting.decrease", "hidden": true},
      {"key": "d d", "action": "ochazuke.setting.delete", "hidden": true},
      {"key": "f", "action": "ochazuke.setting.diff", "hidden": true},
      {"key": "v", "action": "ochazuke.setting.get", "hidden": true},
      {"key": "H", "action": "ochazuke.setting.history", "hidden": true},
      {"key": "m", "action": "ochazuke.setting.increase", "hidden": true},
      {"key": "ctrl+g", "action": "ochazuke.setting.list", "hidden": true},
      {"key": "o", "action": "ochazuke.setting.multiply", "hidden": true},
      {"key": "p", "action": "ochazuke.setting.prepend", "hidden": true},
      {"key": "t", "action": "ochazuke.setting.reload", "hidden": true},
      {"key": "d D", "action": "ochazuke.setting.remove", "hidden": true},
      {"key": "d b", "action": "ochazuke.setting.reset-all", "hidden": true},
      {"key": "w", "action": "ochazuke.setting.revert", "hidden": true},
      {"key": "x", "action": "ochazuke.setting.revert-all", "hidden": true},
      {"key": "B", "action": "ochazuke.setting.sections", "hidden": true},
      {"key": "*", "action": "ochazuke.setting.set", "hidden": true},
      {"key": "g v", "action": "ochazuke.setting.show", "hidden": true},
      {"key": "z a", "action": "ochazuke.setting.toggle", "hidden": true},
      {"key": "alt+m", "action": "ochazuke.setting.watch", "hidden": true},
      {"key": "C", "action": "ochazuke.setting.write", "hidden": true},
      {"key": "D", "action": "ochazuke.setting.write-all", "hidden": true},
      {"key": "E", "action": "ochazuke.setting.yank", "hidden": true}
    ]},
    {"context": "ochazuke.settings-section/normal", "bindings": [
      {"key": "l", "action": "ochazuke.setting.show-section", "args": {"step": 1}, "when": "settings-narrow", "hidden": true},
      {"key": "right", "action": "ochazuke.setting.show-section", "args": {"step": 1}, "when": "settings-narrow", "hidden": true},
      {"key": "h", "action": "ochazuke.setting.show-section", "args": {"step": -1}, "when": "settings-narrow", "hint": "h/l setting.show-section"},
      {"key": "left", "action": "ochazuke.setting.show-section", "args": {"step": -1}, "when": "settings-narrow", "hidden": true},
      {"key": "j", "action": "ochazuke.settings-section.open", "when": "settings-narrow", "hidden": true},
      {"key": "down", "action": "ochazuke.settings-section.open", "when": "settings-narrow", "hidden": true},
      {"key": "s", "action": "ochazuke.settings-section.pick", "when": "settings-narrow"},
      {"key": "enter", "action": "ochazuke.settings-section.pick", "when": "settings-narrow", "hidden": true},
      {"key": "l", "action": "ochazuke.settings-section.open", "hint": "l/enter settings-section.open"},
      {"key": "right", "action": "ochazuke.settings-section.open", "hidden": true},
      {"key": "enter", "action": "ochazuke.settings-section.open", "hidden": true},
      {"key": "r", "action": "ochazuke.settings-section.reset", "hidden": true},
      {"key": "w", "action": "ochazuke.settings-section.revert", "hidden": true},
      {"key": "C", "action": "ochazuke.settings-section.write", "hidden": true},
      {"key": "p", "action": "ochazuke.settings-section.yank", "hidden": true}
    ]},
    {"context": "ochazuke.setting-item/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-item.edit", "hint": "enter/i setting-item.edit"},
      {"key": "i", "action": "ochazuke.setting-item.edit", "hidden": true},
      {"key": "n", "action": "ochazuke.setting-item.add"},
      {"key": "d d", "action": "ochazuke.setting-item.delete"},
      {"key": "r", "action": "ochazuke.setting-item.reset"},
      {"key": "d a", "action": "ochazuke.setting-item.archive", "hidden": true},
      {"key": "F", "action": "ochazuke.setting-item.create", "hidden": true},
      {"key": "M", "action": "ochazuke.setting-item.get", "hidden": true},
      {"key": "H", "action": "ochazuke.setting-item.history", "hidden": true},
      {"key": "ctrl+g", "action": "ochazuke.setting-item.list", "hidden": true},
      {"key": "*", "action": "ochazuke.setting-item.set", "hidden": true},
      {"key": "w", "action": "ochazuke.setting-item.watch", "hidden": true}
    ]},
    {"context": "ochazuke.setting-value/insert", "bindings": [
      {"key": "enter", "action": "ochazuke.setting-value.accept"},
      {"key": "esc", "action": "ochazuke.modal.close", "when": "setting:modal.esc-closes"},
      {"key": "esc", "action": "ochazuke.mode.switch", "args": {"mode": "normal"}, "when": "input-unpinned", "hint": "normal"}
    ]},
    {"context": "ochazuke.settings-page/normal", "bindings": [
      {"key": "]", "action": "ochazuke.setting.show-tab", "args": {"step": 1}, "hint": "]/[ setting.show-tab"},
      {"key": "[", "action": "ochazuke.setting.show-tab", "args": {"step": -1}, "hidden": true},
      {"key": "g t", "action": "ochazuke.setting.show-tab", "args": {"step": 1}, "hidden": true},
      {"key": "g T", "action": "ochazuke.setting.show-tab", "args": {"step": -1}, "hidden": true},
      {"key": "tab", "action": "ochazuke.setting.show-section", "args": {"step": 1, "across": true}, "hidden": true},
      {"key": "shift+tab", "action": "ochazuke.setting.show-section", "args": {"step": -1, "across": true}, "hidden": true},
      {"key": "A", "action": "ochazuke.setting.all"},
      {"key": "u", "action": "ochazuke.setting.undo", "when": "settings-undo"},
      {"key": "ctrl+z", "action": "ochazuke.setting.undo", "when": "settings-undo", "hidden": true},
      {"key": "q", "action": "ochazuke.setting.close"},
      {"key": "esc", "action": "ochazuke.setting.close", "when": "setting:modal.esc-closes"}
    ]},
    {"context": "ochazuke.setting-change/normal", "bindings": [
      {"key": "w", "action": "ochazuke.setting.write", "from": {"name": "row:name"}},
      {"key": "r", "action": "ochazuke.setting.revert", "from": {"name": "row:name"}},
      {"key": "s", "action": "ochazuke.collection.move", "args": {"delta": 1}, "hint": "skip"},
      {"key": "space", "action": "ochazuke.collection.move", "args": {"delta": 1}, "hidden": true}
    ]},
    {"context": "ochazuke.settings-review/normal", "bindings": [
      {"key": "W", "action": "ochazuke.setting.write-all"},
      {"key": "R", "action": "ochazuke.setting.revert-all"}
    ]}
  ]
}
