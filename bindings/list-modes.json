// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "modes": {
    "list_filter": {}
  },
  "bindings": [
    {"context": "ochazuke.list/list_filter", "bindings": [
      {"key": "printable", "action": "ochazuke.list.filter-type", "from": {"text": "text"}, "hidden": true},
      {"key": "paste", "action": "ochazuke.list.filter-type", "from": {"text": "text"}, "hidden": true},
      {"key": "space", "action": "ochazuke.list.filter-type", "args": {"text": " "}, "hidden": true},
      {"key": "backspace", "action": "ochazuke.list.filter-keep", "when": "list-unfiltered", "hidden": true},
      {"key": "backspace", "action": "ochazuke.list.filter-erase", "hidden": true},
      {"key": "ctrl+h", "action": "ochazuke.list.filter-keep", "when": "list-unfiltered", "hidden": true},
      {"key": "ctrl+h", "action": "ochazuke.list.filter-erase", "hidden": true},
      {"key": "ctrl+u", "action": "ochazuke.list.filter", "args": {"query": ""}, "hidden": true},
      {"key": "down", "action": "ochazuke.list.move", "args": {"clamp": true, "delta": 1}},
      {"key": "ctrl+n", "action": "ochazuke.list.move", "args": {"clamp": true, "delta": 1}},
      {"key": "up", "action": "ochazuke.list.move", "args": {"clamp": true, "delta": -1}},
      {"key": "ctrl+p", "action": "ochazuke.list.move", "args": {"clamp": true, "delta": -1}},
      {"key": "enter", "action": "ochazuke.list.filter-choose", "when": "list-chooses"},
      {"key": "enter", "action": "ochazuke.list.filter-keep"},
      {"key": "esc", "action": "ochazuke.list.filter-clear"}
    ]},
    {"context": "ochazuke.list/normal", "bindings": [
      {"key": "V", "action": "ochazuke.list.visual", "hidden": true},
      {"key": "esc", "action": "ochazuke.list.end-visual", "when": "list-visual"},
      {"key": "esc", "action": "ochazuke.list.filter-clear"}
    ]},
    {"context": "ochazuke.list/visual-line", "extends": "normal", "bindings": [
      {"key": "esc", "action": "ochazuke.list.end-visual"},
      {"key": "d", "action": "ochazuke.list.apply", "args": {"verb": "delete"}, "hint": "delete"},
      {"key": "y", "action": "ochazuke.list.yank", "args": {"what": "row"}, "hint": "yank"},
      {"key": "digit-0", "action": "ochazuke.mode.enter", "args": {"mode": "count_pending"}, "from": {"count": "digit"}, "hidden": true}
    ]}
  ]
}
