// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "modes": {
    "help_bind_pending": {"pending": true},
    "help_bind_literal": {"pending": true}
  },
  "bindings": [
    {"context": "ochazuke.binding/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.outline.fold", "when": "help-foldable", "hidden": true}
    ]},
    {"context": "ochazuke.bindings-help/normal", "bindings": [
      {"key": "S", "action": "ochazuke.bindings-help.show", "hint": "view"},
      {"key": "tab", "action": "ochazuke.bindings-help.show", "args": {"step": 1}, "hidden": true, "help": "Next view, as tab cycles the views of anything with views"},
      {"key": "shift+tab", "action": "ochazuke.bindings-help.show", "args": {"step": -1}, "hidden": true, "help": "Previous view"},
      {"key": "n", "action": "ochazuke.bindings-help.pick", "args": {"what": "noun"}, "hint": "noun"},
      {"key": "m", "action": "ochazuke.bindings-help.pick", "args": {"what": "mode"}, "hint": "mode"},
      {"key": "p", "action": "ochazuke.bindings-help.pick", "args": {"what": "place"}, "hint": "place"},
      {"key": "s", "action": "ochazuke.collection.sort-column", "args": {"field": "key"}, "when": "help-table", "hint": "sort key", "help": "Table view: sort the rows by key, then descending, then back to the default order (own keys first, literal before key classes)"},
      {"key": "u", "action": "ochazuke.collection.filter-prop", "args": {"prop": "unbound", "value": true}, "when": "help-table", "hint": "unbound only", "hidden": true, "help": "Table view: keep only the unbound verbs (U shows the keys again)"},
      {"key": "U", "action": "ochazuke.collection.filter-prop-clear", "args": {"prop": "unbound"}, "when": "help-table", "hint": "all", "hidden": true, "help": "Table view: clear the unbound-only filter"},
      {"key": "enter", "action": "ochazuke.bindings-help.run", "hint": "run"},
      {"key": "a", "action": "ochazuke.bindings-help.args", "when": "help-has-args", "hint": "args", "help": "Open the args form for the selected verb before running it"},
      {"key": "b", "action": "ochazuke.bindings-help.bind-start", "when": "help-unbound-row", "hint": "bind", "help": "Bind the next key you press to the selected unbound verb; a key that starts a sequence goes on (g, then z), enter binds the keys so far (esc cancels); a key that already runs something asks first"},
      {"key": "B", "action": "ochazuke.bindings-help.bind-start", "args": {"manual": true}, "when": "help-bind-sequence-row", "hint": "bind sequence", "help": "Bind a sequence of keys to the selected unbound verb: every key you press is added, enter binds them (esc cancels, backspace drops the last, ctrl+v takes the next key as it comes)"}
    ]},
    {"context": "ochazuke.bindings-help/help_bind_pending", "bindings": [
      {"key": "esc", "action": "ochazuke.bindings-help.bind-cancel", "hint": "cancel", "help": "Leave without binding"},
      {"key": "enter", "action": "ochazuke.bindings-help.bind-finish", "when": "help-bind-sequence-row", "hint": "bind", "help": "Bind the keys pressed so far"},
      {"key": "backspace", "action": "ochazuke.bindings-help.bind-drop", "when": "help-bind-sequence-row", "hint": "drop last", "help": "Drop the last key pressed"},
      {"key": "ctrl+v", "action": "ochazuke.bindings-help.bind-literal", "when": "help-bind-sequence-row", "hint": "literal", "help": "Take the next key as a key to bind, whatever it is (enter, esc and backspace included)"},
      {"key": "any", "action": "ochazuke.bindings-help.bind-key", "from": {"key": "key"}, "hint": "key to bind", "help": "Add this key to the binding of the selected unbound verb"}
    ]},
    {"context": "ochazuke.bindings-help/help_bind_literal", "bindings": [
      {"key": "any", "action": "ochazuke.bindings-help.bind-key", "args": {"literal": true}, "from": {"key": "key"}, "hint": "key to bind", "help": "Take this key as it is"}
    ]}
  ]
}
