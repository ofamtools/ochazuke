// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "app/normal", "bindings": [
      {"key": "ctrl+w >", "action": "ochazuke.pane.grow", "hint": "ctrl+w >/< resize", "when": "pane-split", "from": {"steps": "count"}},
      {"key": "ctrl+w <", "action": "ochazuke.pane.shrink", "when": "pane-split", "from": {"steps": "count"}, "hidden": true},
      {"key": "ctrl+w =", "action": "ochazuke.pane.reset", "when": "pane-split", "hidden": true},
      {"key": "ctrl+w w", "action": "ochazuke.focus.next", "hidden": true},
      {"key": "ctrl+w W", "action": "ochazuke.focus.previous", "hidden": true},
      {"key": "ctrl+w h", "action": "ochazuke.focus.previous", "hidden": true},
      {"key": "ctrl+w l", "action": "ochazuke.focus.next", "hidden": true},
      {"key": "ctrl+a o", "action": "ochazuke.focus.next", "hidden": true}
    ]}
  ]
}
