// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "app/normal", "bindings": [
      {"key": ">", "action": "ochazuke.pane.grow", "hint": ">/< resize", "when": "pane-split", "from": {"steps": "count"}},
      {"key": "<", "action": "ochazuke.pane.shrink", "when": "pane-split", "from": {"steps": "count"}, "hidden": true},
      {"key": "=", "action": "ochazuke.pane.reset", "when": "pane-split", "hidden": true}
    ]}
  ]
}
