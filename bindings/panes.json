// ochazuke bindings (JSONC): groups by "noun/mode" context; each key maps to an action, {action, args, hint, when, ...}, null (unbind) or an array of those
{
  "bindings": [
    {"context": "app/normal", "bindings": {
      ">": {"action": "ochazuke.pane.grow", "hint": ">/< resize", "when": "pane-split", "from": {"steps": "count"}},
      "<": {"action": "ochazuke.pane.shrink", "when": "pane-split", "from": {"steps": "count"}, "hidden": true},
      "=": {"action": "ochazuke.pane.reset", "when": "pane-split", "hidden": true}
    }}
  ]
}
