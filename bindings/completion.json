// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.completion/insert", "bindings": [
      {"key": "esc", "action": "ochazuke.completion.dismiss"},
      {"key": "tab", "action": "ochazuke.completion.accept", "when": "completion-rows"},
      {"key": "enter", "action": "ochazuke.completion.accept", "when": "completion-highlighted"},
      {"key": "ctrl+n", "action": "ochazuke.completion.move", "args": {"delta": 1}, "when": "completion-rows"},
      {"key": "down", "action": "ochazuke.completion.move", "args": {"delta": 1}, "when": "completion-rows"},
      {"key": "ctrl+p", "action": "ochazuke.completion.move", "args": {"delta": -1}, "when": "completion-rows"},
      {"key": "up", "action": "ochazuke.completion.move", "args": {"delta": -1}, "when": "completion-rows"}
    ]}
  ]
}
