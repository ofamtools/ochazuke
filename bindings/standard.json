// ochazuke bindings (JSONC): the default keys of the standard verbs (core_verbs.go), one row per line: i opens the focused thing's edit form, d in visual-line deletes every selected row
{
  "bindings": [
    {"context": "app/normal", "fallback": true, "bindings": [
      {"key": "i", "action": "ochazuke.noun.edit", "hint": "edit"}
    ]},
    {"context": "ochazuke.list/visual-line", "extends": "normal", "bindings": [
      {"key": "d", "action": "ochazuke.list.apply", "args": {"verb": "delete"}, "hint": "delete"}
    ]}
  ]
}
