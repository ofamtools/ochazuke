// ochazuke bindings (JSONC): groups by "noun/mode" context; each key maps to an action, {action, args, hint, when, ...}, null (unbind) or an array of those
{
  "bindings": [
    {"context": "ochazuke.confirm", "bindings": {
      "y": "ochazuke.confirm.accept",
      "enter": "ochazuke.confirm.accept",
      "n": "ochazuke.modal.pop",
      "esc": "ochazuke.modal.pop",
      "any": {"action": "ochazuke.key.ignore", "hidden": true}
    }}
  ]
}
