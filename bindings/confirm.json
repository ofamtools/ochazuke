// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.confirm", "bindings": [
      {"key": "y", "action": "ochazuke.confirm.accept"},
      {"key": "enter", "action": "ochazuke.confirm.accept"},
      {"key": "n", "action": "ochazuke.modal.close"},
      {"key": "esc", "action": "ochazuke.modal.close", "when": "esc-closes"},
      {"key": "q", "action": "ochazuke.modal.close", "hidden": true, "help": "Close without running, as q closes every modal"},
      {"key": "ctrl+c", "action": "app.quit", "hidden": true, "help": "Quit: over a quit question it is the yes (asking again accepts); over any other, it asks to quit"},
      {"key": "any", "action": "ochazuke.key.ignore", "hidden": true}
    ]}
  ]
}
