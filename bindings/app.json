// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "app", "fallback": true, "bindings": [
      {"key": "ctrl+space", "action": "ochazuke.palette.open", "hidden": true},
      {"key": "ctrl+c", "action": "app.quit", "hidden": true},
      {"key": "ctrl+c", "action": "app.quit", "when": "no-modal", "hidden": true, "capture": true},
      {"key": "pgdown", "action": "ochazuke.surface.scroll", "args": {"lines": 8}},
      {"key": "pgup", "action": "ochazuke.surface.scroll", "args": {"lines": -8}}
    ]},
    {"context": "app/normal", "fallback": true, "bindings": [
      {"key": ":", "action": "ochazuke.palette.open"},
      {"key": "?", "action": "ochazuke.bindings.help"},
      {"key": "'", "action": "ochazuke.page.pick", "when": "no-modal"},
      {"key": "ctrl+j", "action": "ochazuke.page.next"},
      {"key": "ctrl+k", "action": "ochazuke.page.previous"},
      {"key": "/", "action": "ochazuke.list.filter-open", "hint": "filter", "when": "list-filterable"},
      {"key": "g y", "action": "ochazuke.yank-history.open", "when": "no-input", "hidden": true}
    ]},
    {"context": "app/visual-line", "fallback": true, "bindings": [
      {"key": ":", "action": "ochazuke.palette.open"},
      {"key": "?", "action": "ochazuke.bindings.help"}
    ]},
    {"context": "ochazuke.editor/insert", "fallback": true, "bindings": [
      {"key": "ctrl+\\", "action": "ochazuke.bindings.help", "hidden": true}
    ]}
  ]
}
