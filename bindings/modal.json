// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
// visual-line extends normal for lists; the modal noun has its own (empty) visual-line table, so esc in a modal input's V selection leaves the selection instead of closing the modal
// q closes every modal through one verb, modal.close, which runs the modal's own close request (CloseWith) or pops it; esc only leaves insert (a modal text input is not pinned to insert), and does nothing in a modal's normal mode; the setting modal.esc-closes (default false) brings back the esc rows, which carry the guard setting:modal.esc-closes (a modal's text input then stays pinned to insert)
{
  "bindings": [
    {"context": "ochazuke.modal/normal", "bindings": [
      {"key": "esc", "action": "ochazuke.modal.close", "when": "setting:modal.esc-closes"},
      {"key": "q", "action": "ochazuke.modal.close"}
    ]},
    {"context": "ochazuke.modal/visual-line", "bindings": []}
  ]
}
