// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.docs-viewer/normal", "bindings": [
      {"key": "j", "action": "ochazuke.detail.scroll", "args": {"lines": 1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hint": "j/k scroll"},
      {"key": "down", "action": "ochazuke.detail.scroll", "args": {"lines": 1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hidden": true},
      {"key": "k", "action": "ochazuke.detail.scroll", "args": {"lines": -1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hidden": true},
      {"key": "up", "action": "ochazuke.detail.scroll", "args": {"lines": -1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hidden": true},
      {"key": "J", "action": "ochazuke.detail.scroll", "args": {"lines": 1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hidden": true},
      {"key": "K", "action": "ochazuke.detail.scroll", "args": {"lines": -1, "id": "__docs-viewer/text"}, "from": {"count": "count"}, "hidden": true},
      {"key": "g g", "action": "ochazuke.view.edge", "args": {"edge": "first"}, "from": {"row": "line"}, "hint": "g g/G ends"},
      {"key": "G", "action": "ochazuke.view.edge", "args": {"edge": "last"}, "from": {"row": "line"}, "hidden": true},
      {"key": "ctrl+d", "action": "ochazuke.view.page", "args": {"delta": 1, "half": true}, "from": {"steps": "line"}, "hint": "ctrl+d/u half page"},
      {"key": "ctrl+u", "action": "ochazuke.view.page", "args": {"delta": -1, "half": true}, "from": {"steps": "line"}, "hidden": true},
      {"key": "ctrl+f", "action": "ochazuke.view.page", "args": {"delta": 1}, "from": {"steps": "line"}, "hidden": true},
      {"key": "ctrl+b", "action": "ochazuke.view.page", "args": {"delta": -1}, "from": {"steps": "line"}, "hidden": true},
      {"key": "/", "action": "ochazuke.search.find", "hint": "find"},
      {"key": "n", "action": "ochazuke.search.next", "from": {"count": "count"}, "hidden": true},
      {"key": "N", "action": "ochazuke.search.next", "args": {"reverse": true}, "from": {"count": "count"}, "hidden": true}
    ]},
    {"context": "ochazuke.docs-viewer/count_pending", "extends": "normal", "bindings": []}
  ]
}
