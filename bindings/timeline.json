// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.timeline/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.timeline.toggle"},
      {"key": "space", "action": "ochazuke.timeline.toggle", "hidden": true},
      {"key": "l", "action": "ochazuke.timeline.open"},
      {"key": "l", "action": "ochazuke.timeline.enter"},
      {"key": "right", "action": "ochazuke.timeline.open", "hidden": true},
      {"key": "right", "action": "ochazuke.timeline.enter", "hidden": true},
      {"key": "h", "action": "ochazuke.timeline.close"},
      {"key": "h", "action": "ochazuke.timeline.leave"},
      {"key": "left", "action": "ochazuke.timeline.close", "hidden": true},
      {"key": "left", "action": "ochazuke.timeline.leave", "hidden": true},
      {"key": "z o", "action": "ochazuke.timeline.open", "hidden": true},
      {"key": "z c", "action": "ochazuke.timeline.close", "hidden": true},
      {"key": "z a", "action": "ochazuke.timeline.toggle", "hidden": true},
      {"key": "z R", "action": "ochazuke.timeline.open-all"},
      {"key": "z M", "action": "ochazuke.timeline.close-all"},
      {"key": "J", "action": "ochazuke.timeline.scroll", "args": {"lines": 1}, "hint": "J/K scroll", "from": {"count": "count"}},
      {"key": "K", "action": "ochazuke.timeline.scroll", "args": {"lines": -1}, "from": {"count": "count"}, "hidden": true},
      {"key": "ctrl+e", "action": "ochazuke.timeline.scroll", "args": {"lines": 1}, "from": {"count": "count"}, "hidden": true},
      {"key": "ctrl+y", "action": "ochazuke.timeline.scroll", "args": {"lines": -1}, "from": {"count": "count"}, "hidden": true},
      {"key": "z 1", "action": "ochazuke.timeline.fold", "args": {"section": "1"}, "hint": "fold section"},
      {"key": "z 2", "action": "ochazuke.timeline.fold", "args": {"section": "2"}, "hidden": true},
      {"key": "z 3", "action": "ochazuke.timeline.fold", "args": {"section": "3"}, "hidden": true},
      {"key": "z 4", "action": "ochazuke.timeline.fold", "args": {"section": "4"}, "hidden": true},
      {"key": "z 5", "action": "ochazuke.timeline.fold", "args": {"section": "5"}, "hidden": true},
      {"key": "z 6", "action": "ochazuke.timeline.fold", "args": {"section": "6"}, "hidden": true},
      {"key": "z 7", "action": "ochazuke.timeline.fold", "args": {"section": "7"}, "hidden": true},
      {"key": "z 8", "action": "ochazuke.timeline.fold", "args": {"section": "8"}, "hidden": true},
      {"key": "z 9", "action": "ochazuke.timeline.fold", "args": {"section": "9"}, "hidden": true}
    ]},
    {"context": "ochazuke.timeline-body/normal", "bindings": [
      {"key": "j", "action": "ochazuke.timeline.step", "args": {"delta": 1}, "from": {"count": "count"}},
      {"key": "down", "action": "ochazuke.timeline.step", "args": {"delta": 1}, "from": {"count": "count"}, "hidden": true},
      {"key": "k", "action": "ochazuke.timeline.step", "args": {"delta": -1}, "from": {"count": "count"}},
      {"key": "up", "action": "ochazuke.timeline.step", "args": {"delta": -1}, "from": {"count": "count"}, "hidden": true},
      {"key": "g j", "action": "ochazuke.timeline.row", "args": {"delta": 1}, "from": {"count": "count"}},
      {"key": "g k", "action": "ochazuke.timeline.row", "args": {"delta": -1}, "from": {"count": "count"}},
      {"key": "l", "action": "ochazuke.timeline.enter"},
      {"key": "right", "action": "ochazuke.timeline.enter", "hidden": true},
      {"key": "h", "action": "ochazuke.timeline.fold-step"},
      {"key": "left", "action": "ochazuke.timeline.fold-step", "hidden": true},
      {"key": "h", "action": "ochazuke.timeline.leave"},
      {"key": "left", "action": "ochazuke.timeline.leave", "hidden": true},
      {"key": "esc", "action": "ochazuke.timeline.leave", "hidden": true},
      {"key": "y", "action": "ochazuke.timeline.yank-step"}
    ]},
    {"context": "ochazuke.timeline-body/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.timeline/count_pending", "extends": "normal", "bindings": []}
  ]
}
