{
  "bindings": [
    {"context":"ochazuke.filter-form", "bindings":[
      {"key":"tab", "action":"ochazuke.filter-form.move", "args":{"step":1}, "capture":true, "hint":"controls"},
      {"key":"shift+tab", "action":"ochazuke.filter-form.move", "args":{"step":-1}, "capture":true, "hidden":true},
      {"key":"enter", "action":"ochazuke.filter-form.next", "capture":true}
    ]},
    {"context":"ochazuke.filter-form/insert", "bindings":[
      {"key":"esc", "action":"ochazuke.mode.switch", "args":{"mode":"normal"}, "when":"filter-form-text", "hidden":true}
    ]},
    {"context":"ochazuke.filter-form/normal", "bindings":[
      {"key":"esc", "action":"ochazuke.filter-form.focus", "args":{"part":"field"}, "when":"filter-form-text", "hint":"fields"},
      {"key":"z ]", "action":"ochazuke.list.filter-cycle", "args":{"step":1}, "hint":"next filter"},
      {"key":"z [", "action":"ochazuke.list.filter-cycle", "args":{"step":-1}, "hidden":true},
      {"key":"D", "action":"ochazuke.filter-form.delete-saved", "hint":"delete saved"}
    ]},
    {"context":"ochazuke.filter-value/normal", "bindings":[
      {"key":"space", "action":"ochazuke.filter-form.toggle", "capture":true, "hint":"toggle"},
      {"key":"esc", "action":"ochazuke.filter-form.focus", "args":{"part":"field"}, "capture":true, "hint":"fields"}
    ]},
    {"context":"ochazuke.filter-direction/normal", "bindings":[
      {"key":"enter", "action":"ochazuke.filter-form.direction"}
    ]},
    {"context":"ochazuke.filter-condition/normal", "bindings":[
      {"key":"enter", "action":"ochazuke.filter-form.edit-condition"},
      {"key":"d d", "action":"ochazuke.filter-form.remove-condition", "hint":"remove"},
      {"key":"!", "action":"ochazuke.filter-form.invert-condition", "hint":"is/not"}
    ]},
    {"context":"ochazuke.filter-save-form/insert", "bindings":[
      {"key":"esc", "action":"ochazuke.mode.switch", "args":{"mode":"normal"}, "hidden":true}
    ]},
    {"context":"ochazuke.filter-save-form", "bindings":[
      {"key":"enter", "action":"ochazuke.filter-form.write-saved", "hint":"save"}
    ]}
  ]
}
