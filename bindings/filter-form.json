{
  "bindings": [
    {
      "context": "ochazuke.filter-form",
      "bindings": [
        {
          "key": "tab",
          "action": "ochazuke.focus.next",
          "capture": true,
          "when": "filter-form-tab"
        },
        {
          "key": "shift+tab",
          "action": "ochazuke.focus.previous",
          "capture": true,
          "hidden": true,
          "when": "filter-form-tab"
        },
        {
          "key": "enter",
          "action": "ochazuke.filter-form.next",
          "when": "filter-form-text",
          "capture": true
        }
      ]
    },
    {
      "context": "ochazuke.filter-form/normal",
      "bindings": [
        {
          "key": "u",
          "action": "ochazuke.form.undo"
        },
        {
          "key": "ctrl+r",
          "action": "ochazuke.form.redo"
        },
        {
          "key": "C",
          "action": "ochazuke.form.clear",
          "hint": "clear"
        },
        {
          "key": "z ]",
          "action": "ochazuke.list.filter-cycle",
          "args": {
            "step": 1
          },
          "hint": "next filter"
        },
        {
          "key": "z [",
          "action": "ochazuke.list.filter-cycle",
          "args": {
            "step": -1
          },
          "hidden": true
        }
      ]
    },
    {
      "context": "ochazuke.filter-values",
      "bindings": [
        {
          "key": "space",
          "action": "ochazuke.filter-form.toggle",
          "capture": true,
          "hint": "toggle"
        }
      ]
    },
    {
      "context": "ochazuke.filter-direction/normal",
      "bindings": [
        {
          "key": "enter",
          "action": "ochazuke.filter-form.direction"
        }
      ]
    },
    {
      "context": "ochazuke.filter-condition/normal",
      "bindings": [
        {
          "key": "enter",
          "action": "ochazuke.filter-form.edit-condition"
        },
        {
          "key": "d d",
          "action": "ochazuke.filter-form.remove-condition",
          "hint": "remove"
        },
        {
          "key": "!",
          "action": "ochazuke.filter-form.invert-condition",
          "hint": "is/not"
        }
      ]
    },
    {
      "context": "ochazuke.filter-save/insert",
      "bindings": [
        {
          "key": "esc",
          "action": "ochazuke.mode.set",
          "args": {
            "mode": "normal"
          },
          "hidden": true
        }
      ]
    },
    {
      "context": "ochazuke.filter-save",
      "bindings": [
        {
          "key": "enter",
          "action": "ochazuke.filter-form.save",
          "hint": "save"
        }
      ]
    },
    {
      "context": "ochazuke.filter-save/normal",
      "bindings": [
        {
          "key": "d d",
          "action": "ochazuke.filter-form.delete-saved",
          "hint": "delete saved"
        }
      ]
    }
  ]
}
