// ochazuke bindings (JSONC): groups by "noun/mode" context; each key maps to an action, {action, args, hint, when, ...}, null (unbind) or an array of those
{
  "modes": {
    "count_pending": {"pending": true},
    "g_pending": {"pending": true},
    "operator_g_pending": {"pending": true},
    "operator_pending": {"pending": true},
    "visual_count_pending": {"pending": true}
  },
  "bindings": [
    {"context": "ochazuke.editor/count_pending", "extends": "normal", "bindings": {
      "esc": "ochazuke.input.cancel",
      "any": {"action": "ochazuke.mode.leave", "replay": true}
    }},
    {"context": "ochazuke.editor/g_pending", "bindings": {
      "g": {"action": "ochazuke.input.move", "args": {"motion": "first-line"}, "from": {"line": "count"}},
      "any": "ochazuke.input.cancel"
    }},
    {"context": "ochazuke.editor/insert", "bindings": {
      "esc": {"action": "ochazuke.mode.set", "args": {"mode": "normal"}},
      "tab": "ochazuke.completion.open",
      "alt+b": {"action": "ochazuke.input.move", "args": {"motion": "word-previous"}},
      "alt+f": {"action": "ochazuke.input.move", "args": {"motion": "word-next"}},
      "ctrl+a": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      "ctrl+b": {"action": "ochazuke.input.move", "args": {"motion": "left"}},
      "ctrl+e": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      "ctrl+f": {"action": "ochazuke.input.move", "args": {"motion": "right"}},
      "ctrl+n": {"action": "ochazuke.input.move", "args": {"motion": "down"}},
      "ctrl+p": {"action": "ochazuke.input.move", "args": {"motion": "up"}},
      "down": {"action": "ochazuke.input.move", "args": {"motion": "down"}},
      "end": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      "home": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      "left": {"action": "ochazuke.input.move", "args": {"motion": "left"}},
      "right": {"action": "ochazuke.input.move", "args": {"motion": "right"}},
      "up": {"action": "ochazuke.input.move", "args": {"motion": "up"}},
      "ctrl+k": {"action": "ochazuke.input.kill", "args": {"motion": "line-end"}},
      "ctrl+u": {"action": "ochazuke.input.kill", "args": {"motion": "line-start"}},
      "ctrl+w": {"action": "ochazuke.input.kill", "args": {"motion": "word-backward"}},
      "ctrl+y": {"action": "ochazuke.input.paste", "args": {"before": true, "literal": true}},
      "backspace": {"action": "ochazuke.input.delete", "args": {"direction": "backward"}},
      "ctrl+h": {"action": "ochazuke.input.delete", "args": {"direction": "backward"}},
      "delete": "ochazuke.input.delete",
      "ctrl+d": "ochazuke.input.delete",
      "enter": {"action": "ochazuke.input.insert", "args": {"text": "\n"}, "when": "multiline"},
      "space": {"action": "ochazuke.input.insert", "args": {"text": " "}},
      "printable": {"action": "ochazuke.input.insert", "from": {"text": "text"}},
      "paste": {"action": "ochazuke.input.insert", "from": {"text": "text"}}
    }},
    {"context": "ochazuke.editor/normal", "bindings": {
      "$": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      "0": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      "G": {"action": "ochazuke.input.move", "args": {"motion": "last-line"}, "from": {"line": "line", "steps": "count"}},
      "b": {"action": "ochazuke.input.move", "args": {"motion": "word-backward"}, "from": {"line": "line", "steps": "count"}},
      "down": {"action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      "e": {"action": "ochazuke.input.move", "args": {"motion": "word-end"}, "from": {"line": "line", "steps": "count"}},
      "end": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      "h": {"action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      "home": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      "j": {"action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      "k": {"action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      "l": {"action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      "left": {"action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      "right": {"action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      "up": {"action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      "w": {"action": "ochazuke.input.move", "args": {"motion": "word-forward"}, "from": {"line": "line", "steps": "count"}},
      "A": {"action": "ochazuke.input.begin", "args": {"position": "end"}},
      "I": {"action": "ochazuke.input.begin", "args": {"position": "first"}},
      "O": {"action": "ochazuke.input.begin", "args": {"position": "above"}},
      "a": {"action": "ochazuke.input.begin", "args": {"position": "append"}},
      "i": {"action": "ochazuke.input.begin", "args": {"position": "insert"}},
      "o": {"action": "ochazuke.input.begin", "args": {"position": "below"}},
      "c": {"action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "c"}, "from": {"opcount": "count"}},
      "d": {"action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "d"}, "from": {"opcount": "count"}},
      "y": {"action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "y"}, "from": {"opcount": "count"}},
      "V": {"action": "ochazuke.input.select", "args": {"shape": "line"}},
      "ctrl+v": {"action": "ochazuke.input.select", "args": {"shape": "block"}},
      "v": {"action": "ochazuke.input.select", "args": {"shape": "char"}},
      "x": {"action": "ochazuke.input.delete", "from": {"steps": "count"}},
      "delete": {"action": "ochazuke.input.delete", "from": {"steps": "count"}},
      "u": {"action": "ochazuke.input.undo", "from": {"steps": "count"}},
      "ctrl+r": {"action": "ochazuke.input.redo", "from": {"steps": "count"}},
      "p": {"action": "ochazuke.input.paste", "args": {"before": false}, "from": {"steps": "count"}},
      "P": {"action": "ochazuke.input.paste", "args": {"before": true}, "from": {"steps": "count"}},
      "g": {"action": "ochazuke.mode.enter", "args": {"mode": "g_pending"}, "from": {"count": "count"}}
    }},
    {"context": "ochazuke.editor/operator_g_pending", "bindings": {
      "g": {"action": "ochazuke.input.operator", "args": {"motion": "first-line"}, "from": {"line": "steps", "operator": "op", "steps": "steps"}},
      "any": "ochazuke.input.cancel"
    }},
    {"context": "ochazuke.editor/operator_pending", "bindings": {
      "0": {"action": "ochazuke.count.append", "args": {"digit": 0}, "when": "count"},
      "$": {"action": "ochazuke.input.operator", "args": {"motion": "line-end"}, "from": {"line": "line", "operator": "op", "steps": "steps"}}
    }},
    {"context": "ochazuke.editor/operator_pending", "bindings": {
      "0": {"action": "ochazuke.input.operator", "args": {"motion": "line-start"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "G": {"action": "ochazuke.input.operator", "args": {"motion": "last-line"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "b": {"action": "ochazuke.input.operator", "args": {"motion": "word-backward"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "down": {"action": "ochazuke.input.operator", "args": {"motion": "down"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "e": {"action": "ochazuke.input.operator", "args": {"motion": "word-end"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "end": {"action": "ochazuke.input.operator", "args": {"motion": "line-end"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "h": {"action": "ochazuke.input.operator", "args": {"motion": "left"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "home": {"action": "ochazuke.input.operator", "args": {"motion": "line-start"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "j": {"action": "ochazuke.input.operator", "args": {"motion": "down"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "k": {"action": "ochazuke.input.operator", "args": {"motion": "up"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "l": {"action": "ochazuke.input.operator", "args": {"motion": "right"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "left": {"action": "ochazuke.input.operator", "args": {"motion": "left"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "right": {"action": "ochazuke.input.operator", "args": {"motion": "right"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "up": {"action": "ochazuke.input.operator", "args": {"motion": "up"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "w": {"action": "ochazuke.input.operator", "args": {"motion": "word-forward"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      "y": {"action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "y"}, "when": "op:y", "from": {"steps": "steps"}},
      "d": {"action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "d"}, "when": "op:d", "from": {"steps": "steps"}},
      "c": {"action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "c"}, "when": "op:c", "from": {"steps": "steps"}},
      "g": {"action": "ochazuke.mode.enter", "args": {"mode": "operator_g_pending"}, "from": {"count": "count", "op": "op", "opcount": "opcount"}},
      "digit-0": {"action": "ochazuke.count.append", "from": {"digit": "digit"}},
      "esc": "ochazuke.input.cancel",
      "any": "ochazuke.input.cancel"
    }},
    {"context": "ochazuke.editor/visual", "bindings": {
      "$": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      "0": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      "G": {"action": "ochazuke.input.move", "args": {"motion": "last-line"}, "from": {"line": "line", "steps": "count"}},
      "b": {"action": "ochazuke.input.move", "args": {"motion": "word-backward"}, "from": {"line": "line", "steps": "count"}},
      "down": {"action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      "e": {"action": "ochazuke.input.move", "args": {"motion": "word-end"}, "from": {"line": "line", "steps": "count"}},
      "end": {"action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      "h": {"action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      "home": {"action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      "j": {"action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      "k": {"action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      "l": {"action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      "left": {"action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      "right": {"action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      "up": {"action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      "w": {"action": "ochazuke.input.move", "args": {"motion": "word-forward"}, "from": {"line": "line", "steps": "count"}},
      "c": {"action": "ochazuke.input.operator", "args": {"operator": "c"}},
      "d": {"action": "ochazuke.input.operator", "args": {"operator": "d"}},
      "y": {"action": "ochazuke.input.operator", "args": {"operator": "y"}},
      "V": {"action": "ochazuke.input.select", "args": {"shape": "line"}},
      "ctrl+v": {"action": "ochazuke.input.select", "args": {"shape": "block"}},
      "v": {"action": "ochazuke.input.select", "args": {"shape": "char"}},
      "A": "ochazuke.input.cancel",
      "I": "ochazuke.input.cancel",
      "O": "ochazuke.input.cancel",
      "a": "ochazuke.input.cancel",
      "i": "ochazuke.input.cancel",
      "o": "ochazuke.input.cancel",
      "x": {"action": "ochazuke.input.operator", "args": {"operator": "d"}},
      "delete": {"action": "ochazuke.input.operator", "args": {"operator": "d"}},
      "u": {"action": "ochazuke.input.undo", "from": {"steps": "count"}},
      "ctrl+r": {"action": "ochazuke.input.redo", "from": {"steps": "count"}},
      "p": {"action": "ochazuke.input.paste", "args": {"before": false}, "from": {"steps": "count"}},
      "P": {"action": "ochazuke.input.paste", "args": {"before": true}, "from": {"steps": "count"}},
      "esc": "ochazuke.input.cancel",
      "g": {"action": "ochazuke.mode.enter", "args": {"mode": "g_pending"}, "from": {"count": "count"}},
      "digit-0": {"action": "ochazuke.mode.enter", "args": {"mode": "visual_count_pending"}, "from": {"count": "digit"}}
    }},
    {"context": "ochazuke.editor/visual_count_pending", "extends": "visual", "bindings": {
      "0": {"action": "ochazuke.count.append", "args": {"digit": 0}},
      "digit": {"action": "ochazuke.count.append", "from": {"digit": "digit"}},
      "esc": "ochazuke.input.cancel",
      "any": {"action": "ochazuke.mode.leave", "replay": true}
    }},
    {"context": "ochazuke.editor/visual-line", "extends": "visual", "bindings": {}},
    {"context": "ochazuke.editor/visual-block", "extends": "visual", "bindings": {}}
  ]
}
