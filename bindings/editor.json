// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "modes": {
    "count_pending": {"pending": true},
    "g_pending": {"pending": true},
    "operator_g_pending": {"pending": true},
    "operator_pending": {"pending": true},
    "visual_count_pending": {"pending": true}
  },
  "bindings": [
    {"context": "ochazuke.editor/count_pending", "extends": "normal", "bindings": [
      {"key": "esc", "action": "ochazuke.input.cancel"},
      {"key": "any", "action": "ochazuke.mode.leave", "replay": true}
    ]},
    {"context": "ochazuke.editor/g_pending", "bindings": [
      {"key": "g", "action": "ochazuke.input.move", "args": {"motion": "first-line"}, "from": {"line": "count"}},
      {"key": "any", "action": "ochazuke.input.cancel"}
    ]},
    {"context": "ochazuke.editor/insert", "bindings": [
      {"key": "esc", "action": "ochazuke.mode.set", "args": {"mode": "normal"}},
      {"key": "tab", "action": "ochazuke.completion.open"},
      {"key": "alt+b", "action": "ochazuke.input.move", "args": {"motion": "word-previous"}},
      {"key": "alt+f", "action": "ochazuke.input.move", "args": {"motion": "word-next"}},
      {"key": "ctrl+a", "action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      {"key": "ctrl+b", "action": "ochazuke.input.move", "args": {"motion": "left"}},
      {"key": "ctrl+e", "action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      {"key": "ctrl+f", "action": "ochazuke.input.move", "args": {"motion": "right"}},
      {"key": "ctrl+n", "action": "ochazuke.input.move", "args": {"motion": "down"}},
      {"key": "ctrl+p", "action": "ochazuke.input.move", "args": {"motion": "up"}},
      {"key": "down", "action": "ochazuke.input.move", "args": {"motion": "down"}},
      {"key": "end", "action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      {"key": "home", "action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      {"key": "left", "action": "ochazuke.input.move", "args": {"motion": "left"}},
      {"key": "right", "action": "ochazuke.input.move", "args": {"motion": "right"}},
      {"key": "up", "action": "ochazuke.input.move", "args": {"motion": "up"}},
      {"key": "alt+left", "action": "ochazuke.input.move", "args": {"motion": "word-previous"}},
      {"key": "alt+right", "action": "ochazuke.input.move", "args": {"motion": "word-next"}},
      {"key": "ctrl+left", "action": "ochazuke.input.move", "args": {"motion": "word-previous"}},
      {"key": "ctrl+right", "action": "ochazuke.input.move", "args": {"motion": "word-next"}},
      {"key": "super+left", "action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      {"key": "super+right", "action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      {"key": "meta+left", "action": "ochazuke.input.move", "args": {"motion": "line-start"}},
      {"key": "meta+right", "action": "ochazuke.input.move", "args": {"motion": "line-end"}},
      {"key": "ctrl+k", "action": "ochazuke.input.kill", "args": {"motion": "line-end"}},
      {"key": "ctrl+u", "action": "ochazuke.input.kill", "args": {"motion": "line-start"}},
      {"key": "super+backspace", "action": "ochazuke.input.kill", "args": {"motion": "line-start"}, "hidden": true},
      {"key": "ctrl+w", "action": "ochazuke.input.kill", "args": {"motion": "word-backward"}},
      {"key": "alt+backspace", "action": "ochazuke.input.kill", "args": {"motion": "word-previous"}, "hidden": true},
      {"key": "ctrl+backspace", "action": "ochazuke.input.kill", "args": {"motion": "word-previous"}, "hidden": true},
      {"key": "alt+d", "action": "ochazuke.input.kill", "args": {"motion": "word-next"}, "hidden": true},
      {"key": "ctrl+delete", "action": "ochazuke.input.kill", "args": {"motion": "word-next"}, "hidden": true},
      {"key": "ctrl+y", "action": "ochazuke.input.paste", "args": {"before": true, "literal": true}},
      {"key": "backspace", "action": "ochazuke.input.delete", "args": {"direction": "backward"}},
      {"key": "ctrl+h", "action": "ochazuke.input.delete", "args": {"direction": "backward"}},
      {"key": "delete", "action": "ochazuke.input.delete"},
      {"key": "ctrl+d", "action": "ochazuke.input.delete"},
      {"key": "enter", "action": "ochazuke.input.insert", "args": {"text": "\n"}, "when": "multiline"},
      {"key": "space", "action": "ochazuke.input.insert", "args": {"text": " "}},
      {"key": "printable", "action": "ochazuke.input.insert", "from": {"text": "text"}},
      {"key": "paste", "action": "ochazuke.input.insert", "from": {"text": "text"}}
    ]},
    {"context": "ochazuke.editor/normal", "bindings": [
      {"key": "$", "action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "0", "action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      {"key": "G", "action": "ochazuke.input.move", "args": {"motion": "last-line"}, "from": {"line": "line", "steps": "count"}},
      {"key": "b", "action": "ochazuke.input.move", "args": {"motion": "word-backward"}, "from": {"line": "line", "steps": "count"}},
      {"key": "down", "action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      {"key": "e", "action": "ochazuke.input.move", "args": {"motion": "word-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "end", "action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "h", "action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      {"key": "home", "action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      {"key": "j", "action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      {"key": "k", "action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      {"key": "l", "action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      {"key": "left", "action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
      {"key": "right", "action": "ochazuke.input.move", "args": {"motion": "right"}, "from": {"line": "line", "steps": "count"}},
      {"key": "up", "action": "ochazuke.input.move", "args": {"motion": "up"}, "from": {"line": "line", "steps": "count"}},
      {"key": "w", "action": "ochazuke.input.move", "args": {"motion": "word-forward"}, "from": {"line": "line", "steps": "count"}},
      {"key": "A", "action": "ochazuke.input.begin", "args": {"position": "end"}},
      {"key": "I", "action": "ochazuke.input.begin", "args": {"position": "first"}},
      {"key": "O", "action": "ochazuke.input.begin", "args": {"position": "above"}},
      {"key": "a", "action": "ochazuke.input.begin", "args": {"position": "append"}},
      {"key": "i", "action": "ochazuke.input.begin", "args": {"position": "insert"}},
      {"key": "o", "action": "ochazuke.input.begin", "args": {"position": "below"}},
      {"key": "c", "action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "c"}, "from": {"opcount": "count"}},
      {"key": "d", "action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "d"}, "from": {"opcount": "count"}},
      {"key": "y", "action": "ochazuke.mode.enter", "args": {"mode": "operator_pending", "op": "y"}, "from": {"opcount": "count"}},
      {"key": "V", "action": "ochazuke.input.select", "args": {"shape": "line"}},
      {"key": "ctrl+v", "action": "ochazuke.input.select", "args": {"shape": "block"}},
      {"key": "v", "action": "ochazuke.input.select", "args": {"shape": "char"}},
      {"key": "x", "action": "ochazuke.input.delete", "from": {"steps": "count"}},
      {"key": "delete", "action": "ochazuke.input.delete", "from": {"steps": "count"}},
      {"key": "u", "action": "ochazuke.input.undo", "from": {"steps": "count"}},
      {"key": "ctrl+r", "action": "ochazuke.input.redo", "from": {"steps": "count"}},
      {"key": "p", "action": "ochazuke.input.paste", "args": {"before": false}, "from": {"steps": "count"}},
      {"key": "P", "action": "ochazuke.input.paste", "args": {"before": true}, "from": {"steps": "count"}},
      {"key": "g", "action": "ochazuke.mode.enter", "args": {"mode": "g_pending"}, "from": {"count": "count"}}
    ]},
    {"context": "ochazuke.editor/operator_g_pending", "bindings": [
      {"key": "g", "action": "ochazuke.input.operator", "args": {"motion": "first-line"}, "from": {"line": "steps", "operator": "op", "steps": "steps"}},
      {"key": "any", "action": "ochazuke.input.cancel"}
    ]},
    {"context": "ochazuke.editor/operator_pending", "bindings": [
      {"key": "0", "action": "ochazuke.count.append", "args": {"digit": 0}, "when": "count"},
      {"key": "$", "action": "ochazuke.input.operator", "args": {"motion": "line-end"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "0", "action": "ochazuke.input.operator", "args": {"motion": "line-start"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "G", "action": "ochazuke.input.operator", "args": {"motion": "last-line"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "b", "action": "ochazuke.input.operator", "args": {"motion": "word-backward"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "down", "action": "ochazuke.input.operator", "args": {"motion": "down"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
