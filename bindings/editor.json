      {"key": "d", "action": "ochazuke.input.operator", "args": {"operator": "d"}},
      {"key": "y", "action": "ochazuke.input.operator", "args": {"operator": "y"}},
      {"key": "V", "action": "ochazuke.input.select", "args": {"shape": "line"}},
      {"key": "ctrl+v", "action": "ochazuke.input.select", "args": {"shape": "block"}},
      {"key": "v", "action": "ochazuke.input.select", "args": {"shape": "char"}},
