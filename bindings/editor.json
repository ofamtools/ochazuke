      {"key": "home", "action": "ochazuke.input.operator", "args": {"motion": "line-start"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "j", "action": "ochazuke.input.operator", "args": {"motion": "down"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "k", "action": "ochazuke.input.operator", "args": {"motion": "up"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "l", "action": "ochazuke.input.operator", "args": {"motion": "right"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "left", "action": "ochazuke.input.operator", "args": {"motion": "left"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "right", "action": "ochazuke.input.operator", "args": {"motion": "right"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "up", "action": "ochazuke.input.operator", "args": {"motion": "up"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "w", "action": "ochazuke.input.operator", "args": {"motion": "word-forward"}, "from": {"line": "line", "operator": "op", "steps": "steps"}},
      {"key": "y", "action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "y"}, "when": "op:y", "from": {"steps": "steps"}},
      {"key": "d", "action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "d"}, "when": "op:d", "from": {"steps": "steps"}},
      {"key": "c", "action": "ochazuke.input.operator", "args": {"motion": "line", "operator": "c"}, "when": "op:c", "from": {"steps": "steps"}},
      {"key": "g", "action": "ochazuke.mode.enter", "args": {"mode": "operator_g_pending"}, "from": {"count": "count", "op": "op", "opcount": "opcount"}},
      {"key": "digit-0", "action": "ochazuke.count.append", "from": {"digit": "digit"}},
      {"key": "esc", "action": "ochazuke.input.cancel"},
      {"key": "any", "action": "ochazuke.input.cancel"}
    ]},
    {"context": "ochazuke.editor/visual", "bindings": [
      {"key": "$", "action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "0", "action": "ochazuke.input.move", "args": {"motion": "line-start"}, "from": {"line": "line", "steps": "count"}},
      {"key": "G", "action": "ochazuke.input.move", "args": {"motion": "last-line"}, "from": {"line": "line", "steps": "count"}},
      {"key": "b", "action": "ochazuke.input.move", "args": {"motion": "word-backward"}, "from": {"line": "line", "steps": "count"}},
      {"key": "down", "action": "ochazuke.input.move", "args": {"motion": "down"}, "from": {"line": "line", "steps": "count"}},
      {"key": "e", "action": "ochazuke.input.move", "args": {"motion": "word-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "end", "action": "ochazuke.input.move", "args": {"motion": "line-end"}, "from": {"line": "line", "steps": "count"}},
      {"key": "h", "action": "ochazuke.input.move", "args": {"motion": "left"}, "from": {"line": "line", "steps": "count"}},
