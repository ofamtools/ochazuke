// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.yank-history", "bindings": [
      {"key": "j", "action": "ochazuke.yank-history.move", "args": {"steps": 1}},
      {"key": "down", "action": "ochazuke.yank-history.move", "args": {"steps": 1}},
      {"key": "k", "action": "ochazuke.yank-history.move", "args": {"steps": -1}},
      {"key": "up", "action": "ochazuke.yank-history.move", "args": {"steps": -1}},
      {"key": "g g", "action": "ochazuke.viewport.goto", "args": {"edge": "first"}, "from": {"row": "line"}, "hidden": true},
      {"key": "G", "action": "ochazuke.viewport.goto", "args": {"edge": "last"}, "from": {"row": "line"}, "hidden": true},
      {"key": "ctrl+d", "action": "ochazuke.viewport.scroll", "args": {"by": "page", "delta": 1, "half": true}, "from": {"steps": "line"}, "hidden": true},
      {"key": "ctrl+u", "action": "ochazuke.viewport.scroll", "args": {"by": "page", "delta": -1, "half": true}, "from": {"steps": "line"}, "hidden": true},
      {"key": "ctrl+f", "action": "ochazuke.viewport.scroll", "args": {"by": "page", "delta": 1}, "from": {"steps": "line"}, "hidden": true},
      {"key": "ctrl+b", "action": "ochazuke.viewport.scroll", "args": {"by": "page", "delta": -1}, "from": {"steps": "line"}, "hidden": true},
      {"key": "enter", "action": "ochazuke.yank-history.select"}
    ]}
  ]
}
