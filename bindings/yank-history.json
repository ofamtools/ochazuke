// ochazuke bindings (JSONC): groups by "noun/mode" context; each key maps to an action, {action, args, hint, when, ...}, null (unbind) or an array of those
{
  "bindings": [
    {"context": "ochazuke.yank-history", "bindings": {
      "j": {"action": "ochazuke.yank-history.move", "args": {"steps": 1}},
      "down": {"action": "ochazuke.yank-history.move", "args": {"steps": 1}},
      "k": {"action": "ochazuke.yank-history.move", "args": {"steps": -1}},
      "up": {"action": "ochazuke.yank-history.move", "args": {"steps": -1}},
      "enter": "ochazuke.yank-history.select",
      "esc": "ochazuke.modal.pop"
    }}
  ]
}
