// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.palette", "bindings": [
      {"key": "enter", "action": "ochazuke.palette.run"},
      {"key": "tab", "action": "ochazuke.palette.complete"},
      {"key": "ctrl+n", "action": "ochazuke.palette.move", "args": {"delta": 1}, "hidden": true},
      {"key": "ctrl+p", "action": "ochazuke.palette.move", "args": {"delta": -1}, "hidden": true},
      {"key": "shift+tab", "action": "ochazuke.palette.move", "args": {"delta": -1}},
      {"key": "up", "action": "ochazuke.palette.step", "args": {"direction": "up"}},
      {"key": "down", "action": "ochazuke.palette.step", "args": {"direction": "down"}},
      {"key": "left", "action": "ochazuke.palette.cell", "args": {"to": "left"}, "when": "setting:palette.style=board"},
      {"key": "right", "action": "ochazuke.palette.cell", "args": {"to": "right"}, "when": "setting:palette.style=board"},
      {"key": "home", "action": "ochazuke.palette.cell", "args": {"to": "first"}, "when": "setting:palette.style=board"},
      {"key": "end", "action": "ochazuke.palette.cell", "args": {"to": "last"}, "when": "setting:palette.style=board"},
      {"key": "alt+left", "action": "ochazuke.palette.cell", "args": {"to": "first-col"}, "when": "setting:palette.style=board"},
      {"key": "alt+right", "action": "ochazuke.palette.cell", "args": {"to": "last-col"}, "when": "setting:palette.style=board"},
      {"key": "backspace", "action": "ochazuke.palette.back", "when": "setting:palette.style=board"},
      {"key": "esc", "action": "ochazuke.palette.cancel", "when": "setting:palette.style=board"},
      {"key": "esc", "action": "ochazuke.modal.close", "when": "setting:modal.esc-closes"},
      {"key": "ctrl+c", "action": "ochazuke.palette.close"}
    ]},
    {"context": "ochazuke.palette/normal", "bindings": [
      {"key": "q", "action": "ochazuke.palette.close"}
    ]},
    {"context": "ochazuke.palette/insert", "bindings": [
      {"key": "printable", "action": "ochazuke.input.insert", "from": {"text": "text"}, "hidden": true},
      {"key": "paste", "action": "ochazuke.input.insert", "from": {"text": "text"}, "hidden": true}
    ]},
    {"context": "app/macro_pending", "bindings": [
      {"key": ":", "action": "ochazuke.palette.open", "args": {"recall": 1}, "help": "Q: opens the command line on the last command; up and down walk the history (Vim's command-line window, :help q:)"}
    ]}
  ]
}
