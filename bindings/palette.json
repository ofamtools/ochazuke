// ochazuke bindings (JSONC): groups by "noun/mode" context; each key maps to an action, {action, args, hint, when, ...}, null (unbind) or an array of those
{
  "bindings": [
    {"context": "ochazuke.palette", "bindings": {
      "enter": "ochazuke.palette.run",
      "tab": "ochazuke.palette.complete",
      "ctrl+n": {"action": "ochazuke.palette.move", "args": {"delta": 1}},
      "ctrl+p": {"action": "ochazuke.palette.move", "args": {"delta": -1}},
      "up": {"action": "ochazuke.palette.recall", "args": {"delta": 1}},
      "down": {"action": "ochazuke.palette.recall", "args": {"delta": -1}},
      "esc": "ochazuke.palette.cancel",
      "ctrl+c": "ochazuke.palette.close",
      "printable": {"action": "ochazuke.input.insert", "from": {"text": "text"}},
      "paste": {"action": "ochazuke.input.insert", "from": {"text": "text"}}
    }}
  ]
}
