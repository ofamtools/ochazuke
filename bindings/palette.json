// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.palette", "bindings": [
      {"key": "enter", "action": "ochazuke.palette.run"},
      {"key": "tab", "action": "ochazuke.palette.complete"},
      {"key": "ctrl+n", "action": "ochazuke.palette.move", "args": {"delta": 1}},
      {"key": "ctrl+p", "action": "ochazuke.palette.move", "args": {"delta": -1}},
      {"key": "up", "action": "ochazuke.palette.recall", "args": {"delta": 1}},
      {"key": "down", "action": "ochazuke.palette.recall", "args": {"delta": -1}},
      {"key": "esc", "action": "ochazuke.modal.close"},
      {"key": "ctrl+c", "action": "ochazuke.palette.close"},
      {"key": "printable", "action": "ochazuke.input.insert", "from": {"text": "text"}, "hidden": true},
      {"key": "paste", "action": "ochazuke.input.insert", "from": {"text": "text"}, "hidden": true}
    ]},
    {"context": "app/macro_pending", "bindings": [
      {"key": ":", "action": "ochazuke.palette.open", "args": {"recall": 1}, "help": "Q: opens the command line on the last command; up and down walk the history (Vim's command-line window, :help q:)"}
    ]}
  ]
}
