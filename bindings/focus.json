// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "app/normal", "bindings": [
      {"key": "}", "action": "ochazuke.focus.next", "from": {"steps": "count"}},
      {"key": "{", "action": "ochazuke.focus.previous", "from": {"steps": "count"}},
      {"key": ")", "action": "ochazuke.focus.next", "args": {"scope": "region"}, "from": {"steps": "count"}},
      {"key": "(", "action": "ochazuke.focus.previous", "args": {"scope": "region"}, "from": {"steps": "count"}},
      {"key": "tab", "action": "ochazuke.focus.next", "from": {"steps": "count"}},
      {"key": "shift+tab", "action": "ochazuke.focus.previous", "from": {"steps": "count"}}
    ]}
  ]
}
