// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.picker/insert", "bindings": [
      {"key": "ctrl+n", "action": "ochazuke.picker.move", "args": {"delta": 1}},
      {"key": "ctrl+p", "action": "ochazuke.picker.move", "args": {"delta": -1}},
      {"key": "alt+up", "action": "ochazuke.picker.parent"},
      {"key": "tab", "action": "ochazuke.picker.complete"},
      {"key": "enter", "action": "ochazuke.picker.enter"},
      {"key": "ctrl+s", "action": "ochazuke.picker.choose"},
      {"key": "esc", "action": "ochazuke.picker.close"}
    ]}
  ]
}
