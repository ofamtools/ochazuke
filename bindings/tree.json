// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.outline/normal", "bindings": [
      {"key": "l", "action": "ochazuke.outline.expand"},
      {"key": "right", "action": "ochazuke.outline.expand"},
      {"key": "h", "action": "ochazuke.outline.collapse"},
      {"key": "left", "action": "ochazuke.outline.collapse"},
      {"key": "z +", "action": "ochazuke.outline.zoom-in", "hidden": true},
      {"key": "z -", "action": "ochazuke.outline.zoom-out", "hidden": true},
      {"key": "z 0", "action": "ochazuke.outline.zoom-reset", "hidden": true},
      {"key": "o", "action": "ochazuke.outline.add", "args": {"where": "below"}},
      {"key": "O", "action": "ochazuke.outline.add", "args": {"where": "above"}},
      {"key": "a", "action": "ochazuke.outline.add", "args": {"where": "child"}},
      {"key": "i", "action": "ochazuke.outline.edit"},
      {"key": "tab", "action": "ochazuke.outline.indent"},
      {"key": "shift+tab", "action": "ochazuke.outline.outdent"},
      {"key": "> >", "action": "ochazuke.outline.indent", "hidden": true},
      {"key": "< <", "action": "ochazuke.outline.outdent", "hidden": true},
      {"key": "J", "action": "ochazuke.outline.move", "args": {"delta": 1}},
      {"key": "K", "action": "ochazuke.outline.move", "args": {"delta": -1}},
      {"key": "d d", "action": "ochazuke.outline.delete"},
      {"key": "u", "action": "ochazuke.outline.undo"},
      {"key": "ctrl+r", "action": "ochazuke.outline.redo"},
      {"key": "paste", "action": "ochazuke.outline.paste", "from": {"text": "text"}}
    ]},
    {"context": "ochazuke.outline/visual-line", "bindings": []},
    {"context": "ochazuke.outline-line/insert", "bindings": [
      {"key": "esc", "action": "ochazuke.outline.leave"},
      {"key": "enter", "action": "ochazuke.outline.next"},
      {"key": "tab", "action": "ochazuke.outline.indent"},
      {"key": "shift+tab", "action": "ochazuke.outline.outdent"},
      {"key": "paste", "action": "ochazuke.outline.paste", "from": {"text": "text"}}
    ]},
    {"context": "ochazuke.outline-row/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.outline.fold"}
    ]}
  ]
}
