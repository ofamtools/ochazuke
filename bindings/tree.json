// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.outline/normal", "bindings": [
      {"key": "l", "action": "ochazuke.outline.expand"},
      {"key": "right", "action": "ochazuke.outline.expand"},
      {"key": "h", "action": "ochazuke.outline.collapse"},
      {"key": "left", "action": "ochazuke.outline.collapse"},
      {"key": "z +", "action": "ochazuke.outline.zoom-in", "hidden": true},
      {"key": "z -", "action": "ochazuke.outline.zoom-out", "hidden": true},
      {"key": "z 0", "action": "ochazuke.outline.zoom-reset", "hidden": true},
      {"key": "o", "action": "ochazuke.outline.add", "args": {"where": "below"}},
      {"key": "O", "action": "ochazuke.outline.add", "args": {"where": "above"}},
      {"key": "a", "action": "ochazuke.outline.add", "args": {"where": "child"}},
      {"key": "i", "action": "ochazuke.outline.edit"},
      {"key": "tab", "action": "ochazuke.outline.indent"},
      {"key": "shift+tab", "action": "ochazuke.outline.outdent"},
      {"key": "> >", "action": "ochazuke.outline.indent", "hidden": true},
      {"key": "< <", "action": "ochazuke.outline.outdent", "hidden": true},
      {"key": "J", "action": "ochazuke.outline.move", "args": {"delta": 1}, "from": {"count": "count"}},
      {"key": "K", "action": "ochazuke.outline.move", "args": {"delta": -1}, "from": {"count": "count"}},
      {"key": "g J", "action": "ochazuke.outline.move", "args": {"to": "last"}, "hint": "move to last"},
      {"key": "g K", "action": "ochazuke.outline.move", "args": {"to": "first"}, "hint": "move to first"},
      {"key": "d d", "action": "ochazuke.outline.delete"},
      {"key": "y y", "action": "ochazuke.outline.yank"},
      {"key": "p", "action": "ochazuke.outline.put"},
      {"key": "P", "action": "ochazuke.outline.put", "args": {"before": true}},
      {"key": "u", "action": "ochazuke.outline.undo"},
      {"key": "ctrl+r", "action": "ochazuke.outline.redo"},
      {"key": "paste", "action": "ochazuke.outline.paste", "from": {"text": "text"}},
      {"key": "b", "action": "ochazuke.outline.archive", "hidden": true},
      {"key": "F", "action": "ochazuke.outline.create", "hidden": true},
      {"key": "z 1", "action": "ochazuke.outline.fold", "hidden": true},
      {"key": "f", "action": "ochazuke.outline.next", "hidden": true},
      {"key": "k", "action": "ochazuke.outline.row-key", "hidden": true}
    ]},
    {"context": "ochazuke.outline/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.outline/visual-line", "bindings": [
      {"key": "d", "action": "ochazuke.outline.delete"},
      {"key": "J", "action": "ochazuke.outline.move", "args": {"delta": 1}, "from": {"count": "count"}},
      {"key": "K", "action": "ochazuke.outline.move", "args": {"delta": -1}, "from": {"count": "count"}},
      {"key": "g J", "action": "ochazuke.outline.move", "args": {"to": "last"}, "hint": "move to last"},
      {"key": "g K", "action": "ochazuke.outline.move", "args": {"to": "first"}, "hint": "move to first"},
      {"key": "b", "action": "ochazuke.outline.add", "hidden": true},
      {"key": "p", "action": "ochazuke.outline.archive", "hidden": true},
      {"key": "c", "action": "ochazuke.outline.collapse", "hidden": true},
      {"key": "E", "action": "ochazuke.outline.create", "hidden": true},
      {"key": "H", "action": "ochazuke.outline.edit", "hidden": true},
      {"key": "f", "action": "ochazuke.outline.expand", "hidden": true},
      {"key": "i", "action": "ochazuke.outline.fold", "hidden": true},
      {"key": "M", "action": "ochazuke.outline.get", "hidden": true},
      {"key": "P", "action": "ochazuke.outline.history", "hidden": true},
      {"key": "j", "action": "ochazuke.outline.indent", "hidden": true},
      {"key": "k", "action": "ochazuke.outline.leave", "hidden": true},
      {"key": "S", "action": "ochazuke.outline.list", "hidden": true},
      {"key": "m", "action": "ochazuke.outline.next", "hidden": true},
      {"key": "t", "action": "ochazuke.outline.outdent", "hidden": true},
      {"key": "w", "action": "ochazuke.outline.paste", "hidden": true},
      {"key": "A", "action": "ochazuke.outline.put", "hidden": true},
      {"key": "B", "action": "ochazuke.outline.redo", "hidden": true},
      {"key": "C", "action": "ochazuke.outline.row-key", "hidden": true},
      {"key": "ctrl+y", "action": "ochazuke.outline.set", "hidden": true},
      {"key": "alt+f", "action": "ochazuke.outline.show", "hidden": true},
      {"key": "D", "action": "ochazuke.outline.undo", "hidden": true},
      {"key": "alt+p", "action": "ochazuke.outline.watch", "hidden": true},
      {"key": "alt+r", "action": "ochazuke.outline.yank", "hidden": true},
      {"key": "F", "action": "ochazuke.outline.zoom-in", "hidden": true},
      {"key": "G", "action": "ochazuke.outline.zoom-out", "hidden": true},
      {"key": "I", "action": "ochazuke.outline.zoom-reset", "hidden": true}
    ]},
    {"context": "ochazuke.outline-line/insert", "bindings": [
      {"key": "esc", "action": "ochazuke.outline.leave"},
      {"key": "enter", "action": "ochazuke.outline.next"},
      {"key": "tab", "action": "ochazuke.outline.row-key", "from": {"key": "key"}, "hint": "indent"},
      {"key": "shift+tab", "action": "ochazuke.outline.row-key", "from": {"key": "key"}, "hint": "outdent"},
      {"key": "paste", "action": "ochazuke.outline.paste", "from": {"text": "text"}}
    ]},
    {"context": "ochazuke.outline-row/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.outline.fold"}
    ]}
  ]
}
