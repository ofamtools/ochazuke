// ochazuke settings (JSONC): the framework's own settings, one row per setting, {name, type, default, description, enum, deprecated}.
// The defaults live here, not in Go. EnsureConfigSettings (EnsureTerminalLeader for terminal-leader) declares each row unless the
// application declared the name first with its own default; until then a binding row naming the setting ({terminal-leader}) and the
// key resolver read the default here. "deprecated" lists older names that still read and write the setting for one release.
[
  {"name": "rename.select", "type": "boolean", "default": true, "description": "A rename opens with the whole name selected: typing replaces it, a motion keeps it and moves; off opens it with the cursor at the end"},
  {"name": "sequence-timeout", "type": "duration", "default": "0s", "description": "How long a pending key sequence (g g, z R, the terminal leader) waits for its next key before the shorter binding runs; 0 waits until a key comes", "deprecated": ["terminal-leader-timeout"]},
  {"name": "sequence-unknown", "type": "string", "default": "pass", "enum": ["pass", "swallow"], "description": "A key no binding continues a pending sequence with: pass ends the sequence (its shorter binding runs) and handles the key as if typed alone; swallow drops the sequence and the key with a notice"},
  {"name": "tree.breadcrumb", "type": "string", "default": "line", "enum": ["line", "title", "off"], "description": "Where a zoomed tree shows the levels it hides: line (a dimmed line above its rows), title (in the header beside the mode, while the tree has the focus) or off"},
  {"name": "tree.breadcrumb.ancestors", "type": "integer", "default": 2, "description": "How many of the nearest hidden ancestors a zoomed tree's breadcrumb names; farther ones fold into …; 0 names them all"},
  {"name": "tree.zoom", "type": "string", "default": "manual", "enum": ["manual", "auto", "off"], "description": "Tree zoom: manual (only z +, z -, z 0 and h past the top), auto (also zooms when the selected row's indent takes over half the tree's width) or off (no zoom)"},
  {"name": "tree.zoom.root", "type": "string", "default": "crumb", "enum": ["crumb", "row"], "description": "Where a tree's zoomed-on node goes: crumb (it ends the breadcrumb and its children are the top rows) or row (it stays as the top row)"},
  {"name": "terminal-leader", "type": "string", "default": "ctrl+a", "description": "Terminal leader key: then d detaches, the leader again sends it to the pane"},
  {"name": "visual.after-action", "type": "string", "default": "end", "enum": ["end", "keep"], "description": "After a key acts on a visual selection of list rows (V j d): end leaves the selection and visual-line, as in Vim; keep keeps the selection on the rows still shown, so the next key acts on them too"},
  {"name": "visual.list", "type": "string", "default": "mode", "enum": ["mode", "marks"], "description": "V on a list, table or tree: mode enters visual-line, where single keys act on the selection (d, y, an application's own); marks selects in normal mode, as before, the rows' normal keys acting on the selection"}
]
