// ochazuke settings (JSONC): the framework's own settings, one row per setting, {name, section, type, default, description, enum, deprecated}.
// Every row is owned by ochazuke (a tab of the Settings page); "section" files it in a section of that tab, titled and ordered by sections.json.
// The defaults live here, not in Go. Every row of this file is declared when the runtime is made (NewRuntime), so an application can
// read or set it at startup and a user's settings.json naming it loads with no warning. An application that declares the name itself
// (DeclareSetting, at any time) replaces the row with its own default. Settings only some applications have live in other files of
// this directory and are declared by the feature that needs them (terminal.json: EnsureTerminalLeader). "deprecated" lists older
// names that still read and write the setting for one release. The rows' order is their order inside a section.
[
  {"name": "modal-dim", "section": "appearance", "type": "integer", "default": 35, "description": "Percent the page behind a modal fades toward the background (0 is off)"},
  {"name": "modal-highlights", "section": "appearance", "type": "string", "default": "keep", "enum": ["keep", "plain"], "description": "The page's highlights beneath a modal: keep draws them dimmed (a list's cursor bar, a grid's cursor cell, so you see where you were); plain draws the backdrop without reverse video or underline, so no sliver of a cursor bar shows beside a wide modal"},
  {"name": "dim-unfocused", "section": "appearance", "type": "integer", "default": 20, "description": "Percent a list without the focus fades toward the background; its selected row stays marked (0 is off)"},
  {"name": "help.pick-view", "section": "help", "type": "boolean", "default": true, "description": "S in the ? help shows the keys for a noun and mode you pick"},
  {"name": "help.table-view", "section": "help", "type": "boolean", "default": true, "description": "S in the ? help shows a noun's keys as a table, a column per mode"},
  {"name": "help.hints-hidden", "section": "help", "type": "boolean", "default": false, "description": "The footer and every modal's hint line also show the rows marked hidden: the editor's insert keys (ctrl+k, ctrl+w, backspace), the palette key ctrl+space, counts and registers; off leaves them to ? help and bindings list, as motions are"},
  {"name": "help.pending-modes", "section": "help", "type": "boolean", "default": false, "description": "The ? help's pick and table views offer the pending modes too (counts, operators, the terminal leader, key-sequence prefixes)"},
  {"name": "docs.show-config", "section": "help", "type": "boolean", "default": true, "description": "The docs viewer (docs open, :help) marks where your settings.json and bindings.json differ from the defaults with yours: lines; off, a page reads as the committed reference"},
  {"name": "palette.missing-opens-form", "section": "palette", "type": "boolean", "default": true, "description": "Enter on a command line, or a key, whose action lacks a required argument opens a form for its arguments; off names the missing word instead"},
  {"name": "palette.standard-verbs", "section": "palette", "type": "list", "default": ["last", "tag", "record"], "description": "How the palette shows the standard verbs (get, list, create, set, delete, watch): one ordering, last (a noun's named verbs first), mixed (one alphabetical list) or hidden (left out of the verb list; typing the name still runs one), plus tag (a std tag beside each) and record (get shows prop and value rows); a part left out is today's palette, so [] turns them all off"},
  {"name": "focus-display", "section": "appearance", "type": "string", "default": "off", "enum": ["off", "noun", "stack"], "description": "Show where the focus is, left of the mode badge: off, noun (the focused noun) or stack (the focus path, outermost first)"},
  {"name": "mode-badge.key-case", "section": "appearance", "type": "string", "default": "upper", "enum": ["upper", "as-typed"], "description": "The keys a pending mode holds in the mode badge: upper (NORMAL G for both g and G, LEADER PENDING CTRL+A) or as-typed (NORMAL g, NORMAL G, LEADER PENDING ctrl+a); the mode's name stays upper case"},
  {"name": "mode-badge.width", "section": "appearance", "type": "string", "default": "widest", "enum": ["widest", "fit"], "description": "The cells the mode badge takes at the right end of the title row: widest pads every mode to the widest mode's name, so the badge holds still as the mode changes; fit draws each mode in its own cells (only its right edge holds still)"},
  {"name": "chrome.color", "section": "appearance", "type": "string", "default": "rich", "enum": ["off", "subtle", "rich"], "description": "Colour in the chrome: rich colours every border (a pane's border by its state, the focused one by the mode), fills the mode badge with the mode's colour and colours the hint keys; subtle tints foregrounds only and colours only the alert states; off draws the chrome as before 0.58. themes.json tones named chrome.<level>.<role> change any of it"},
  {"name": "keys.echo", "section": "keys", "type": "string", "default": "off", "enum": ["off", "footer", "badge"], "description": "Show the last keys pressed, as a screencast does (for recordings, demos and bug reports): off, footer (the right end of the footer line) or badge (on the title row, left of the mode badge); counts and sequences group as typed (5j, g g), text typed into an input collapses, a secret input shows nothing"},
  {"name": "keys.echo-width", "section": "keys", "type": "integer", "default": 28, "description": "The cells the key echo reserves (at most half the line), drawn or not, so the line never reflows as keys come and go; older keys are dropped with … to fit"},
  {"name": "keys.echo-count", "section": "keys", "type": "integer", "default": 5, "description": "How many entries the key echo keeps (a key, a sequence, a run of typed text, a command)"},
  {"name": "keys.echo-linger", "section": "keys", "type": "duration", "default": "3s", "description": "How long an entry stays in the key echo after its last key; 0s keeps it until newer ones push it out"},
  {"name": "keys.echo-typing", "section": "keys", "type": "string", "default": "text", "enum": ["text", "count"], "description": "Text typed into an input in the key echo: text shows it (\"hello\"), count only how many keys (typed 5); a secret input shows nothing either way"},
  {"name": "keys.echo-commands", "section": "keys", "type": "boolean", "default": true, "description": "The key echo shows a palette line as the command it ran (:page open docs); off shows :… in its place"},
  {"name": "keys.echo-terminal", "section": "keys", "type": "boolean", "default": false, "description": "The key echo also shows the keys an attached terminal pane receives (its typed text collapsed); off shows only the keys ochazuke handles there (the leader and what follows it), so a password typed into a shell never shows"},
  {"name": "hooks.enabled", "section": "hooks", "type": "boolean", "default": true, "description": "Run the hook rows: the application's hooks.json (in its own config directory) and the defaults it and its extensions declare, which run a verb when an event happens (a modal, form or page closed after a change, the application quitting); off, events still happen and nothing runs"},
  {"name": "status.segments", "section": "status", "type": "boolean", "default": true, "description": "Show the status segments (cpu, disk, an extension's) in the header rule; off hides them all and stops their refreshes"},
  {"name": "status.segment-order", "section": "status", "type": "list", "default": [], "description": "Segment ids in the order the header rule draws them (segment.move writes it); the rest follow"},
  {"name": "sequence-timeout", "section": "keys", "type": "duration", "default": "0s", "description": "How long a pending key sequence (g g, z R, the terminal leader) waits for its next key before the shorter binding runs; 0 waits until a key comes", "deprecated": ["terminal-leader-timeout"]},
  {"name": "sequence-unknown", "section": "keys", "type": "string", "default": "pass", "enum": ["pass", "swallow"], "description": "A key no binding continues a pending sequence with: pass ends the sequence (its shorter binding runs) and handles the key as if typed alone; swallow drops the sequence and the key with a notice"},
  {"name": "sequence-inherit", "section": "keys", "type": "string", "default": "drop", "enum": ["drop", "keep"], "description": "A key sequence a mode inherits from the mode it extends (a row's normal d d in visual-line) when the mode binds the keys typed on its own (visual-line d): drop runs the mode's own key at once, as in Vim (V j d); keep waits for the inherited sequence"},
  {"name": "rename.select", "section": "lists", "type": "boolean", "default": true, "description": "A rename opens with the whole name selected: typing replaces it, a motion keeps it and moves; off opens it with the cursor at the end"},
  {"name": "create.from-focus", "section": "records", "type": "boolean", "default": true, "description": "A standard create fills a reference prop declared fromFocus (a new task's project) from the focused thing of its noun when you leave it out, and says so: the palette slot, the args form and a notice show the value; off fills nothing and the reference stays empty"},
  {"name": "delete.archive", "section": "records", "type": "boolean", "default": false, "description": "A standard delete on a noun with an archive prop archives a live thing (sets the prop) and deletes an archived one for real; the confirm says which (delete.archive-confirm); off, delete is the store's delete; nouns without an archive prop are unchanged"},
  {"name": "delete.archive-confirm", "section": "records", "type": "boolean", "default": true, "description": "With delete.archive on, a delete that will only archive the thing asks first, saying so (Archive task X? delete it again to delete it for good); off archives without asking (restore undoes it); the real delete of an archived thing always asks"},
  {"name": "cli.standard-verbs", "section": "palette", "type": "string", "default": "line", "enum": ["line", "list"], "description": "How the CLI's help shows a noun's standard verbs (get, list, set, rename and the rest): line names them on one line of the noun's help (BIN NOUN --help) and after std in its summary, the noun's own verbs keeping their entries; list gives each its own entry with its parameters. Every verb runs either way"},
  {"name": "repeat.empty", "section": "keys", "type": "string", "default": "info", "enum": ["info", "silent"], "description": "Dot-repeat (.) with nothing to repeat here: info says nothing to repeat on the status line, plain; silent shows nothing"},
  {"name": "tree.zoom", "section": "lists", "type": "string", "default": "manual", "enum": ["manual", "auto", "off"], "description": "Tree zoom: manual (only z +, z -, z 0 and h past the top), auto (also zooms when the selected row's indent takes over half the tree's width) or off (no zoom)"},
  {"name": "tree.zoom.root", "section": "lists", "type": "string", "default": "crumb", "enum": ["crumb", "row"], "description": "Where a tree's zoomed-on node goes: crumb (it ends the breadcrumb and its children are the top rows) or row (it stays as the top row)"},
  {"name": "tree.breadcrumb", "section": "lists", "type": "string", "default": "line", "enum": ["line", "title", "off"], "description": "Where a zoomed tree shows the levels it hides: line (a dimmed line above its rows), title (in the header beside the mode, while the tree has the focus) or off"},
  {"name": "tree.breadcrumb.ancestors", "section": "lists", "type": "integer", "default": 2, "description": "How many of the nearest hidden ancestors a zoomed tree's breadcrumb names; farther ones fold into …; 0 names them all"},
  {"name": "tree.spill", "section": "lists", "type": "string", "default": "left", "enum": ["left", "both", "off"], "description": "Which of a tree's h/l act as on a table where the tree has nothing to do on the row: left (h on a closed or childless top-level node scrolls the columns back, then moves the focus to the previous stop), both (l on a leaf also scrolls, then moves to the next stop) or off (neither)"},
  {"name": "visual.after-action", "section": "lists", "type": "string", "default": "end", "enum": ["end", "keep"], "description": "After a key acts on a visual selection of list rows (V j d): end leaves the selection and visual-line, as in Vim; keep keeps the selection on the rows still shown, so the next key acts on them too"},
  {"name": "table.fit-follows-cursor", "section": "lists", "type": "boolean", "default": false, "description": "A cell-mode table lays its current column out at its widest cell or title as the cursor reaches it (as Vim's winwidth widens the current window), the column going back to its width when the cursor leaves; a width given with z f, z F, z > or z < wins; off, the columns change width only on z f, z F, z >, z < and z ="},
  {"name": "visual.list", "section": "lists", "type": "string", "default": "mode", "enum": ["mode", "marks"], "description": "V on a list, table or tree: mode enters visual-line, where single keys act on the selection (d, y, an application's own); marks selects in normal mode, as before, the rows' normal keys acting on the selection"},
  {"name": "tones.selected-background", "section": "appearance", "type": "string", "default": "drop", "enum": ["drop", "keep"], "description": "A cell drawn on a tone background (an error) on the selected row: drop keeps the row one reverse bar; keep draws the cell on its background, bold, out of the bar"},
  {"name": "list.intersect", "section": "appearance", "type": "boolean", "default": true, "description": "Where two highlights cross in a table (the selected row and a highlighted column, a highlighted row and column, a search hit on the selected row), the cell takes its part's intersect tone (list.cell.intersect, list.header.intersect, list.rownum.intersect) so the crossing reads at a glance; off draws the highlights as before, the later one winning"},
  {"name": "list.part-tones", "section": "appearance", "type": "boolean", "default": true, "description": "A table's header row and its non-data columns (row numbers) draw in their own tones (list.header, list.rownum) so they never read as data; off draws the header bold and those columns as data, as before"},
  {"name": "aliases.shadow", "section": "keys", "type": "string", "default": "refuse", "enum": ["refuse", "allow"], "description": "A bare actions.json alias (w!, q) named like a verb: refuse skips the row and reports it; allow loads it, and typed alone it runs the alias, the verb still reached as noun verb"},
  {"name": "search.case", "section": "search", "type": "string", "default": "smart", "enum": ["smart", "ignore", "sensitive"], "description": "How every search and filter (the path picker, the path chooser's typed completion, choosers, the / list filter) treats case: smart ignores it unless the query holds an upper-case letter, then matches it exactly (Vim's ignorecase with smartcase); ignore always ignores it; sensitive always matches it"},
  {"name": "search.match", "section": "search", "type": "string", "default": "substring", "enum": ["substring", "fuzzy", "regex"], "description": "How the / list filter (lists, tables, trees) matches its query: substring keeps the rows holding every word of it; fuzzy the rows holding its characters in order; regex the rows a Go RE2 regular expression matches (an invalid one matches nothing and the filter line says why). tab (search.cycle-match) steps an open filter through them for that list only"},
  {"name": "chooser.match", "section": "search", "type": "string", "default": "fuzzy", "enum": ["substring", "fuzzy", "regex"], "description": "How choosers and the path picker match their query (substring, fuzzy or regex, as search.match); tab in a chooser and ctrl+t in the path picker (search.cycle-match) step an open one through them for that search only. A chooser whose application filters or ranks its rows itself keeps its own matching"},
  {"name": "search.show-match", "section": "search", "type": "boolean", "default": true, "description": "Show the match mode (substr, fuzzy, regex) at the right end of the / filter line, a chooser's search line and the path picker's path line; off hides the tag (the mode still applies)"},
  {"name": "chooser.remember-source", "section": "choosers", "type": "boolean", "default": true, "description": "A chooser with several sources (tab cycles them) reopens on the source last used for its kind; off opens on its first source"},
  {"name": "chooser.stable-height", "section": "choosers", "type": "boolean", "default": true, "description": "A chooser keeps the height it reached while it is open: as typing narrows the matches, blank rows hold its size so the search line does not move (R4.9); off sizes it to the rows that match"},
  {"name": "chooser.enter", "section": "choosers", "type": "string", "default": "open", "enum": ["open", "pick"], "description": "Enter on a chooser row that can be both opened and picked (a folder in a folder chooser): open browses into it (alt+enter picks it), pick takes it (ctrl+l opens it)"},
  {"name": "forms.single-path", "section": "palette", "type": "string", "default": "chooser", "enum": ["chooser", "alone", "form"], "description": "A key or command line whose only missing required argument is a path: chooser opens the path chooser at once and its pick runs the action (optional arguments left out); alone does so only when the path is its one argument; form opens the args form (on the path, its chooser open over it)"},
  {"name": "forms.outside-write", "section": "records", "type": "string", "default": "reload", "enum": ["reload", "close"], "description": "A record editor open on a record that is written from outside it (a set from the palette, another client): reload takes the new values and stays open, keeping the focus, the field and the mode (a field with unsaved typing keeps the typing); close leaves the editor"},
  {"name": "modal.anchor", "section": "appearance", "type": "boolean", "default": true, "description": "A modal opened for something on the page (a form field's chooser) is drawn beside it, sized to its rows, so the field and the lines around it stay visible (below or above it when there is no room beside); off centers it as every other modal"},
  {"name": "path.start", "section": "choosers", "type": "string", "default": "base", "enum": ["base", "home", "cwd"], "description": "Where the path chooser's browse starts when the parameter names no base and the field is empty: base (the folder the application gives, such as the open file's, else the working directory), home or cwd"},
  {"name": "path.field", "section": "choosers", "type": "string", "default": "picker", "enum": ["picker", "text"], "description": "A path field in a form: picker (a stop whose enter, space or i opens the path chooser) or text (typed freely; enter in normal mode or ctrl+space opens the path chooser)"},
  {"name": "path.hidden", "section": "choosers", "type": "boolean", "default": false, "description": "The path chooser's browse source lists hidden entries (names starting with .); off, typing a path starting with . still lists them"},
  {"name": "path.no-auto-list", "section": "choosers", "type": "list", "default": ["/Volumes/", "/mnt/", "/media/", "/run/media/"], "description": "Folders under these prefixes (external volumes) are never listed on their own: browse waits until you open one or type a path into it"},
  {"name": "settings.layout", "section": "settings", "type": "string", "default": "tabs+sections", "enum": ["tabs+sections", "tabs", "sections"], "description": "How the Settings page lays out its settings: tabs+sections (a tab per owner: the application, its extensions, ochazuke; the shown tab's sections in a list on the left), tabs (a tab per section and no section list, the page before owners) or sections (no tabs; the section list holds every owner's sections under a heading per owner)"},
  {"name": "settings.narrow-width", "section": "settings", "type": "integer", "default": 72, "description": "Below this many columns the Settings page folds its section list into a selector line at the top of the settings (h/l step it, s picks one); 0 never folds"},
  {"name": "settings.autosave", "section": "settings", "type": "boolean", "default": false, "description": "A session write (a :set line, setting verbs with session scope) goes straight to settings.json; off keeps it for this session until settings.write (alias save, mksettings). The Settings page and settings set always save at once"},
  {"name": "settings.mark-session", "section": "settings", "type": "boolean", "default": true, "description": "The Settings page draws a session value bold with the saved value beside it, stack  (saved: tabs), while the two differ"},
  {"name": "nouns.display", "section": "keys", "type": "string", "default": "shortest", "enum": ["shortest", "framework", "canonical"], "description": "The name hints, the ? help, the palette and the jobs ticker draw a noun by: shortest is its shortest live alias (doc for an extension's json.doc a host aliased doc; list for ochazuke.list), never a deprecated one; framework only shortens the framework's own nouns (ochazuke.list as list), as before; canonical draws every noun by its registered name. Output (history, bindings list, the catalog) is always canonical"},
  {"name": "palette.namespace-words", "section": "palette", "type": "boolean", "default": true, "description": "Leading words that join with dots into a noun read as that noun, as on the CLI (json doc rows is json.doc rows), and the words after a namespace complete to its nouns (json then doc); off reads only the dotted spelling"},
  {"name": "palette.noun-tails", "section": "palette", "type": "boolean", "default": true, "description": "A word no noun or alias claims reads as the namespaced nouns whose last part it is: one such noun is taken (doc for json.doc), several are offered by their full names (json.doc, md.doc) and none is picked; off leaves such a word unresolved"},
  {"name": "palette.choice-words", "section": "palette", "type": "string", "default": "word", "enum": ["word", "id"], "description": "What the palette completes and accepts for a choice that has a word of its own (a page's title for page open): word offers and takes that word (its id still runs when typed whole); id offers the ids, as before"},
  {"name": "palette.text-results", "section": "palette", "type": "string", "default": "editor", "enum": ["editor", "all", "plain"], "description": "How the palette shows a verb's text result (a verb declared TextResult, such as a jq program or a JSON mapping): editor opens it in a read-only editor (one line or many, by the text) to move, select with v, V or ctrl+v and yank with y; all does that too for any other string answer; plain shows a text result as before (a JSON array in the results table, else nothing)"},
  {"name": "yank.report", "section": "keys", "type": "boolean", "default": true, "description": "A yank in an editor or the read-only text view says on the status line what it copied (copied 1 line, copied 12 characters), as a table's y does; off yanks silently. Vim reports only past 'report' lines"},
  {"name": "clipboard", "section": "keys", "type": "string", "default": "yanks", "enum": ["none", "yanks", "unnamed"], "description": "Which yanks also go to the system clipboard (through the terminal, OSC 52): yanks copies every yank (y), not a delete; unnamed copies every yank and delete, as Vim's clipboard=unnamed; none copies only what is yanked into the clipboard register (\"+y)"}
]
