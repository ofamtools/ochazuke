// ochazuke settings (JSONC): the framework's own settings, one row per setting, {name, type, default, description, enum, deprecated}.
// The defaults live here, not in Go. Every row of this file is declared when the runtime is made (NewRuntime), so an application can
// read or set it at startup and a user's settings.json naming it loads with no warning. An application that declares the name itself
// (DeclareSetting, at any time) replaces the row with its own default. Settings only some applications have live in other files of
// this directory and are declared by the feature that needs them (terminal.json: EnsureTerminalLeader). "deprecated" lists older
// names that still read and write the setting for one release. The rows' order is the Settings page's order.
[
  {"name": "modal-dim", "type": "integer", "default": 35, "description": "Percent the page behind a modal fades toward the background (0 is off)"},
  {"name": "dim-unfocused", "type": "integer", "default": 20, "description": "Percent a list without the focus fades toward the background; its selected row stays marked (0 is off)"},
  {"name": "help.pick-view", "type": "boolean", "default": true, "description": "S in the ? help shows the keys for a noun and mode you pick"},
  {"name": "help.table-view", "type": "boolean", "default": true, "description": "S in the ? help shows a noun's keys as a table, a column per mode"},
  {"name": "help.pending-modes", "type": "boolean", "default": false, "description": "The ? help's pick and table views offer the pending modes too (counts, operators, the terminal leader, key-sequence prefixes)"},
  {"name": "palette.missing-opens-form", "type": "boolean", "default": true, "description": "Enter on a command line, or a key, whose action lacks a required argument opens a form for its arguments; off names the missing word instead"},
  {"name": "focus-display", "type": "string", "default": "off", "enum": ["off", "noun", "stack"], "description": "Show where the focus is beside the mode: off, noun (the focused noun) or stack (the focus path, outermost first)"},
  {"name": "status.segments", "type": "boolean", "default": true, "description": "Show the status segments (cpu, disk, an extension's) in the header rule; off hides them all and stops their refreshes"},
  {"name": "status.segment-order", "type": "list", "default": [], "description": "Segment ids in the order the header rule draws them (segment.move writes it); the rest follow"},
  {"name": "sequence-timeout", "type": "duration", "default": "0s", "description": "How long a pending key sequence (g g, z R, the terminal leader) waits for its next key before the shorter binding runs; 0 waits until a key comes", "deprecated": ["terminal-leader-timeout"]},
  {"name": "sequence-unknown", "type": "string", "default": "pass", "enum": ["pass", "swallow"], "description": "A key no binding continues a pending sequence with: pass ends the sequence (its shorter binding runs) and handles the key as if typed alone; swallow drops the sequence and the key with a notice"},
  {"name": "sequence-inherit", "type": "string", "default": "drop", "enum": ["drop", "keep"], "description": "A key sequence a mode inherits from the mode it extends (a row's normal d d in visual-line) when the mode binds the keys typed on its own (visual-line d): drop runs the mode's own key at once, as in Vim (V j d); keep waits for the inherited sequence"},
  {"name": "rename.select", "type": "boolean", "default": true, "description": "A rename opens with the whole name selected: typing replaces it, a motion keeps it and moves; off opens it with the cursor at the end"},
  {"name": "repeat.empty", "type": "string", "default": "info", "enum": ["info", "silent"], "description": "Dot-repeat (.) with nothing to repeat here: info says nothing to repeat on the status line, plain; silent shows nothing"},
  {"name": "tree.zoom", "type": "string", "default": "manual", "enum": ["manual", "auto", "off"], "description": "Tree zoom: manual (only z +, z -, z 0 and h past the top), auto (also zooms when the selected row's indent takes over half the tree's width) or off (no zoom)"},
  {"name": "tree.zoom.root", "type": "string", "default": "crumb", "enum": ["crumb", "row"], "description": "Where a tree's zoomed-on node goes: crumb (it ends the breadcrumb and its children are the top rows) or row (it stays as the top row)"},
  {"name": "tree.breadcrumb", "type": "string", "default": "line", "enum": ["line", "title", "off"], "description": "Where a zoomed tree shows the levels it hides: line (a dimmed line above its rows), title (in the header beside the mode, while the tree has the focus) or off"},
  {"name": "tree.breadcrumb.ancestors", "type": "integer", "default": 2, "description": "How many of the nearest hidden ancestors a zoomed tree's breadcrumb names; farther ones fold into …; 0 names them all"},
  {"name": "visual.after-action", "type": "string", "default": "end", "enum": ["end", "keep"], "description": "After a key acts on a visual selection of list rows (V j d): end leaves the selection and visual-line, as in Vim; keep keeps the selection on the rows still shown, so the next key acts on them too"},
  {"name": "visual.list", "type": "string", "default": "mode", "enum": ["mode", "marks"], "description": "V on a list, table or tree: mode enters visual-line, where single keys act on the selection (d, y, an application's own); marks selects in normal mode, as before, the rows' normal keys acting on the selection"},
  {"name": "tones.selected-background", "type": "string", "default": "drop", "enum": ["drop", "keep"], "description": "A cell drawn on a tone background (an error) on the selected row: drop keeps the row one reverse bar; keep draws the cell on its background, bold, out of the bar"},
  {"name": "aliases.shadow", "type": "string", "default": "refuse", "enum": ["refuse", "allow"], "description": "A bare actions.json alias (w!, q) named like a verb: refuse skips the row and reports it; allow loads it, and typed alone it runs the alias, the verb still reached as noun verb"},
  {"name": "chooser.remember-source", "type": "boolean", "default": true, "description": "A chooser with several sources (tab cycles them) reopens on the source last used for its kind; off opens on its first source"},
  {"name": "chooser.enter", "type": "string", "default": "open", "enum": ["open", "pick"], "description": "Enter on a chooser row that can be both opened and picked (a folder in a folder chooser): open browses into it (alt+enter picks it), pick takes it (ctrl+l opens it)"},
  {"name": "forms.single-path", "type": "string", "default": "chooser", "enum": ["chooser", "alone", "form"], "description": "A key or command line whose only missing required argument is a path: chooser opens the path chooser at once and its pick runs the action (optional arguments left out); alone does so only when the path is its one argument; form opens the args form (on the path, its chooser open over it)"},
  {"name": "path.start", "type": "string", "default": "base", "enum": ["base", "home", "cwd"], "description": "Where the path chooser's browse starts when the parameter names no base and the field is empty: base (the folder the application gives, such as the open file's, else the working directory), home or cwd"},
  {"name": "path.field", "type": "string", "default": "picker", "enum": ["picker", "text"], "description": "A path field in a form: picker (a stop whose enter, space or i opens the path chooser) or text (typed freely; enter in normal mode or ctrl+space opens the path chooser)"},
  {"name": "path.hidden", "type": "boolean", "default": false, "description": "The path chooser's browse source lists hidden entries (names starting with .); off, typing a path starting with . still lists them"},
  {"name": "path.no-auto-list", "type": "list", "default": ["/Volumes/", "/mnt/", "/media/", "/run/media/"], "description": "Folders under these prefixes (external volumes) are never listed on their own: browse waits until you open one or type a path into it"},
  {"name": "settings.autosave", "type": "boolean", "default": false, "description": "A session write (a :set line, setting verbs with session scope) goes straight to settings.json; off keeps it for this session until settings.write (alias save, mksettings). The Settings page and settings set always save at once"},
  {"name": "settings.mark-session", "type": "boolean", "default": true, "description": "The Settings page draws a session value bold with the saved value beside it, stack  (saved: tabs), while the two differ"}
]
