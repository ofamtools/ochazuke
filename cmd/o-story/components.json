{
  "about": "The o-story component map: which framework nouns each component owns, the story areas that test it, its neighbours, and the axis values that apply to it. o-story matrix derives the actions from a runtime's rows and operations and crosses them with these axes; o-story coverage compares the cells with the stories' covers. Validated by internal/storymatrix's tests.",
  "axes": {
    "order": ["to", "direction", "surface", "mode", "placement", "focus", "outcome", "data", "state", "size", "modifiers"],
    "full": ["to", "direction", "surface", "mode", "placement", "focus", "outcome"],
    "values": {
      "data": ["empty", "one", "many", "overflow", "wide-cjk", "long-cells"],
      "placement": ["page", "split", "modal", "under-palette"],
      "focus": ["focused", "unfocused"],
      "mode": ["normal", "insert", "visual", "filter", "pending-count", "pending-operator", "pending-prefix", "leader", "passthrough"],
      "state": ["plain", "filtered", "marked", "job-running", "stale-result", "restored-after-restart"],
      "size": ["tiny", "narrow", "normal", "wide"],
      "modifiers": ["none", "count", "register", "dot-repeat", "undo-redo", "in-macro"],
      "outcome": ["success", "guard-false", "error", "pending-lands", "cancelled", "owner-closed"],
      "direction": ["next", "previous"],
      "surface": ["footer", "help"]
    }
  },
  "modes": {
    "normal": "normal",
    "insert": "insert",
    "visual": "visual",
    "visual-block": "visual",
    "visual-column": "visual",
    "visual-line": "visual",
