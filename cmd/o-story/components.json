    "terminal": "passthrough"
  },
  "channels": {
    "key": ["mode", "placement", "focus", "outcome", "data", "state", "size", "modifiers"],
    "palette": ["placement", "focus", "outcome", "data", "state", "size"],
    "cli": ["outcome", "data", "state"],
    "parity": ["outcome"],
    "hosted": ["placement", "focus", "data", "size"],
    "spill": ["to", "direction", "placement"],
    "hints": ["surface", "mode"]
  },
  "exclude": [
    {"placement": "under-palette", "focus": "focused", "why": "the palette holds the focus while it is open"},
    {"focus": "unfocused", "mode": "insert", "why": "insert belongs to the focused input: a focus change resets the mode"},
    {"focus": "unfocused", "mode": "visual", "why": "a visual selection is the focused stop's; leaving the stop resets the mode"},
    {"focus": "unfocused", "mode": "filter", "why": "the filter line is the focused list's; leaving it resets the mode"},
    {"focus": "unfocused", "mode": "pending-count", "why": "a pending mode is entered at the focus and cancelled by a focus change"},
    {"focus": "unfocused", "mode": "pending-operator", "why": "a pending mode is entered at the focus and cancelled by a focus change"},
    {"focus": "unfocused", "mode": "pending-prefix", "why": "a pending mode is entered at the focus and cancelled by a focus change"},
    {"focus": "unfocused", "mode": "leader", "why": "the leader is pending on the focused terminal and cancelled by a focus change"},
    {"focus": "unfocused", "mode": "passthrough", "why": "passthrough is the focused terminal's pinned mode"},
    {"placement": "split", "direction": "previous", "to": "palette", "why": "nothing spills into the palette"}
  ],
