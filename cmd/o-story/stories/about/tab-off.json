{
  "name": "about.tab off: the Settings page has no About tab (] and [ stay among the owners) and about.open opens the About page on its own, with no tab row and no settings.tab hint; q goes back",
  "area": "about",
  "width": 100,
  "height": 30,
  "config": {"settings.json": {"about.tab": false}},
  "settings": [
    {"name": "editor", "type": "string", "default": "vi", "description": "The command that opens a file"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "bind": [
      {"noun": "demo", "keys": ",", "do": "settings.edit"},
      {"noun": "demo", "keys": "A", "do": "ochazuke.about.open"}
    ],
    "about": {
      "module": "github.com/unixsuperhero/demo",
      "version": "v1.2.3",
      "revision": "0123456789abcdef0123",
      "go": "go1.26.0",
      "pid": 4242,
      "started": "2026-10-31T09:00:00",
      "uptime": "5m"
    }
  },
  "script": [",", "[", "]", "q", "A", "q"],
  "expect": [
    {"after": 1, "page": "__settings", "lacks": ["About"]},
    {"after": 2, "page": "__settings"},
    {"after": 3, "page": "__settings"},
    {"after": 5, "page": "__about", "contains": ["github.com/unixsuperhero/demo", "4242", "5m0s"], "lacks": ["settings.tab", "› app"]},
    {"page": "page1", "focus": "a1"}
  ]
}
