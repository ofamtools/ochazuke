{
  "name": "catalog/row-target-empty-refuses",
  "page": {
    "id": "docs", "title": "Docs",
    "verbs": [{"verb": "demo.send", "parameters": {"target": {"type": "string"}}}],
    "bind": [{"noun": "lane", "keys": "g s", "do": "demo.send", "from": {"target": "row:doc"}}],
    "catalog": {
      "nouns": [{"name": "lane", "verbs": [{"name": "list", "rows": "lane"}]}],
      "page": {"lists": [{"id": "lanes", "noun": "lane"}]},
      "answers": {"lane.list": [
        {"id": "missing", "label": "unassociated", "data": {"doc": ""}},
        {"id": "ready", "label": "ready", "data": {"doc": "/fixture/report.md"}}
      ]}
    }
  },
  "script": ["g", "s", "j", "g", "s"],
  "expect": [
    {"after": 2, "contains": ["target", "doc", "lanes/missing"], "writes": []},
    {"writes": ["demo.send target=/fixture/report.md"], "focus": "lanes/ready"}
  ]
}
