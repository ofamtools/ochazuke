{
 "name": "create {from: row} copies the focused thing: every prop create writes, under a new key",
 "area": "verbs",
 "width": 100,
 "height": 24,
 "page": {
  "focus": "t1",
  "lists": [{"id": "parcels", "items": [
   {"id": "t1", "label": "Original", "noun": "parcel", "data": {"id": "t1"}}
  ]}],
  "bind": [
   {"noun": "parcel", "mode": "normal", "keys": "y p", "do": "parcel.create", "from": {"from": "row"}}
  ],
  "store": {
   "noun": "parcel",
   "props": [
    {"name": "id", "key": true},
    {"name": "title", "role": "label", "required": true},
    {"name": "status", "enum": ["todo", "done"]}
   ],
   "things": [
    {"id": "t1", "title": "Original", "status": "done"}
   ]
  }
 },
 "script": [
  "y",
  "p",
  ":",
  {"type": "parcel list"},
  "enter"
 ],
 "expect": [
  {"after": 2, "modal": "", "focus": "t1", "writes": ["get t1", "get t1", "create t2 title=Original status=done"]},
  {"modal": "palette-results", "order": ["t1", "Original", "done", "t2", "Original", "done"]}
 ]
}
