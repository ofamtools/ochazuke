{
 "name": "r with edit.field-only off: the full form opens with the label focused and selected",
 "area": "verbs",
 "width": 100,
 "height": 24,
 "values": {"edit.field-only": "false"},
 "page": {
  "focus": "t1",
  "lists": [{"id": "parcels", "items": [
   {"id": "t1", "label": "Original", "noun": "parcel", "data": {"id": "t1"}}
  ]}],
  "bind": [
   {"noun": "parcel", "mode": "normal", "keys": "r", "do": "parcel.edit", "args": {"field": "@label"}}
  ],
  "store": {
   "noun": "parcel",
   "props": [
    {"name": "id", "key": true},
    {"name": "status", "enum": ["todo", "done"]},
    {"name": "title", "role": "label", "required": true}
   ],
   "things": [
    {"id": "t1", "title": "Original", "status": "todo"}
   ]
  }
 },
 "script": [
  "r",
  {"type": "Renamed"},
  "esc",
  "esc",
  ":",
  {"type": "parcel get t1"},
  "enter"
 ],
 "expect": [
  {"after": 1, "modal": "edit-form", "mode": "insert", "contains": ["Edit parcel: Original", "status", "todo", "Original"]},
  {"after": 4, "modal": "", "focus": "t1", "mode": "normal"},
  {"modal": "palette-results", "contains": ["title", "Renamed", "todo"]}
 ]
}
