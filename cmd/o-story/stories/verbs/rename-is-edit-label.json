{
 "name": "r is edit {field: @label}: a one-field form opens on the old label, selected, and each change writes through set",
 "area": "verbs",
 "width": 100,
 "height": 24,
 "page": {
  "focus": "t1",
  "lists": [{"id": "parcels", "items": [
   {"id": "t1", "label": "Original", "noun": "parcel", "data": {"id": "t1"}},
   {"id": "t2", "label": "Second", "noun": "parcel", "data": {"id": "t2"}}
  ]}],
  "bind": [
   {"noun": "parcel", "mode": "normal", "keys": "r", "do": "parcel.edit", "args": {"field": "@label"}},
   {"noun": "parcel", "mode": "normal", "keys": "m", "do": "parcel.edit", "args": {"field": "@owner"}}
  ],
  "store": {
   "noun": "parcel",
   "props": [
    {"name": "id", "key": true},
    {"name": "title", "role": "label", "required": true},
    {"name": "status", "enum": ["todo", "done"]}
   ],
   "things": [
    {"id": "t1", "title": "Original", "status": "todo"},
    {"id": "t2", "title": "Second", "status": "done"}
   ]
  }
 },
 "script": [
  "r",
  {"type": "Renamed"},
  "esc", "q",
  "esc",
  "m",
  ":",
  {"type": "parcel get t1"},
  "enter"
 ],
 "expect": [
  {"after": 1, "modal": "edit-form", "mode": "insert", "contains": ["Edit parcel title: Original", "Original"], "lacks": ["status", "todo"]},
  {"after": 2, "modal": "edit-form", "contains": ["Renamed"], "lacks": ["RenamedOriginal", "OriginalRenamed"]},
  {"after": 5, "modal": "", "focus": "t1", "mode": "normal"},
  {"after": 6, "modal": "", "focus": "t1", "mode": "normal", "lacks": ["Edit parcel"]},
  {"modal": "palette-results", "contains": ["title", "Renamed", "todo"]}
 ]
}
