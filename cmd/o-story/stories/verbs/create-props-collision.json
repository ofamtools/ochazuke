{
 "name": "Create writes a declared from prop rather than copying a thing, and explicit props fill required fields",
 "area": "verbs",
 "width": 100,
 "height": 24,
 "page": {
  "focus": "t1",
  "lists": [{"id": "links", "items": [{"id": "t1", "label": "Original", "noun": "link", "data": {"id": "t1"}}]}],
  "store": {
   "noun": "link",
   "props": [
    {"name": "id", "key": true},
    {"name": "from", "noun": "*", "required": true},
    {"name": "to", "noun": "*", "required": true}
   ],
   "things": [{"id": "t1", "from": "project:old", "to": "task:old"}]
  }
 },
 "script": [
  ":", {"type": "link create from=project:x to=task:y"}, "enter",
  ":", {"type": "link create --props \"{\\\"from\\\":\\\"project:object\\\",\\\"to\\\":\\\"task:object\\\"}\""}, "enter",
  ":", {"type": "link create --create-from t1 --props \"{\\\"from\\\":\\\"project:copied\\\"}\""}, "enter",
  ":", {"type": "link list"}, "enter"
 ],
 "expect": [
  {"after": 3, "modal": "", "writes": ["create t2 from=project:x to=task:y"]},
  {"after": 6, "modal": "", "writes": ["create t2 from=project:x to=task:y", "create t3 from=project:object to=task:object"]},
  {"modal": "palette-results", "contains": ["project:x", "task:y", "project:object", "task:object", "project:copied", "task:old"]}
 ]
}
