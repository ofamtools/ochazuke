{
  "name": "completion: matching token text is marked, selection keeps bold alone",
  "area": "completion",
  "width": 56,
  "height": 12,
  "theme": "dark",
  "page": {
    "noHeadings": true,
    "inputs": [
      {
        "id": "prompt",
        "text": "",
        "completions": [
          {
            "trigger": "@",
            "items": [
              "src/main.go",
              "src/main_test.go"
            ]
          }
        ]
      }
    ]
  },
  "script": [
    "A",
    {
      "type": "@src/ma"
    },
    {
      "tick": "debounce"
    },
    {
      "job": "completion.search"
    },
    "ctrl+n"
  ],
  "expect": [
    {
      "after": 4,
      "attrs": {
        "src/main.go": "bold,-reverse,fg"
      }
    },
    {
      "attrs": {
        "src/main.go": "bold,reverse,-fg,-bg"
      }
    }
  ]
}
