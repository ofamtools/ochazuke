{
  "name": "mode badge: on the title row in every state, changed in the frame the mode changes: a prefix, a confirm, help, the palette, insert, visual, an operator (R2.10)",
  "area": "modes",
  "width": 80,
  "height": 12,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "inputs": [
      {
        "id": "name",
        "label": "name",
        "text": "hello"
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": "g x",
        "do": "demo.notify"
      }
    ]
  },
  "script": [
    "g",
    "esc",
    "x",
    "q",
    "?",
    "q",
    ":",
    "esc",
    "q",
    "j",
    "i",
    "esc",
    "v",
    "esc",
    "V",
    "esc",
    "d",
    "esc"
  ],
  "expect": [
    {
      "after": 1,
      "mode": "normal g",
      "badge": "NORMAL G"
    },
    {
      "after": 2,
      "mode": "normal",
      "badge": "NORMAL"
    },
    {
      "after": 3,
      "modal": "confirm",
      "badge": "NORMAL"
    },
    {
      "after": 4,
      "modal": "",
      "badge": "NORMAL"
    },
    {
      "after": 5,
      "modal": "bindings-help",
      "badge": "NORMAL"
    },
    {
      "after": 6,
      "modal": "",
      "badge": "NORMAL"
    },
    {
      "after": 7,
      "modal": "palette",
      "mode": "insert",
      "badge": "INSERT"
    },
    {
      "after": 8,
      "modal": "palette",
      "mode": "normal",
      "badge": "NORMAL"
    },
    {
      "after": 9,
      "modal": "",
      "mode": "normal",
      "badge": "NORMAL"
    },
    {
      "after": 10,
      "focus": "name",
      "mode": "normal",
      "badge": "NORMAL"
    },
    {
      "after": 11,
      "mode": "insert",
      "badge": "INSERT"
    },
    {
      "after": 12,
      "mode": "normal",
      "badge": "NORMAL"
    },
    {
      "after": 13,
      "mode": "visual",
      "badge": "VISUAL"
    },
    {
      "after": 14,
      "mode": "normal",
      "badge": "NORMAL",
      "focus": "name"
    },
    {
      "after": 15,
      "mode": "visual-line",
      "badge": "VISUAL-LINE"
    },
    {
      "after": 16,
      "mode": "normal",
      "badge": "NORMAL",
      "focus": "name"
    },
    {
      "after": 17,
      "mode": "operator_pending",
      "badge": "OPERATOR PENDING",
      "focus": "name"
    },
    {
      "mode": "normal",
      "badge": "NORMAL",
      "focus": "name"
    }
  ]
}
