{
  "name": "mode badge: a recording shows its register beside the mode and drops it when Q stops (R2.10)",
  "area": "modes",
  "width": 60,
  "height": 8,
  "page": {
    "inputs": [
      {
        "id": "name",
        "label": "name",
        "text": "hello"
      }
    ],
    "focus": "name"
  },
  "script": [
    "Q",
    "a",
    "i",
    "esc",
    "Q"
  ],
  "expect": [
    {
      "after": 1,
      "mode": "macro_pending",
      "badge": "MACRO PENDING",
      "focus": "name"
    },
    {
      "after": 2,
      "mode": "normal",
      "badge": "NORMAL · REC @a"
    },
    {
      "after": 3,
      "mode": "insert",
      "badge": "INSERT · REC @a"
    },
    {
      "after": 4,
      "mode": "normal",
      "badge": "NORMAL · REC @a"
    },
    {
      "mode": "normal",
      "badge": "NORMAL",
      "lacks": [
        "REC @a"
      ]
    }
  ]
}
