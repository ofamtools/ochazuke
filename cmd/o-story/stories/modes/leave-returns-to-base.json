{
  "name": "modes: leaving a pending mode returns to the base it shadowed, not to normal: on a list pinned to a custom base (table), a count and a g prefix each enter over table and esc (mode.leave) comes back to TABLE",
  "area": "modes",
  "width": 60,
  "height": 12,
  "page": {
    "modes": {"table": {"extends": "normal"}},
    "lists": [{"id": "data", "rows": 4, "pin": "table"}],
    "focus": "data1"
  },
  "script": ["2", "esc", "g", "esc", "j"],
  "expect": [
    {"after": 1, "focus": "data1", "mode": "count_pending", "badge": "COUNT PENDING"},
    {"after": 2, "focus": "data1", "mode": "table", "badge": "TABLE"},
    {"after": 3, "focus": "data1", "mode": "table g"},
    {"after": 4, "focus": "data1", "mode": "table", "badge": "TABLE"},
    {"focus": "data2", "mode": "table", "badge": "TABLE"}
  ]
}
