{
  "name": "the palette names an associated subject before acting and returns to the live terminal",
  "area": "focus",
  "page": {
    "lists": [
      {
        "id": "a",
        "items": [
          {
            "id": "a1",
            "noun": "item",
            "label": "Build",
            "data": {
              "id": "a1",
              "title": "Build"
            }
          }
        ]
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1",
      "data": {
        "subject": "a1"
      }
    },
    "nouns": [
      {
        "noun": "terminal",
        "props": [
          {
            "name": "subject",
            "noun": "item",
            "readOnly": true,
            "association": true
          }
        ]
      }
    ],
    "verbs": [
      {
        "verb": "item.rename-associated",
        "byAssociation": true,
        "row": true,
        "parameters": {
          "name": {
            "type": "string",
            "required": true
          }
        }
      }
    ],
    "bind": [
      {
        "noun": "terminal",
        "mode": "leader_pending",
        "keys": "r",
        "do": "item.rename-associated"
      },
      {
        "noun": "item",
        "mode": "normal",
        "keys": "enter",
        "do": "demo.open"
      },
      {
        "noun": "terminal",
        "mode": "leader_pending",
        "keys": ":",
        "do": "ochazuke.palette.open"
      }
    ]
  },
  "script": [
    "enter",
    "ctrl+a",
    ":",
    {
      "type": "item rename-associated "
    },
    {
      "type": "New"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 4,
      "contains": [
        "acts on: Build"
      ],
      "writes": []
    },
    {
      "focus": "page1-pane",
      "mode": "terminal",
      "modal": "",
      "writes": [
        "item.rename-associated name=New row=a1"
      ]
    }
  ],
  "width": 120
}
