{
  "name": "a declared association lets a live terminal's key act on its row, without moving focus",
  "area": "focus",
  "page": {
    "lists": [{"id": "a", "items": [{"id": "a1", "noun": "item", "label": "Build", "data": {"id": "a1", "title": "Build"}}]}],
    "terminal": {"fake": true, "attach": "a1", "data": {"subject": "a1"}},
    "nouns": [{"noun": "terminal", "props": [{"name": "subject", "noun": "item", "readOnly": true, "association": true}]}],
    "verbs": [{"verb": "item.rename-associated", "byAssociation": true, "row": true}],
    "bind": [{"noun": "terminal", "mode": "leader_pending", "keys": "r", "do": "item.rename-associated"}, {"noun": "item", "mode": "normal", "keys": "enter", "do": "demo.open"}]
  },
  "script": ["enter", "ctrl+a", "r"],
  "expect": [
    {"after": 1, "focus": "page1-pane", "mode": "terminal", "writes": []},
    {"after": 2, "mode": "leader_pending", "writes": []},
    {"focus": "page1-pane", "mode": "terminal", "writes": ["item.rename-associated row=a1"], "contains": ["item Build (from the focus)"]}
  ]
}
