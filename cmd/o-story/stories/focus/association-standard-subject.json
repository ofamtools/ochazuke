{
  "name": "a standard set of the label (set {props: {@label}}) subject follows the terminal association and writes only that record",
  "area": "focus",
  "page": {
    "lists": [
      {
        "id": "a",
        "items": [
          {
            "id": "a1",
            "noun": "item",
            "label": "Build",
            "data": {
              "id": "a1",
              "title": "Build"
            }
          }
        ]
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1",
      "data": {
        "subject": "a1"
      }
    },
    "nouns": [
      {
        "noun": "terminal",
        "props": [
          {
            "name": "subject",
            "noun": "item",
            "readOnly": true,
            "association": true
          }
        ]
      }
    ],
    "bind": [
      {
        "noun": "terminal",
        "mode": "leader_pending",
        "keys": "r",
        "do": "item.set",
        "args": {
          "props": {"@label": "Renamed"}
        }
      },
      {
        "noun": "item",
        "mode": "normal",
        "keys": "enter",
        "do": "demo.open"
      }
    ],
    "store": {
      "noun": "item",
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label"
        }
      ],
      "things": [
        {
          "id": "a1",
          "title": "Build"
        }
      ]
    }
  },
  "script": [
    "enter",
    "ctrl+a",
    "r"
  ],
  "expect": [
    {
      "after": 1,
      "writes": [],
      "mode": "terminal"
    },
    {
      "after": 2,
      "writes": [],
      "mode": "leader_pending"
    },
    {
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": [
        "set a1 title=Renamed"
      ]
    }
  ]
}
