{
  "name": "a live outside rename edits its associated thing rather than another selected row and its form returns to terminal mode",
  "area": "terminal",
  "page": {
    "lists": [
      {
        "id": "a",
        "items": [
          {
            "id": "a1",
            "noun": "item",
            "label": "Build",
            "data": {
              "id": "a1",
              "title": "Build"
            }
          },
          {
            "id": "a2",
            "noun": "item",
            "label": "Other",
            "data": {
              "id": "a2",
              "title": "Other"
            }
          }
        ]
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1",
      "data": {
        "subject": "a1"
      }
    },
    "nouns": [
      {
        "noun": "terminal",
        "props": [
          {
            "name": "subject",
            "noun": "item",
            "readOnly": true,
            "association": true
          }
        ]
      }
    ],
    "bind": [
      {
        "noun": "item",
        "mode": "normal",
        "keys": "r",
        "do": "item.rename"
      },
      {
        "noun": "item",
        "mode": "normal",
        "keys": "enter",
        "do": "demo.open"
      },
      {
        "noun": "terminal",
        "mode": "leader_pending",
        "keys": "s",
        "do": "ochazuke.list.select",
        "args": {
          "id": "a",
          "item": "a2"
        }
      }
    ],
    "store": {
      "noun": "item",
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label"
        }
      ],
      "things": [
        {
          "id": "a1",
          "title": "Build"
        },
        {
          "id": "a2",
          "title": "Other"
        }
      ]
    }
  },
  "script": [
    "enter",
    "ctrl+a",
    "s",
    "ctrl+a",
    "r",
    {
      "type": "Renamed"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 1,
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": []
    },
    {
      "after": 2,
      "mode": "leader_pending",
      "writes": []
    },
    {
      "after": 3,
      "focus": "page1-pane",
      "mode": "terminal",
      "selected": {
        "a": "a2"
      },
      "writes": []
    },
    {
      "after": 4,
      "mode": "leader_pending",
      "writes": []
    },
    {
      "after": 5,
      "modal": "args-form",
      "focus": "args-form/name",
      "mode": "insert",
      "contains": [
        "Build"
      ],
      "writes": [
        "get a1"
      ],
      "selected": {
        "a": "a2"
      }
    },
    {
      "after": 6,
      "modal": "args-form",
      "writes": [
        "get a1"
      ]
    },
    {
      "modal": "",
      "focus": "page1-pane",
      "mode": "terminal",
      "selected": {
        "a": "a2"
      },
      "writes": [
        "get a1",
        "set a1 title=Renamed"
      ]
    }
  ]
}
