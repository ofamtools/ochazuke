{
  "name": "sequence-timeout 1s: ctrl+a left alone past it sends ctrl+a alone; the next key starts fresh",
  "area": "terminal",
  "settings": [
    {
      "name": "sequence-timeout",
      "type": "duration",
      "default": "1s"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 3
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1"
    }
  },
  "script": [
    "enter",
    {
      "tick": "terminal"
    },
    "ctrl+a",
    {
      "tick": "binding"
    },
    {
      "tick": "terminal"
    },
    "d",
    {
      "tick": "terminal"
    }
  ],
  "expect": {
    "focus": "page1-pane",
    "mode": "terminal",
    "contains": [
      "<ctrl+a>d",
      "pane (attached: ctrl+a d detaches)"
    ]
  }
}
