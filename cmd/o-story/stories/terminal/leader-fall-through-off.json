{
  "name": "leader.fall-through off sends an outside key to the program and runs no verb",
  "area": "terminal",
  "page": {
    "lists": [
      {
        "id": "a",
        "items": [
          {
            "id": "a1",
            "noun": "item",
            "label": "Build",
            "data": {
              "id": "a1",
              "title": "Build"
            }
          }
        ]
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1",
      "data": {
        "subject": "a1"
      }
    },
    "nouns": [
      {
        "noun": "terminal",
        "props": [
          {
            "name": "subject",
            "noun": "item",
            "readOnly": true,
            "association": true
          }
        ]
      }
    ],
    "verbs": [
      {
        "verb": "item.rename-associated",
        "byAssociation": true,
        "row": true
      }
    ],
    "bind": [
      {
        "noun": "item",
        "mode": "normal",
        "keys": "r",
        "do": "item.rename-associated"
      },
      {
        "noun": "item",
        "mode": "normal",
        "keys": "enter",
        "do": "demo.open"
      }
    ]
  },
  "script": [
    "enter",
    {"tick": "terminal"},
    "ctrl+a",
    "r",
    {
      "tick": "terminal"
    },
    {
      "tick": "terminal"
    }
  ],
  "expect": [
    {
      "after": 1,
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": []
    },
    {
      "after": 3,
      "mode": "leader_pending",
      "writes": []
    },
    {
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": [],
      "contains": [
        "<ctrl+a>r"
      ]
    }
  ],
  "settings": [
    {
      "name": "leader.fall-through",
      "type": "string",
      "default": "off"
    }
  ]
}
