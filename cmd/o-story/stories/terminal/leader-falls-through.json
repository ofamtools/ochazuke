{
  "name": "an unbound leader key falls through to an outside page row without an association",
  "area": "terminal",
  "page": {
    "lists": [
      {
        "id": "a",
        "items": [
          {
            "id": "a1",
            "noun": "item",
            "label": "Build",
            "data": {
              "id": "a1",
              "title": "Build"
            }
          }
        ]
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1"
    },
    "verbs": [
      {
        "verb": "demo.outside",
        "row": true
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "mode": "normal",
        "keys": "r",
        "do": "demo.outside"
      },
      {
        "noun": "item",
        "mode": "normal",
        "keys": "enter",
        "do": "demo.open"
      }
    ]
  },
  "script": [
    "enter",
    "ctrl+a",
    "r"
  ],
  "expect": [
    {
      "after": 1,
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": []
    },
    {
      "after": 2,
      "mode": "leader_pending",
      "writes": []
    },
    {
      "focus": "page1-pane",
      "mode": "terminal",
      "writes": [
        "demo.outside row=page1"
      ]
    }
  ]
}
