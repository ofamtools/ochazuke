{
  "name": "directory picker, style hybrid: Recent and Browse are sections; ] and [ jump between them and a heading never takes the highlight",
  "area": "picker",
  "width": 160,
  "height": 22,
  "files": [
    "a.json",
    "b.txt",
    ".hidden",
    "sub/c.json",
    "sub/deep/",
    "proj/matomeru/cmd/",
    "proj/ochazuke/",
    "empty/"
  ],
  "values": {
    "pickers.directory.style": "hybrid"
  },
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": "dir"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    "j",
    "l",
    {
      "job": "picker.load"
    },
    "u",
    "enter",
    {
      "job": "picker.load"
    },
    "]",
    "[",
    "j"
  ],
  "expect": [
    {
      "after": 8,
      "modal": "path-chooser",
      "contains": [
        "Recent",
        "Browse "
      ],
      "highlightedText": "/proj"
    },
    {
      "after": 9,
      "highlightedText": "matomeru/"
    },
    {
      "after": 10,
      "highlightedText": "/proj"
    },
    {
      "modal": "path-chooser",
      "highlightedText": "matomeru/"
    }
  ]
}