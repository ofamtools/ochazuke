{
  "name": "path chooser: a query written as a path (/x) answers as the typed source at once, no ctrl+o; enter on a missing one says why (R7.8)",
  "area": "picker",
  "width": 100,
  "height": 18,
  "files": [
    "a.json"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    {
      "type": "/nonexistent-dir/x.json"
    },
    {
      "job": "picker.load"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 4,
      "contains": [
        "browse recent [typed]",
        "/nonexistent-dir/x.json",
        "/nonexistent-dir does not exist"
      ],
      "lacks": [
        "type a path"
      ]
    },
    {
      "modal": "path-chooser",
      "contains": [
        "/nonexistent-dir does not exist"
      ],
      "lacks": [
        "nothing matches"
      ],
      "writes": []
    }
  ]
}