{
  "name": "directory picker, style list: a file pick goes into folders with enter and picks a file",
  "area": "picker",
  "width": 110,
  "height": 22,
  "files": [
    "a.json",
    "b.txt",
    ".hidden",
    "sub/c.json",
    "sub/deep/",
    "proj/matomeru/cmd/",
    "proj/ochazuke/",
    "empty/"
  ],
  "values": {
    "pickers.directory.style": "list"
  },
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": ""
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    "down",
    "down",
    "enter",
    {
      "job": "picker.load"
    },
    "down",
    "enter"
  ],
  "expect": [
    {
      "after": 5,
      "modal": "path-chooser"
    },
    {
      "modal": "",
      "contains": [
        "c.json"
      ]
    }
  ]
}