{
  "name": "directory picker, style hybrid: hidden files show and hide with the toggle",
  "area": "picker",
  "width": 110,
  "height": 22,
  "files": [
    "a.json",
    "b.txt",
    ".hidden",
    "sub/c.json",
    "sub/deep/",
    "proj/matomeru/cmd/",
    "proj/ochazuke/",
    "empty/"
  ],
  "values": {
    "pickers.directory.style": "hybrid"
  },
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": "any"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    ".",
    {
      "job": "picker.load"
    },
    ".",
    {
      "job": "picker.load"
    }
  ],
  "expect": [
    {
      "after": 2,
      "modal": "path-chooser",
      "lacks": [
        ".hidden"
      ]
    },
    {
      "after": 4,
      "contains": [
        ".hidden"
      ]
    },
    {
      "modal": "path-chooser",
      "lacks": [
        ".hidden"
      ]
    }
  ]
}