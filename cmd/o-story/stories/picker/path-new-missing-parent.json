{
  "name": "path chooser: a new folder pick offers \"new\" whatever its missing parent (record first, never refuse)",
  "area": "picker",
  "width": 100,
  "height": 18,
  "files": [
    "sub/"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": "dir",
            "new": true
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    {
      "type": "/nonexistent/deep/x"
    },
    {
      "job": "picker.load"
    }
  ],
  "expect": [
    {
      "contains": [
        "new /nonexistent/deep/x"
      ],
      "lacks": [
        "does not exist"
      ]
    }
  ]
}