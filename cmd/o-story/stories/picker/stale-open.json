{
  "name": "path chooser: stale open",
  "area": "picker",
  "width": 100,
  "height": 18,
  "files": [
    "sub/"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": "dir",
            "new": true
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    {
      "type": "./su"
    },
    {
      "job": "picker.load"
    },
    {
      "type": "x"
    },
    "enter",
    {
      "job": "picker.load"
    }
  ],
  "expect": [
    {
      "lacks": [
        "\u203a ./sub/"
      ],
      "modal": "",
      "writes": [
        "write file={{files}}/sux"
      ]
    }
  ]
}