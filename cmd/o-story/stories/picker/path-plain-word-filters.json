{
  "name": "path chooser: a plain word keeps filtering the browse list; the typed source is not claimed",
  "area": "picker",
  "width": 100,
  "height": 18,
  "files": [
    "a.json"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    },
    {
      "type": "a"
    }
  ],
  "expect": [
    {
      "contains": [
        "[browse",
        "a.json"
      ],
      "lacks": [
        "[typed]"
      ]
    }
  ]
}