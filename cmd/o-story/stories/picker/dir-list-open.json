{
  "name": "directory picker, style list: opens on the folder, the first row full-width highlighted",
  "area": "picker",
  "width": 110,
  "height": 22,
  "files": [
    "a.json",
    "b.txt",
    ".hidden",
    "sub/c.json",
    "sub/deep/",
    "proj/matomeru/cmd/",
    "proj/ochazuke/",
    "empty/"
  ],
  "values": {
    "pickers.directory.style": "list"
  },
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}",
            "path": "dir"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "picker.load"
    }
  ],
  "expect": [
    {
      "modal": "path-chooser",
      "mode": "insert",
      "contains": [
        "Choose file",
        "sub/",
        "empty/",
        "use "
      ],
      "highlightedText": "empty/"
    }
  ]
}