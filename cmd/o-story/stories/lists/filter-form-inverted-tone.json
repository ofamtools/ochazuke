{
  "name": "filter form: inverted fields use the record inverted tone for labels and chip values",
  "area": "lists",
  "width": 80,
  "height": 20,
  "theme": "dark",
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "nouns": [
      {
        "noun": "task",
        "props": [
          {
            "name": "status",
            "enum": [
              "closed",
              "open"
            ]
          }
        ]
      }
    ],
    "lists": [
      {
        "id": "tasks",
        "height": -1,
        "items": [
          {
            "id": "t1",
            "label": "First task",
            "noun": "task",
            "data": {
              "status": "closed"
            }
          },
          {
            "id": "t2",
            "label": "Second task",
            "noun": "task",
            "data": {
              "status": "open"
            }
          }
        ]
      }
    ]
  },
  "script": [
    "z",
    "/",
    "space",
    "!"
  ],
  "expect": [
    {
      "after": 4,
      "contains": [
        "status \u00b7 not",
        "\u25cf closed",
        "\u25cb open"
      ],
      "styled": {
        "status \u00b7 not": "#FF9B70",
        " \u25cf closed ": "#FF9B70",
        " \u25cb open ": "#FF9B70"
      }
    }
  ],
  "values": {
    "list.filter-layout": "fields",
    "list.filter-sort": false
  }
}
