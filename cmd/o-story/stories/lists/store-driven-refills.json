{
  "name": "a list from the store: create, set, archive and delete through the standard verbs fill the list again with no rows written by the page; the selection stays on its row, an archived thing leaves the view",
  "area": "lists",
  "width": 100,
  "height": 14,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "lists": [
      {"id": "tasks", "from": true, "height": -1}
    ],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label", "type": "string"},
        {"name": "archived", "type": "boolean", "role": "archive"}
      ],
      "things": [
        {"id": "t1", "title": "Water the plants", "archived": false},
        {"id": "t2", "title": "Write notes", "archived": false},
        {"id": "t3", "title": "Call the plumber", "archived": false}
      ]
    },
    "bind": [
      {"noun": "demo", "keys": "N", "do": "demo.create", "args": {"title": "Fresh task"}},
      {"noun": "demo", "keys": "R", "do": "demo.set", "args": {"prop": "title", "value": "Renamed task"}},
      {"noun": "demo", "keys": "A", "do": "demo.archive"},
      {"noun": "demo", "keys": "X", "do": "demo.delete"}
    ]
  },
  "script": ["j", "R", "N", "A", "k", "X", "y"],
  "expect": [
    {"after": 1, "contains": ["Water the plants", "Write notes", "Call the plumber"]},
    {"after": 2, "contains": ["Water the plants", "Renamed task", "Call the plumber"], "lacks": ["Write notes"]},
    {"after": 3, "contains": ["Fresh task", "Renamed task"]},
    {"after": 4, "contains": ["Water the plants", "Fresh task", "Call the plumber"], "lacks": ["Renamed task"]},
    {"modal": "", "contains": ["Fresh task", "Call the plumber"], "lacks": ["Water the plants", "Renamed task"]}
  ]
}
