{
  "name": "list filter: marks on hidden rows survive the filter; the gutter and marks come back with the rows",
  "area": "lists",
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 5,
        "labels": [
          "alpha",
          "beta",
          "gamma",
          "alphabet",
          "delta"
        ],
        "marked": [
          1,
          3
        ]
      },
      {
        "id": "b",
        "rows": 2
      }
    ]
  },
  "script": [
    "/",
    "l",
    "enter",
    "esc"
  ],
  "expect": [
    {
      "after": 3,
      "mode": "normal",
      "contains": [
        "* alphabet",
        "  alpha",
        "  delta"
      ],
      "lacks": [
        "beta"
      ]
    },
    {
      "after": 4,
      "contains": [
        "* beta",
        "* alphabet",
        "  gamma"
      ]
    }
  ]
}
