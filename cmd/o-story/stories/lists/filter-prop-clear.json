{
  "width": 100,
  "height": 16,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "nouns": [
      {
        "noun": "note",
        "props": [
          {
            "name": "by"
          },
          {
            "name": "status"
          }
        ],
        "filters": [
          {
            "name": "mine",
            "where": {
              "by": "owner"
            }
          },
          {
            "name": "agents",
            "where": {
              "by": "agent"
            }
          },
          {
            "name": "all"
          }
        ]
      }
    ],
    "lists": [
      {
        "id": "notes",
        "height": -1,
        "items": [
          {
            "id": "n1",
            "label": "Owner alpha",
            "noun": "note",
            "data": {
              "by": "owner",
              "status": "todo"
            }
          },
          {
            "id": "n2",
            "label": "Agent beta",
            "noun": "note",
            "data": {
              "by": "agent",
              "status": "todo"
            }
          },
          {
            "id": "n3",
            "label": "Owner gamma",
            "noun": "note",
            "data": {
              "by": "owner",
              "status": "done"
            }
          }
        ]
      }
    ],
    "bind": [
      {
        "noun": "note",
        "keys": "f",
        "do": "ochazuke.list.filter-prop",
        "args": {
          "prop": "by",
          "value": "owner"
        }
      },
      {
        "noun": "note",
        "keys": "s",
        "do": "ochazuke.list.filter-prop",
        "args": {
          "prop": "status",
          "value": "todo"
        }
      }
    ]
  },
  "name": "prop filters: AND conditions, clear one then all",
  "script": [
    "f",
    "s",
    "z",
    "!",
    "enter",
    "z",
    "C"
  ],
  "expect": [
    {
      "after": 2,
      "contains": [
        "[by = owner]",
        "[status = todo]",
        "Owner alpha"
      ],
      "lacks": [
        "Owner gamma",
        "Agent beta"
      ]
    },
    {
      "after": 5,
      "contains": [
        "[status = todo]",
        "Owner alpha",
        "Agent beta"
      ],
      "lacks": [
        "Owner gamma",
        "[by = owner]"
      ]
    },
    {
      "after": 7,
      "contains": [
        "Owner alpha",
        "Agent beta",
        "Owner gamma"
      ],
      "lacks": [
        "[status = todo]"
      ]
    }
  ],
  "area": "lists"
}
