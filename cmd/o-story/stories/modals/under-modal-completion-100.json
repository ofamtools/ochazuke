{
  "name": "presentation at 100 columns: open suggestions belong to the live focus: help opened over a prompt with its suggestions showing draws the prompt beneath (its text kept) and no suggestion list over the modal (MO-10)",
  "area": "modals",
  "width": 100,
  "height": 14,
  "page": {
    "noHeadings": true,
    "inputs": [
      {
        "id": "prompt",
        "label": "prompt",
        "text": "",
        "completions": [{"trigger": "@", "items": ["src/main.go", "src/main_test.go", "src/model.go", "README.md"]}]
      }
    ],
    "bind": [{"noun": "app", "mode": "insert", "keys": "ctrl+g", "do": "ochazuke.bindings.help"}]
  },
  "script": ["A", {"type": "review @src/m"}, {"tick": "debounce"}, {"job": "completion.search"}, "ctrl+g"]
}
