{
  "name": "nested modals: each surface keeps the state saved above it: a VISUAL-LINE selection under help stays drawn (both rows marked, the cursor row dimmed) while the palette opens over help; esc closes the palette back into help in normal, esc again returns to VISUAL-LINE on the same rows",
  "area": "modals",
  "width": 100,
  "height": 30,
  "page": {"lists": [{"id": "a", "rows": 4}], "focus": "a2"},
  "script": ["V", "j", "?", ":", "esc", "esc"],
  "expect": [
    {"after": 2, "modal": "", "mode": "visual-line", "focus": "a3", "highlighted": 1, "highlightedText": "a3", "contains": ["* a2", "* a3"]},
    {"after": 3, "modal": "bindings-help", "mode": "normal", "dimmed": 1, "contains": ["* a2", "* a3"]},
    {"after": 4, "modal": "palette", "dimmed": 1, "contains": ["* a2", "* a3"]},
    {"after": 5, "modal": "bindings-help", "mode": "normal", "dimmed": 1, "contains": ["* a2", "* a3"]},
    {"modal": "", "mode": "visual-line", "focus": "a3", "badge": "VISUAL-LINE", "highlighted": 1, "highlightedText": "a3", "contains": ["* a2", "* a3"]}
  ]
}
