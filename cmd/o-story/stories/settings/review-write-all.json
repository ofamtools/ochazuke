{
  "name": "settings review: W writes every session value, the list empties and the review closes saying so",
  "area": "settings",
  "theme": "dark",
  "width": 80,
  "settings": [
    {"name": "stack", "type": "string", "default": "tabs", "enum": ["tabs", "stack", "grid"], "description": "How panes are laid out"},
    {"name": "editor", "type": "string", "default": "vi", "description": "The command that opens a file"}
  ],
  "values": {"stack": "grid"},
  "session": {"stack": "stack", "editor": "nvim"},
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "bind": [{"noun": "demo", "keys": ",", "do": "settings.review"}]
  },
  "script": [",", "W"],
  "expect": [
    {"modal": "", "focus": "a1", "contains": ["No session changes left to review"]}
  ]
}
