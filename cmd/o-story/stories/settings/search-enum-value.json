{
  "name": "settings page: / in the section list matches a setting by a choice it does not hold (an enum value): solarized keeps General, whose pane shows only theme",
  "area": "settings",
  "width": 100,
  "height": 30,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Rows kept above and below the focus"
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "solarized"
      ]
    },
    {
      "name": "tab-width",
      "type": "integer",
      "default": 4,
      "description": "Columns per tab"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "script": [
    ",",
    "k",
    "/",
    "s",
    "o",
    "l",
    "a",
    "r",
    "i",
    "z",
    "e",
    "d",
    "enter",
    "l"
  ],
  "expect": [
    {
      "after": 12,
      "mode": "list_filter",
      "focus": "__settings/section/app/general",
      "contains": [
        "/solarized",
        "General",
        "theme",
        "‹ dark ›",
        "1 of 3"
      ],
      "lacks": [
        "scrolloff",
        "tab-width",
        "Choosers",
        "no matches"
      ]
    },
    {
      "mode": "normal",
      "focus": "__settings/row/theme",
      "contains": [
        "Colour theme"
      ],
      "page": "__settings"
    }
  ]
}
