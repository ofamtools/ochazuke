{
  "name": "settings page: / filters the shown section's rows; enter keeps, esc clears",
  "area": "settings",
  "width": 80,
  "height": 30,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Margin rows around a cursor"
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "mono"
      ]
    },
    {
      "name": "ext.ai.poll-every",
      "owner": "extensions",
      "section": "ai",
      "type": "duration",
      "default": "30s",
      "description": "How often the AI extension refreshes its rows"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    },
    {
      "name": "tab-width",
      "type": "integer",
      "default": 4,
      "description": "Columns per tab"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "script": [
    ",",
    "/",
    "t",
    "h",
    "enter",
    "j",
    "esc",
    "/",
    "z",
    "backspace",
    "backspace"
  ],
  "expect": [
    {
      "after": 2,
      "mode": "list_filter",
      "focus": "__settings/row/scrolloff",
      "contains": [
        "enter list.filter-keep",
        "scrolloff",
        "theme",
        "tab-width"
      ],
      "lacks": [
        "1–"
      ]
    },
    {
      "after": 4,
      "mode": "list_filter",
      "focus": "__settings/row/theme",
      "contains": [
        "/th",
        "2 of 3",
        "theme",
        "tab-width"
      ],
      "lacks": [
        "scrolloff"
      ]
    },
    {
      "after": 5,
      "mode": "normal",
      "focus": "__settings/row/theme",
      "contains": [
        "/th",
        "2 of 3"
      ]
    },
    {
      "after": 6,
      "focus": "__settings/row/tab-width",
      "contains": [
        "Columns per tab"
      ]
    },
    {
      "after": 7,
      "mode": "normal",
      "focus": "__settings/row/tab-width",
      "contains": [
        "scrolloff",
        "theme",
        "tab-width"
      ],
      "lacks": [
        "/th"
      ]
    },
    {
      "after": 9,
      "mode": "list_filter",
      "contains": [
        "/z",
        "no matches"
      ]
    },
    {
      "after": 11,
      "mode": "normal",
      "focus": "__settings/row/tab-width",
      "page": "__settings",
      "lacks": [
        "/z"
      ]
    }
  ]
}
