{
  "name": "settings page: u (or ctrl+z) takes back the page's last change and shows its row; u answers and is offered only with a change to undo",
  "area": "settings",
  "width": 120,
  "settings": [
    {"name": "scrolloff", "type": "integer", "default": 2, "description": "Rows kept above and below the focus"},
    {"name": "ext.git.fetch", "type": "boolean", "default": true, "description": "Fetch before listing branches"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "bind": [{"noun": "demo", "keys": "S", "do": "settings.edit"}]
  },
  "script": ["S", "l", "l", "tab", "space", "u", "ctrl+z", "u", "u"],
  "expect": [
    {"after": 1, "lacks": ["settings.undo"]},
    {"after": 3, "contains": ["scrolloff •  ‹ 4 ›", "u settings.undo"]},
    {"after": 5, "focus": "__settings/row/ext.git.fetch", "contains": ["fetch •  ‹ false ›"]},
    {"after": 6, "focus": "__settings/row/ext.git.fetch", "contains": ["fetch    ‹ true ›"], "lacks": ["•"]},
    {"after": 7, "focus": "__settings/row/scrolloff", "contains": ["› General", "scrolloff •  ‹ 3 ›"]},
    {"after": 8, "focus": "__settings/row/scrolloff", "contains": ["scrolloff    ‹ 2 ›", "Not in settings.json"], "lacks": ["settings.undo", "•"]},
    {"focus": "__settings/row/scrolloff", "contains": ["scrolloff    ‹ 2 ›"], "lacks": ["settings.undo", "undo"]}
  ]
}
