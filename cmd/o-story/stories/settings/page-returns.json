{
  "name": "settings page: q goes back to the page it came from, its focus and mode kept",
  "area": "settings",
  "settings": [
    {"name": "wrap", "type": "boolean", "default": false, "description": "Wrap long lines"}
  ],
  "pages": [
    {"id": "one", "title": "One", "lists": [{"id": "a", "rows": 2}]},
    {"id": "two", "title": "Two", "lists": [{"id": "b", "rows": 3}], "inputs": [{"id": "name", "label": "name", "text": "hello"}],
     "bind": [{"noun": "demo", "mode": "insert", "keys": "ctrl+o", "do": "settings.edit"}]}
  ],
  "script": ["ctrl+j", "j", "j", "j", "i", "ctrl+o", "space", "q", "ctrl+o", "esc"],
  "expect": [
    {"after": 5, "page": "two", "focus": "name", "mode": "insert"},
    {"after": 6, "page": "__settings", "focus": "__settings/row/wrap", "mode": "normal", "contains": ["One", "Two", "Settings"]},
    {"after": 7, "contains": ["wrap     true"]},
    {"after": 8, "page": "two", "focus": "name", "mode": "insert", "lacks": ["Settings", "Sections"]},
    {"after": 9, "page": "__settings"},
    {"page": "two", "focus": "name", "mode": "insert"}
  ]
}
