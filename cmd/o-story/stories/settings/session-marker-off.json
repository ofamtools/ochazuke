    "lists": [{"id": "a", "rows": 1}],
    "bind": [{"noun": "demo", "keys": ",", "do": "settings.edit"}]
  },
  "script": [","],
  "expect": [
    {"contains": ["stack •  ‹ stack ›"], "lacks": ["(saved:", "◦"]}
  ]
}
