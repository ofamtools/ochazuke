{
  "name": "settings page: settings.mark-session off draws a session value as any other, no bold and no saved value",
  "area": "settings",
  "width": 80,
  "theme": "dark",
  "settings": [
    {"name": "stack", "type": "string", "default": "tabs", "enum": ["tabs", "stack", "grid"], "description": "How panes are laid out"}
