{
  "name": "settings page: / in the section list searches every setting of every tab (name, description, value, default, choices): typing path keeps the sections holding path settings under their owner, the settings pane shows the shown section's matches, esc restores the page on the section it was on",
  "area": "settings",
  "width": 100,
  "height": 30,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Rows kept above and below the focus"
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "solarized"
      ]
    },
    {
      "name": "tab-width",
      "type": "integer",
      "default": 4,
      "description": "Columns per tab"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "script": [
    ",",
    "k",
    "/",
    "p",
    "a",
    "t",
    "h",
    "down",
    "down",
    "down",
    "esc"
  ],
  "expect": [
    {
      "after": 2,
      "focus": "__settings/section/app/general"
    },
    {
      "after": 5,
      "mode": "list_filter",
      "contains": [
        "/pa",
        "ochazuke",
        "Appearance"
      ],
      "lacks": [
        "no matches",
        "no settings match",
        "scrolloff"
      ]
    },
    {
      "after": 7,
      "mode": "list_filter",
      "focus": "__settings/section/ochazuke/appearance",
      "order": [
        "/path",
        "ochazuke",
        "Appearance",
        "Choosers"
      ],
      "contains": [
        "› ochazuke",
        "1 of 12",
        "focus-display"
      ],
      "lacks": [
        "no matches",
        "General",
        "scrolloff",
        "modal-dim"
      ]
    },
    {
      "after": 10,
      "mode": "list_filter",
      "focus": "__settings/section/ochazuke/choosers",
      "contains": [
        "Choosers (14)",
        "path.start",
        "path.hidden",
        "path.no-auto-list"
      ],
      "lacks": [
        "focus-display"
      ]
    },
    {
      "mode": "normal",
      "focus": "__settings/section/app/general",
      "page": "__settings",
      "contains": [
        "› app",
        "General",
        "scrolloff",
        "theme",
        "tab-width"
      ],
      "lacks": [
        "/path",
        "Choosers",
        "path.start"
      ]
    }
  ]
}
