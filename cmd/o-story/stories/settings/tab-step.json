{
  "name": "settings page: tab and shift+tab walk every section in drawing order across the tabs (wrapping); ] and [ (and g t, g T) step the tabs, each reopening on the section it last showed",
  "area": "settings",
  "width": 100,
  "settings": [
    {"name": "scrolloff", "type": "integer", "default": 2, "description": "Rows kept above and below the focus"},
    {"name": "panes.group", "type": "string", "default": "project", "enum": ["project", "flat"], "description": "How panes group"},
    {"name": "panes.percent", "type": "integer", "default": 25, "description": "The queue's share of the height"},
    {"name": "ext.ai.model", "owner": "extensions", "section": "ai", "type": "string", "default": "large", "enum": ["small", "large"], "description": "Model the AI extension asks"},
    {"name": "ext.git.fetch", "owner": "extensions", "section": "git", "type": "boolean", "default": true, "description": "Fetch before listing branches"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "bind": [{"noun": "demo", "keys": ",", "do": "settings.edit"}]
  },
  "script": [",", "tab", "tab", "tab", "tab", "shift+tab", "shift+tab", "shift+tab", "[", "]", "]", "g", "t", "g", "T", "shift+tab"],
  "expect": [
    {"after": 1, "focus": "__settings/row/scrolloff", "order": ["› app", "extensions", "ochazuke", "Sections", "General (1)", "General", "1", "panes", "2", "scrolloff"], "contains": ["]/[ settings.tab"]},
    {"after": 2, "focus": "__settings/row/panes.group", "order": ["› app", "panes (2)", "panes.group", "panes.percent"]},
    {"after": 3, "focus": "__settings/row/ext.ai.model", "order": ["app", "› extensions", "ochazuke", "ai (1)", "ext.ai.model"], "contains": ["git", "Sections"], "lacks": ["panes"]},
    {"after": 4, "focus": "__settings/row/ext.git.fetch", "contains": ["› extensions", "git (1)"]},
    {"after": 5, "focus": "__settings/row/modal-dim", "contains": ["› ochazuke", "Appearance", "Keys", "Appearance (9)"]},
    {"after": 6, "focus": "__settings/row/ext.git.fetch"},
    {"after": 7, "focus": "__settings/row/ext.ai.model"},
    {"after": 8, "focus": "__settings/row/panes.group", "contains": ["› app"]},
    {"after": 9, "focus": "__settings/row/modal-dim", "contains": ["› ochazuke", "Appearance (9)"]},
    {"after": 10, "focus": "__settings/row/panes.group", "contains": ["› app", "panes (2)"]},
    {"after": 11, "focus": "__settings/row/ext.ai.model", "contains": ["› extensions"]},
    {"after": 13, "focus": "__settings/row/modal-dim", "contains": ["› ochazuke"]},
    {"after": 15, "focus": "__settings/row/ext.ai.model", "contains": ["› extensions"]},
    {"focus": "__settings/row/panes.group", "page": "__settings", "modal": "", "contains": ["› app", "panes (2)"]}
  ]
}
