{
  "name": "settings page: / in the section list lands on the All section (settings.all-section): typing path lists every matching setting from every section of every tab in one list, each under its tab and section heading; esc restores the page on the section it was on",
  "area": "settings",
  "width": 100,
  "height": 30,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Rows kept above and below the focus"
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "solarized"
      ]
    },
    {
      "name": "tab-width",
      "type": "integer",
      "default": 4,
      "description": "Columns per tab"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "script": [
    ",",
    "k",
    "/",
    "p",
    "a",
    "t",
    "h",
    "esc"
  ],
  "expect": [
    {
      "after": 2,
      "focus": "__settings/section/app/general"
    },
    {
      "after": 7,
      "mode": "list_filter",
      "focus": "__settings/section//all",
      "order": [
        "All (",
        "/path",
        "ochazuke › Appearance",
        "focus-display",
        "ochazuke › Palette",
        "forms.single-path",
        "ochazuke › Search",
        "search.case"
      ],
      "lacks": [
        "no settings match",
        "scrolloff",
        "modal-dim"
      ]
    },
    {
      "mode": "normal",
      "focus": "__settings/section/app/general",
      "page": "__settings",
      "contains": [
        "› app",
        "General (3)",
        "scrolloff",
        "theme",
        "tab-width"
      ],
      "lacks": [
        "/path",
        "ochazuke › Appearance",
        "focus-display"
      ]
    }
  ]
}
