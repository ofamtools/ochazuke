{
  "name": "settings page with settings.search-values false: / in the section list matches section titles only, as before; path matches no section",
  "area": "settings",
  "width": 100,
  "height": 30,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Rows kept above and below the focus"
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "solarized"
      ]
    },
    {
      "name": "tab-width",
      "type": "integer",
      "default": 4,
      "description": "Columns per tab"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "config": {
    "settings.json": {
      "settings.search-values": false
    }
  },
  "script": [
    ",",
    "k",
    "/",
    "p",
    "a",
    "t",
    "h",
    "esc"
  ],
  "expect": [
    {
      "after": 7,
      "mode": "list_filter",
      "contains": [
        "/path",
        "no sections m",
        "scrolloff"
      ],
      "lacks": [
        "path.start",
        "Choosers"
      ]
    },
    {
      "mode": "normal",
      "focus": "__settings/section/app/general",
      "contains": [
        "General",
        "scrolloff"
      ],
      "lacks": [
        "/path"
      ],
      "page": "__settings"
    }
  ]
}
