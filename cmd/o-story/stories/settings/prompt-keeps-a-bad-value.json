{
  "name": "settings page: enter on a text value opens a prompt; a bad value keeps it open",
  "area": "settings",
  "width": 100,
  "settings": [
    {"name": "debounce", "type": "duration", "default": "400ms", "description": "Wait before writing"},
    {"name": "editor", "type": "string", "default": "vi", "description": "The command that opens a file"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "bind": [{"noun": "demo", "keys": "S", "do": "settings.edit"}]
  },
  "script": ["S", "enter", "ctrl+u", {"type": "soon"}, "enter", "ctrl+u", {"type": "2s"}, "enter", "j", "enter", "ctrl+u", {"type": "nvim"}, "enter"],
  "expect": [
    {
      "after": 1,
      "lacks": ["setting.cycle"]
    },
    {
      "after": 2,
      "modal": "setting-prompt",
      "mode": "insert",
      "contains": ["debounce (duration)", "400ms", "enter setting-value.commit", "esc modal.close"]
    },
    {"after": 5, "modal": "setting-prompt", "contains": ["must be a duration"]},
    {"after": 8, "modal": "", "page": "__settings", "focus": "__settings/row/debounce", "mode": "normal", "contains": ["debounce •  2s", "Set in settings.json."]},
    {"after": 10, "modal": "setting-prompt", "contains": ["editor (string)", "vi"]},
    {"modal": "", "focus": "__settings/row/editor", "mode": "normal", "contains": ["editor •    nvim"]}
  ]
}
