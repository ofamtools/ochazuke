{
  "name": "settings page: each key saves at once, no save key; esc goes back",
  "area": "settings",
  "width": 100,
  "settings": [
    {"name": "scrolloff", "type": "integer", "default": 2, "description": "Rows kept around the focus"},
    {"name": "theme", "type": "string", "default": "dark", "description": "Colour theme", "enum": ["dark", "light", "mono"]},
    {"name": "wrap", "type": "boolean", "default": false, "description": "Wrap long lines"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "bind": [{"noun": "demo", "keys": "S", "do": "settings.edit"}]
  },
  "script": ["S", "l", "j", "enter", "h", "j", "space", "r", "esc"],
  "expect": [
    {
      "after": 1,
      "page": "__settings",
      "modal": "",
      "focus": "__settings/row/scrolloff",
      "order": ["Settings", "Sections", "General (3)", "General", "3", "scrolloff", "‹ 2 ›", "theme", "‹ dark ›", "wrap", "‹ false ›", "Rows kept around the focus", "Default is 2."],
      "contains": ["enter setting.edit", "h/l setting.cycle", "r setting.reset", "]/[ settings.tab"], "lacks": ["Source"]
    },
    {"after": 2, "contains": ["scrolloff •  ‹ 3 ›", "Set in settings.json."]},
    {"after": 4, "focus": "__settings/row/theme", "contains": ["theme •      ‹ light ›"]},
    {"after": 5, "focus": "__settings/row/theme", "contains": ["theme        ‹ dark ›"]},
    {"after": 7, "focus": "__settings/row/wrap", "contains": ["wrap •       ‹ true ›"]},
    {"after": 8, "contains": ["wrap         ‹ false ›", "scrolloff •  ‹ 3 ›"]},
    {"page": "page1", "modal": "", "focus": "a1", "lacks": ["scrolloff"]}
  ]
}
