{
  "name": "settings page: the rail picks the section the table shows",
  "area": "settings",
  "width": 100,
  "settings": [
    {"name": "scrolloff", "type": "integer", "default": 2, "description": "Rows kept above and below the focus when a page scrolls to follow it."},
    {"name": "theme", "type": "string", "default": "dark", "description": "Colour theme", "enum": ["dark", "light", "mono"]},
    {"name": "wrap", "type": "boolean", "default": false, "description": "Wrap long lines"},
    {"name": "editor", "type": "string", "default": "vi", "description": "The command that opens a file"},
    {"name": "ext.ai.poll-every", "type": "duration", "default": "30s", "description": "How often the AI extension refreshes its rows"},
    {"name": "ext.ai.model", "type": "string", "default": "large", "description": "Model the AI extension asks", "enum": ["small", "large"]},
    {"name": "ext.git.fetch", "type": "boolean", "default": true, "description": "Fetch before listing branches"}
  ],
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "bind": [{"noun": "demo", "keys": ",", "do": "settings.edit"}]
  },
  "script": [",", "shift+tab", "j", "l", "j", "shift+tab", "j", "enter", "space"],
  "expect": [
    {"after": 2, "focus": "__settings/section", "contains": ["General (4)", "scrolloff"]},
    {"after": 3, "focus": "__settings/section/ext.ai", "contains": ["ext.ai (2)", "poll-every", "30s", "model", "large"], "lacks": ["scrolloff"]},
    {"after": 4, "focus": "__settings/row/ext.ai.poll-every", "contains": ["ext.ai.poll-every", "How often the AI extension refreshes its rows"]},
    {"after": 5, "focus": "__settings/row/ext.ai.model"},
    {"after": 6, "focus": "__settings/section/ext.ai"},
    {"after": 7, "focus": "__settings/section/ext.git", "contains": ["ext.git (1)", "fetch", "true"]},
    {"after": 8, "focus": "__settings/row/ext.git.fetch"},
    {"focus": "__settings/row/ext.git.fetch", "contains": ["fetch    false", "settings.json"]}
  ]
}
