{
  "name": "settings page at 80 columns: section tabs, name and value rows, a list's items, the description",
  "area": "settings",
  "width": 80,
  "settings": [
    {
      "name": "scrolloff",
      "type": "integer",
      "default": 2,
      "description": "Rows kept above and below the focus when a page scrolls to follow it."
    },
    {
      "name": "theme",
      "type": "string",
      "default": "dark",
      "description": "Colour theme",
      "enum": [
        "dark",
        "light",
        "mono"
      ]
    },
    {
      "name": "wrap",
      "type": "boolean",
      "default": false,
      "description": "Wrap long lines"
    },
    {
      "name": "paths",
      "type": "list",
      "default": [
        "~/proj",
        "~/hub"
      ],
      "description": "Directories searched for projects, in order"
    },
    {
      "name": "ignore",
      "type": "list",
      "default": [],
      "description": "Names left out of every listing"
    },
    {
      "name": "editor",
      "type": "string",
      "default": "vi",
      "description": "The command that opens a file"
    },
    {
      "name": "ext.ai.poll-every",
      "owner": "extensions",
      "section": "ai",
      "type": "duration",
      "default": "30s",
      "description": "How often the AI extension refreshes its rows"
    },
    {
      "name": "ext.ai.model",
      "owner": "extensions",
      "section": "ai",
      "type": "string",
      "default": "large",
      "description": "Model the AI extension asks",
      "enum": [
        "small",
        "large"
      ]
    },
    {
      "name": "ext.git.fetch",
      "owner": "extensions",
      "section": "git",
      "type": "boolean",
      "default": true,
      "description": "Fetch before listing branches"
    }
  ],
  "page": {
    "title": "Tasks",
    "lists": [
      {
        "id": "a",
        "rows": 3
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": ",",
        "do": "settings.edit"
      }
    ]
  },
  "script": [
    ",",
    "l",
    "j"
  ]
}
