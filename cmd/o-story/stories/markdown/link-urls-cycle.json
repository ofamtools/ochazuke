{
  "name": "markdown: link-urls-cycle",
  "area": "markdown",
  "width": 80,
  "page": {
    "noHeadings": true,
    "markdown": {
      "text": "# Links\n\nBefore [alpha](https://a.example) between [beta](https://b.example) after.\n\nTail.\n"
    },
    "bind": [
      {"noun": "ochazuke.markdown", "keys": "U", "do": "ochazuke.setting.cycle", "args": {"name": "markdown.link-urls", "step": 1}}
    ]
  },
  "script": [
    "j",
    "U",
    "U"
  ],
  "expect": [
    {
      "after": 1,
      "contains": ["Before alpha between beta after.", "→ https://a.example"]
    },
    {
      "after": 2,
      "contains": ["alpha https://a.example between beta https://b.example after."],
      "lacks": ["→"]
    },
    {
      "after": 3,
      "contains": ["Before alpha between beta after."],
      "lacks": ["→", "https://a.example"]
    }
  ]
}
