{
  "name": "help.markdown off (the plain docs viewer): :docs-viewer open settings shows the generated settings page headed by the binary's build; :set docs.show-config=false drops only the yours lines; :help reaches it too; :docs-viewer open bindings shows the global key reference",
  "area": "docs",
  "width": 110,
  "height": 58,
  "config": {
    "settings.json": {"focus-display": "stack", "help.markdown": false}
  },
  "page": {
    "lists": [{"id": "a", "rows": 2}]
  },
  "script": [
    ":", {"type": "docs-viewer open settings"}, "enter",
    "j", "/", {"type": "### `focus-display`"}, "enter",
    "esc",
    ":", {"type": "set docs.show-config=false"}, "enter",
    ":", {"type": "help settings"}, "enter",
    "/", {"type": "choices `off`, `noun`, `stack`"}, "enter",
    "esc",
    ":", {"type": "docs-viewer open bindings"}, "enter"
  ],
  "expect": [
    {"after": 3, "modal": "docs-viewer", "contains": [" · catalog sha256:", "settings · 1–", "# Settings"]},
    {"after": 4, "modal": "docs-viewer", "contains": ["settings · 2–"]},
    {"after": 7, "modal": "docs-viewer", "contains": ["### `focus-display`", "> yours: `stack` (settings.json)"]},
    {"after": 8, "lacks": ["# Settings"]},
    {"after": 17, "modal": "docs-viewer", "contains": ["### `focus-display`", "string · default `off` · choices `off`, `noun`, `stack`"], "lacks": ["yours:"]},
    {"modal": "docs-viewer", "contains": ["bindings · 1–", "# Default key bindings"]}
  ]
}
