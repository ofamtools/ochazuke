{
  "name": "inspector binding leaves the editor's counted gg, gy yank history and gg motions intact",
  "area": "inputs",
  "width": 60,
  "height": 16,
  "page": {
    "noHeadings": true,
    "inputs": [{"id": "note", "label": "note", "text": "one\ntwo\nthree\nfour", "multiline": true}]
  },
  "script": ["G", "2", "g", "g", "i", {"type": "X"}, "esc", "y", "y", "g", "y", "esc", "g", "g", "i", {"type": "A"}, "esc"],
  "expect": [
    {"after": 7, "mode": "normal", "contains": ["Xtwo"]},
    {"after": 11, "modal": "__yank-history", "contains": ["Yank history"]},
    {"modal": "", "mode": "normal", "focus": "note", "contains": ["Aone"]}
  ]
}
