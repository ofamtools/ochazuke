{
  "name": "the page picker lists About though no tab shows it: ' about enter opens it, q returns to the page it came from, and ' about enter opens it again",
  "area": "page-picker",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "about": {
      "module": "github.com/unixsuperhero/demo",
      "version": "v1.2.3",
      "revision": "0123456789abcdef0123",
      "go": "go1.26.0",
      "binary": "/usr/local/bin/demo",
      "pid": 4242,
      "started": "2026-10-31T09:00:00",
      "uptime": "1h30m"
    }
  },
  "script": ["'", {"type": "about"}, "enter", "q", "'", {"type": "about"}, "enter", "q"],
  "expect": [
    {"after": 0, "page": "page1", "lacks": ["About"]},
    {"after": 2, "modal": "page-picker", "contains": ["About"]},
    {"after": 3, "page": "__about", "contains": ["github.com/unixsuperhero/demo", "v1.2.3"]},
    {"after": 4, "page": "page1", "focus": "a1", "lacks": ["github.com/unixsuperhero/demo"]},
    {"after": 7, "page": "__about", "contains": ["v1.2.3"]},
    {"after": 8, "page": "page1"}
  ]
}
