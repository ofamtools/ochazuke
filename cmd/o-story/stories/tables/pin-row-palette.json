{
  "name": "a row-select table pins a column from the palette, keeps it across a restart, and reset-columns puts the default pins back (R5.13)",
  "area": "tables",
  "width": 40,
  "height": 8,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "lists": [
      {
        "id": "t",
        "columns": [
          {
            "title": "name",
            "width": 8
          },
          {
            "title": "alpha",
            "width": 8
          },
          {
            "title": "bravo",
            "width": 8
          },
          {
            "title": "charlie",
            "width": 8
          },
          {
            "title": "delta",
            "width": 8
          },
          {
            "title": "echo",
            "width": 8
          }
        ],
        "items": [
          {
            "id": "t1",
            "label": "row1",
            "cells": [
              "row1",
              "a-1",
              "b-1",
              "c-1",
              "d-1",
              "e-1"
            ]
          },
          {
            "id": "t2",
            "label": "row2",
            "cells": [
              "row2",
              "a-2",
              "b-2",
              "c-2",
              "d-2",
              "e-2"
            ]
          },
          {
            "id": "t3",
            "label": "row3",
            "cells": [
              "row3",
              "a-3",
              "b-3",
              "c-3",
              "d-3",
              "e-3"
            ]
          }
        ]
      }
    ],
    "focus": "t1"
  },
  "script": [
    ":",
    {
      "type": "toggle-pin-column delta"
    },
    "enter",
    {
      "restart": true
    },
    ":",
    {
      "type": "reset-columns"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 3,
      "modal": "",
      "order": [
        "name",
        "delta",
        "alpha"
      ]
    },
    {
      "after": 4,
      "order": [
        "name",
        "delta",
        "alpha"
      ]
    },
    {
      "after": 7,
      "modal": "",
      "order": [
        "name",
        "alpha",
        "bravo"
      ],
      "lacks": [
        "delta"
      ]
    }
  ],
  "state": true
}
