{
  "name": "palette.choice-label id-first: the palette shows id then label, pickers keep label first",
  "area": "pickers",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "focus": "a1",
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label"
        },
        {
          "name": "status"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants",
          "status": "todo"
        },
        {
          "id": "t2",
          "title": "Write notes",
          "status": "doing"
        }
      ]
    },
    "bind": [
      {
        "noun": "app",
        "mode": "normal",
        "keys": "X",
        "do": "ochazuke.picker.open",
        "args": {
          "name": "demo"
        }
      }
    ],
    "verbs": [
      {
        "verb": "demo.things",
        "description": "List the things",
        "answer": [
          {
            "id": "thing/t-1",
            "label": "Water the plants"
          },
          {
            "id": "thing/t-2",
            "label": "Write notes"
          }
        ]
      },
      {
        "verb": "demo.open-thing",
        "description": "Open a thing",
        "positional": [
          "id"
        ],
        "parameters": {
          "id": {
            "type": "string",
            "required": true,
            "source": "demo.things",
            "description": "The thing to open"
          }
        }
      }
    ]
  },
  "script": [
    "X",
    "esc",
    ":",
    {
      "type": "open-thing "
    }
  ],
  "expect": [
    {
      "after": 1,
      "modal": "picker-demo",
      "contains": [
        "Water the plants  t1"
      ]
    },
    {
      "after": 4,
      "contains": [
        "thing/t-1  Water the plants"
      ],
      "lacks": [
        "Water the plants  t-1"
      ]
    }
  ],
  "settings": [
    {
      "name": "palette.choice-label",
      "type": "string",
      "default": "id-first",
      "enum": [
        "label-first",
        "id-first"
      ]
    }
  ]
}