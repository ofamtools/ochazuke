{
  "name": "the pickers picker: picker.open pickers lists pages, path, commands and a derived picker for the demo noun (it has a list verb); typing pages and enter opens the page picker",
  "area": "pickers",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "focus": "a1",
    "store": {
      "props": [{"name": "id", "key": true}, {"name": "title", "role": "label"}],
      "things": [{"id": "t1", "title": "Water the plants"}, {"id": "t2", "title": "Write notes"}]
    },
    "bind": [{"noun": "app", "mode": "normal", "keys": "X", "do": "ochazuke.picker.open", "args": {"name": "pickers"}}]
  },
  "script": ["X", {"type": "pages"}, "enter", "esc"],
  "expect": [
    {"after": 1, "modal": "picker-pickers", "contains": ["Pickers", "pages", "path", "commands", "demo"]},
    {"after": 3, "modal": "page-picker", "contains": ["Pages"]},
    {"after": 4, "modal": "", "focus": "a1"}
  ]
}
