{
  "name": "% jumps to the matching bracket (the first bracket at or after the cursor on its line, nesting counted); y% and d% take both brackets",
  "area": "editor",
  "width": 40,
  "height": 3,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "inputs": [{"id": "name", "label": "name", "text": "f(a, [b]) + c"}]
  },
  "script": ["y", "%", "%", "d", "%"],
  "expect": [
    {"after": 2, "mode": "normal", "register": "f(a, [b])"},
    {"mode": "normal", "register": "(a, [b])", "contains": ["name: f + c"]}
  ]
}
