{
  "name": "W, E and B move by WORDs (blank-separated, punctuation inside): W to the next WORD, E to a WORD's end, B back to its start, dW deletes a WORD and the blank after it",
  "area": "editor",
  "width": 40,
  "height": 3,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "inputs": [{"id": "name", "label": "name", "text": "foo.bar baz-qux end"}]
  },
  "script": ["W", "i", {"type": "["}, "esc", "E", "a", {"type": "]"}, "esc", "B", "d", "W"],
  "expect": [
    {"after": 4, "mode": "normal", "contains": ["name: foo.bar [baz-qux end"]},
    {"after": 8, "mode": "normal", "contains": ["name: foo.bar [baz-qux] end"]},
    {"mode": "normal", "register": "[baz-qux] ", "contains": ["name: foo.bar end"]}
  ]
}
