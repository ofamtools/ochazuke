{
  "name": "the refresh diff follows the focused pick: each pick shows its own thing and prop, - the copy's value, + the source's",
  "area": "copies",
  "width": 100,
  "height": 24,
  "chrome": "full",
  "page": {
    "noHeadings": true,
    "lists": [
      {
        "id": "tasks",
        "from": true,
        "height": -1
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants",
          "status": "todo"
        },
        {
          "id": "t2",
          "title": "Write notes",
          "status": "todo"
        },
        {
          "id": "t3",
          "title": "Call mom",
          "status": "todo"
        }
      ],
      "copy": {
        "change": {
          "t1": {
            "title": "Water the ferns",
            "status": "done"
          },
          "t2": {
            "status": "doing"
          }
        }
      }
    },
    "bind": [
      {
        "noun": "demo",
        "keys": "S",
        "do": "demo.change-source"
      },
      {
        "noun": "demo",
        "keys": "F",
        "do": "demo.refresh"
      }
    ]
  },
  "script": [
    "S",
    "F",
    "j",
    "j"
  ],
  "expect": [
    {
      "after": 2,
      "contains": [
        "- title: Water the plants",
        "+ title: Water the ferns"
      ],
      "lacks": [
        "status: todo"
      ]
    },
    {
      "after": 3,
      "contains": [
        "- status: todo",
        "+ status: done"
      ],
      "lacks": [
        "title: Water the ferns"
      ]
    },
    {
      "contains": [
        "Write notes",
        "- status: todo",
        "+ status: doing"
      ],
      "lacks": [
        "status: done"
      ]
    }
  ]
}
