{
  "name": "with many differences the focused pick stays visible and the diff shows its own lines, however far down it is",
  "area": "copies",
  "width": 100,
  "height": 30,
  "chrome": "full",
  "page": {
    "noHeadings": true,
    "lists": [
      {
        "id": "tasks",
        "from": true,
        "height": -1
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Task 1",
          "status": "todo"
        },
        {
          "id": "t2",
          "title": "Task 2",
          "status": "todo"
        },
        {
          "id": "t3",
          "title": "Task 3",
          "status": "todo"
        },
        {
          "id": "t4",
          "title": "Task 4",
          "status": "todo"
        },
        {
          "id": "t5",
          "title": "Task 5",
          "status": "todo"
        },
        {
          "id": "t6",
          "title": "Task 6",
          "status": "todo"
        }
      ],
      "copy": {
        "change": {
          "t1": {
            "title": "Task 1 renamed",
            "status": "done"
          },
          "t2": {
            "title": "Task 2 renamed",
            "status": "done"
          },
          "t3": {
            "title": "Task 3 renamed",
            "status": "done"
          },
          "t4": {
            "title": "Task 4 renamed",
            "status": "done"
          },
          "t5": {
            "title": "Task 5 renamed",
            "status": "done"
          },
          "t6": {
            "title": "Task 6 renamed",
            "status": "done"
          }
        }
      }
    },
    "bind": [
      {
        "noun": "demo",
        "keys": "S",
        "do": "demo.change-source"
      },
      {
        "noun": "demo",
        "keys": "F",
        "do": "demo.refresh"
      }
    ]
  },
  "script": [
    "S",
    "F",
    "j",
    "j",
    "j",
    "j",
    "j",
    "j"
  ],
  "expect": [
    {
      "after": 3,
      "focus": "copies-refresh/d2",
      "highlightedText": "local",
      "contains": [
        "Task 1 · status",
        "- status: todo"
      ]
    },
    {
      "focus": "copies-refresh/d7",
      "highlightedText": "local",
      "contains": [
        "Task 4 · title",
        "- title: Task 4",
        "+ title: Task 4 renamed"
      ],
      "lacks": [
        "Task 1 renamed"
      ]
    }
  ]
}
