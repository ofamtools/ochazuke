{
  "name": "a refresh pick is always local or source, what the copy holds: no (none) to choose, local starts every pick, and picking local after source puts the copy's value back",
  "area": "copies",
  "width": 100,
  "height": 24,
  "chrome": "full",
  "page": {
    "noHeadings": true,
    "lists": [
      {
        "id": "tasks",
        "from": true,
        "height": -1
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants",
          "status": "todo"
        },
        {
          "id": "t2",
          "title": "Write notes",
          "status": "todo"
        },
        {
          "id": "t3",
          "title": "Call mom",
          "status": "todo"
        }
      ],
      "copy": {
        "change": {
          "t1": {
            "title": "Water the ferns",
            "status": "done"
          },
          "t2": {
            "status": "doing"
          }
        }
      }
    },
    "bind": [
      {
        "noun": "demo",
        "keys": "S",
        "do": "demo.change-source"
      },
      {
        "noun": "demo",
        "keys": "F",
        "do": "demo.refresh"
      }
    ]
  },
  "script": [
    "S",
    "F",
    "enter",
    "j",
    "enter",
    "enter",
    "k",
    "enter",
    "esc"
  ],
  "expect": [
    {
      "after": 2,
      "contains": [
        "local ▾"
      ],
      "lacks": [
        "(none)"
      ]
    },
    {
      "after": 3,
      "contains": [
        "local",
        "source"
      ],
      "lacks": [
        "(none)"
      ]
    },
    {
      "after": 5,
      "contains": [
        "source ▾"
      ]
    },
    {
      "after": 8,
      "contains": [
        "local ▾"
      ],
      "lacks": [
        "(none)",
        "source ▾"
      ]
    },
    {
      "modal": "",
      "contains": [
        "Water the plants ≠"
      ],
      "lacks": [
        "Water the ferns"
      ]
    }
  ]
}
