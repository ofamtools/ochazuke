{
  "name": "a copy store's refresh: the source changes, the copy keeps its value; refresh shows a plain diff of the copy against the source with a pick per prop, the differing row is marked, nothing blocks; picking source writes the copy and the mark clears",
  "area": "copies",
  "width": 100,
  "height": 20,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "lists": [
      {
        "id": "tasks",
        "from": true,
        "height": -1
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label",
          "type": "string"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants"
        },
        {
          "id": "t2",
          "title": "Write notes"
        }
      ],
      "copy": {
        "change": {
          "t1": {
            "title": "Water the ferns"
          }
        }
      }
    },
    "bind": [
      {
        "noun": "demo",
        "keys": "S",
        "do": "demo.change-source"
      },
      {
        "noun": "demo",
        "keys": "F",
        "do": "demo.refresh"
      }
    ]
  },
  "script": [
    "S",
    "F",
    "esc",
    "j",
    "k",
    "F",
    "enter",
    "j",
    "enter",
    "esc"
  ],
  "expect": [
    {
      "after": 1,
      "contains": [
        "Water the plants",
        "Write notes"
      ],
      "lacks": [
        "Water the ferns"
      ]
    },
    {
      "after": 2,
      "contains": [
        "Refresh demo Water the plants: 1 difference",
        "- title: Water the plants",
        "+ title: Water the ferns",
        "local ▾"
      ],
      "lacks": [
        "(none)"
      ]
    },
    {
      "after": 3,
      "modal": "",
      "contains": [
        "Water the plants ≠",
        "Write notes"
      ]
    },
    {
      "after": 5,
      "modal": "",
      "contains": [
        "Water the plants ≠"
      ]
    },
    {
      "after": 9,
      "contains": [
        "Water the ferns",
        "source ▾"
      ],
      "lacks": [
        "≠"
      ]
    },
    {
      "modal": "",
      "contains": [
        "Water the ferns",
        "Write notes"
      ],
      "lacks": [
        "≠",
        "Water the plants"
      ]
    }
  ]
}
