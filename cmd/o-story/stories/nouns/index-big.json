{
  "name": "a 20,000-thing paged store: its index reads one page of 200 and the archived count (no full list: the writes hold no list; the show form gets the selected thing once), says the page and the total, and collection.page-next reads the next page",
  "area": "nouns",
  "width": 110,
  "height": 30,
  "chrome": "full",
  "pages": [
    {
      "id": "work",
      "title": "Work",
      "nounsPage": true,
      "lists": [
        {
          "id": "a",
          "rows": 2
        }
      ],
      "store": {
        "noun": "chore",
        "paged": true,
        "token": true,
        "props": [
          {
            "name": "id",
            "key": true
          },
          {
            "name": "title",
            "role": "label",
            "type": "string"
          },
          {
            "name": "archived",
            "role": "archive",
            "type": "boolean"
          }
        ],
        "things": [],
        "generate": {
          "count": 20000,
          "thing": {
            "id": "c{{n}}",
            "title": "chore {{n}}",
            "archived": false
          }
        }
      },
      "nouns": [
        {
          "noun": "deploy",
          "verbs": [
            "run",
            "rollback"
          ]
        }
      ]
    }
  ],
  "script": [
    "ctrl+j",
    "enter",
    ":",
    {
      "type": "collection page-next"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 2,
      "page": "nouns/chore",
      "contains": [
        "chore · 20000",
        "page 1/100 of 20000",
        "chore 00001"
      ],
      "lacks": [
        "list"
      ],
      "writes": [
        "query page=1 per=1",
        "query page=1 per=1",
        "query page=1 per=200",
        "query page=1 per=1",
        "get c00001"
      ]
    },
    {
      "page": "nouns/chore",
      "contains": [
        "page 2/100 of 20000",
        "chore 00201"
      ],
      "writes": [
        "query page=1 per=1",
        "query page=1 per=1",
        "query page=1 per=200",
        "query page=1 per=1",
        "get c00001",
        "query page=2 per=200",
        "query page=1 per=1",
        "get c00201"
      ]
    }
  ]
}
