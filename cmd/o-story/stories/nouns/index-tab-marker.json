{
  "name": "a noun's index page is not a tab: while it is open the tab row keeps the tab it was opened from current (the Nouns page), never the first tab",
  "area": "nouns",
  "width": 100,
  "height": 24,
  "chrome": "full",
  "pages": [
    {
      "id": "work",
      "title": "Work",
      "nounsPage": true,
      "lists": [
        {
          "id": "a",
          "rows": 1
        }
      ],
      "store": {
        "noun": "chore",
        "paged": true,
