{
  "name": "an index sorts and filters through the list's own keys: the sort goes into the store's query and the page is read again",
  "area": "nouns",
  "width": 110,
  "height": 30,
  "chrome": "full",
  "pages": [
    {
      "id": "work",
      "title": "Work",
      "nounsPage": true,
      "lists": [
        {
          "id": "a",
          "rows": 2
        }
      ],
      "store": {
        "noun": "chore",
        "paged": true,
        "token": true,
        "props": [
          {
            "name": "id",
            "key": true
          },
          {
            "name": "title",
            "role": "label",
            "type": "string"
          },
          {
            "name": "archived",
            "role": "archive",
            "type": "boolean"
          }
        ],
        "things": [
          {
            "id": "c1",
            "title": "Water the plants",
            "archived": false
          },
          {
            "id": "c2",
            "title": "Old chore",
            "archived": true
          },
          {
            "id": "c3",
            "title": "Write notes",
            "archived": false
          }
        ]
      },
      "nouns": [
        {
          "noun": "deploy",
          "verbs": [
            "run",
            "rollback"
          ]
        }
      ]
    }
  ],
  "script": [
    "ctrl+j",
    "enter",
    ":",
    {
      "type": "collection sort -title"
    },
    "enter",
    "/",
    {
      "type": "notes"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 5,
      "page": "nouns/chore",
      "contains": [
        "\u25bc"
      ]
    },
    {
      "page": "nouns/chore",
      "contains": [
        "Write notes"
      ],
      "lacks": [
        "Water the plants"
      ]
    }
  ]
}
