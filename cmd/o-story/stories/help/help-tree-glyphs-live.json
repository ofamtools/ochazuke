{
 "name": "help tree refreshes its fold marks on a live chrome.glyphs change",
 "area": "help",
 "width": 80,
 "height": 90,
 "page": {
  "lists": [
   {
    "id": "a",
    "rows": 2
   }
  ],
  "bind": [
   {
    "noun": "demo",
    "keys": "z l",
    "do": "demo.open"
   },
   {
    "noun": "demo",
    "keys": "ctrl+a v",
    "do": "demo.notify"
   },
   {
    "noun": "demo",
    "keys": "z h",
    "do": "demo.reset"
   },
   {
    "noun": "demo",
    "keys": "ctrl+a t",
    "do": "demo.delete"
   },
   {
    "noun": "demo",
    "keys": "g c y",
    "do": "notice.clear"
   },
   {
    "noun": "demo",
    "keys": "g c x",
    "do": "demo.notify"
   },
   {
    "noun": "demo",
    "keys": "ctrl+a N",
    "do": "demo.open"
   },
   {
    "noun": "demo",
    "keys": "ctrl+a n",
    "do": "demo.reset"
   }
  ]
 },
 "script": [
  "?",
  ":",
  {
   "type": "set chrome.glyphs=nerd"
  },
  "enter"
 ],
 "expect": {
  "contains": [
   ""
  ],
  "lacks": [
   "▾",
   "▸"
  ]
 }
}