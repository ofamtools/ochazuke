{
  "name": "a in the ? help opens the args form; a run whose job fails later reopens the form with what was typed and one sentence, as a synchronous failure does (R12.6)",
  "area": "help",
  "width": 110,
  "height": 40,
  "page": {
    "lists": [{"id": "a", "items": [{"id": "a1", "label": "one", "data": {"host": "h1"}}]}],
    "verbs": [{"verb": "demo.send", "description": "Send to a host, later", "pending": true, "parameters": {"to": {"type": "string", "required": true}}}],
    "bind": [{"noun": "app", "keys": "F", "do": "demo.finish", "args": {"verb": "demo.send", "fail": true}}]
  },
  "script": ["?", "/", {"type": "demo.send"}, "enter", "a", {"type": "h9"}, "enter", "F", {"job": "demo.send", "state": "failed"}],
  "expect": [
    {"after": 6, "modal": "args-form", "contains": ["h9"]},
    {"modal": "args-form", "contains": ["h9", "not run"]}
  ]
}
