{
  "name": "? help table: the noun's unbound verbs are rows under an unbound heading below the keys; u keeps only them, U brings the keys back, enter runs one",
  "area": "help",
  "width": 120,
  "height": 40,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": "g x",
        "do": "demo.reset"
      }
    ]
  },
  "script": [
    "?",
    "S",
    "S",
    "n",
    "d",
    "e",
    "m",
    "o",
    "enter",
    "G",
    "u",
    "S"
  ],
  "expect": [
    {
      "after": 9,
      "modal": "bindings-help",
      "contains": [
        "Keys \u00b7 table"
      ]
    },
    {
      "after": 10,
      "contains": [
        "unbound",
        "demo.",
        "check"
      ]
    },
    {
      "after": 11,
      "contains": [
        "unbound = true",
        "unbound",
        ".usage"
      ],
      "lacks": [
        "ctrl+d"
      ]
    },
    {
      "after": 12,
      "contains": [
        "Keys \u00b7 here",
        "unbound"
      ]
    }
  ]
}