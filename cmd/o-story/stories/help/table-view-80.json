{
  "name": "help table at 80 columns: the modes that do not fit are hidden, z l scrolls them in and $ to the last, the key column kept",
  "area": "help",
  "width": 80,
  "height": 30,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ]
  },
  "script": ["?", "S", "S", "n", "l", "i", "s", "t", "enter", "z", "l", "z", "l", "$"],
  "expect": [
    {"after": 9, "modal": "bindings-help", "contains": ["Keys · table", "key         normal", "list_filter"], "lacks": ["visual-line"]},
    {"after": 13, "modal": "bindings-help", "contains": ["key         list_filter"], "lacks": ["visual-line"]},
    {"modal": "bindings-help", "contains": ["visual-line", "ctrl+n"], "lacks": ["key         normal"]}
  ]
}
