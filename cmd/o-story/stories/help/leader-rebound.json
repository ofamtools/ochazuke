{
  "name": "? help over a live terminal with terminal-leader ctrl+b: the leader's row and every sequence under it follow the setting (R6.10)",
  "area": "help",
  "width": 100,
  "height": 70,
  "settings": [
    {
      "name": "terminal-leader",
      "type": "string",
      "default": "ctrl+b"
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "terminal": {
      "fake": true,
      "attach": "a1"
    },
    "bind": [
      {
        "noun": "ochazuke.terminal",
        "mode": "leader_pending",
        "keys": "?",
        "do": "ochazuke.bindings.help"
      }
    ]
  },
  "script": [
    "enter",
    {
      "tick": "terminal"
    },
    "ctrl+b",
    "?"
  ],
  "expect": {
    "modal": "bindings-help",
    "contains": [
      "▾ ctrl+b",
      "▸ ctrl+b d",
      "▸ ctrl+b ?",
      "▸ ctrl+b ctrl+b",
      "terminal.send"
    ],
    "lacks": [
      "ctrl+a ?",
      "ctrl+a ctrl+a"
    ]
  }
}
