{
  "name": "? help on a mode whose row enters itself: L lists loop's rows, loop's x lists them once more, and there x shows as mode.enter: the expansion recurses one level, never loops (R6.10)",
  "area": "help",
  "width": 100,
  "height": 70,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "pending": [
      "loop"
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": "L",
        "do": "ochazuke.mode.enter",
        "args": {
          "mode": "loop"
        }
      },
      {
        "noun": "demo",
        "mode": "loop",
        "keys": "x",
        "do": "ochazuke.mode.enter",
        "args": {
          "mode": "loop"
        }
      },
      {
        "noun": "demo",
        "mode": "loop",
        "keys": "y",
        "do": "demo.notify"
      }
    ]
  },
  "script": [
    "?"
  ],
  "expect": {
    "modal": "bindings-help",
    "contains": [
      "enters loop:",
      "L x x",
      "L x y",
      "L y"
    ],
    "lacks": [
      "L x x x",
      "L x x y"
    ]
  }
}
