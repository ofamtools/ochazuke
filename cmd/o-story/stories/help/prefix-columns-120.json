{
  "name": "? help at 120 columns: every row's key is the whole sequence; a prefix has a row of its own (waits for the next key, with the count), open, its sequences under it sorted by key, a longer prefix's row under the one it extends; each sequence closed on its steps (R6.10, R6.9, R6.7)",
  "area": "help",
  "width": 120,
  "height": 90,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "bind": [
      {
        "noun": "demo",
        "keys": "z l",
        "do": "demo.open"
      },
      {
        "noun": "demo",
        "keys": "ctrl+a v",
        "do": "demo.notify"
      },
      {
        "noun": "demo",
        "keys": "z h",
        "do": "demo.reset"
      },
      {
        "noun": "demo",
        "keys": "ctrl+a t",
        "do": "demo.delete"
      },
      {
        "noun": "demo",
        "keys": "g c y",
        "do": "notice.clear"
      },
      {
        "noun": "demo",
        "keys": "g c x",
        "do": "demo.notify"
      },
      {
        "noun": "demo",
        "keys": "ctrl+a N",
        "do": "demo.open"
      },
      {
        "noun": "demo",
        "keys": "ctrl+a n",
        "do": "demo.reset"
      }
    ]
  },
  "script": [
    "?"
  ],
  "expect": [
    {
      "after": 1,
      "modal": "bindings-help",
      "contains": [
        "▾ z",
        "▸ z h",
        "▾ ctrl+a",
        "▸ ctrl+a n",
        "▸ ctrl+a v",
        "▾ g",
        "▾ g c",
        "▸ g c x",
        "▸ g c y",
        "waits for",
        "arguments"
      ],
      "lacks": [
        "▸ z\n"
      ]
    }
  ]
}
