{
  "name": "detail: spills between lists and a table pass the detail by; it follows the new row",
  "area": "detail",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [{"id": "a", "rows": 2}, {"id": "t", "columns": [{"title": "Name"}, {"title": "Size"}], "items": [{"id": "t1", "label": "t1", "cells": ["t1", "10"]}, {"id": "t2", "label": "t2", "cells": ["t2", "20"]}]}, {"id": "b", "rows": 2}],
    "detail": {"lines": 50, "split": false}
  },
  "script": ["j", "J", "j", "k", "j", "j", "j", "k"],
  "expect": [
    {"after": 2, "focus": "a2", "contains": ["detail 2–", "a2 line 2"]},
    {"after": 3, "focus": "t1", "contains": ["detail 1–", "t1 line 1"]},
    {"after": 4, "focus": "a2", "contains": ["detail 1–", "a2 line 1"]},
    {"after": 6, "focus": "t2", "contains": ["t2 line 1"]},
    {"after": 7, "focus": "b1", "contains": ["detail 1–", "b1 line 1"]},
    {"focus": "t2", "contains": ["detail 1–", "t2 line 1"]}
  ],
  "covers": [
    "detail/~spill/to=lists,direction=next,placement=page",
    "detail/~spill/to=lists,direction=previous,placement=page",
    "detail/~spill/to=tables,direction=next,placement=page",
    "detail/~spill/to=tables,direction=previous,placement=page"
  ]
}
