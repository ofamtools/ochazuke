{
  "name": "detail: a macro that types J into the palette replays as text, not a scroll",
  "area": "detail",
  "width": 60,
  "height": 16,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "detail": {"lines": 50, "texts": {"a1": ["{item} only line"]}},
    "bind": [{"noun": "app", "keys": "Q", "do": "mode.enter", "args": {"mode": "macro_pending"}}]
  },
  "script": ["Q", "a", ":", "J", "esc", "esc", "q", "@", "a", "j", ":", "J", "K"],
  "expect": [
    {"after": 4, "modal": "palette", "lacks": [" / "]},
    {"after": 9, "focus": "a1", "mode": "normal", "modal": "", "contains": ["a1 only line"], "lacks": [" / ", "Error"]},
    {"after": 10, "focus": "a2", "contains": ["detail 1–"]},
    {"modal": "palette", "contains": ["JK", "detail 1–"]}
  ],
  "covers": [
    "detail/detail.scroll(lines=*)/mode=normal,placement=under-palette,focus=unfocused,outcome=guard-false,data=one,state=plain,size=narrow,modifiers=in-macro",
    "detail/detail.scroll(lines=*)/mode=normal,placement=under-palette,focus=unfocused,outcome=guard-false,data=overflow,state=plain,size=narrow,modifiers=none",
    "detail/~hosted/placement=under-palette,size=narrow"
  ]
}
