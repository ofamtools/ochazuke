{
  "name": "detail: under the palette J/K are the line's text; an empty detail stays as it was",
  "area": "detail",
  "width": 80,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "detail": {"lines": 0, "text": []}
  },
  "script": [":", "J", "K", "esc", "esc"],
  "expect": [
    {"after": 3, "modal": "palette", "mode": "insert", "contains": ["JK", "detail"], "lacks": [" / "]},
    {"focus": "a1", "mode": "normal", "modal": "", "lacks": [" / ", "Error"]}
  ],
  "covers": [
    "detail/detail.scroll(lines=*)/mode=normal,placement=under-palette,focus=unfocused,outcome=guard-false,data=empty,state=plain,size=normal,modifiers=none",
    "detail/~hosted/placement=under-palette,size=normal"
  ]
}
