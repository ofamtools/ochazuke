  "script": ["/", {"type": "a2"}, "enter", "}", "Q", "a", "J", "J", "q", "@", "a", "K"],
  "expect": [
    {"after": 3, "focus": "a2", "contains": ["/a2", "detail 1–", "/ 30"]},
    {"after": 4, "focus": "name", "mode": "normal", "contains": ["/a2", "detail 1–"]},
    {"after": 8, "focus": "name", "contains": ["detail 3–"]},
    {"after": 11, "focus": "name", "mode": "normal", "contains": ["detail 5–", "一二三四五六七八"], "lacks": ["a3"]},
    {"focus": "name", "mode": "normal", "contains": ["/a2", "detail 4–"], "lacks": ["a3"]}
