{
  "name": "detail: an empty or one-line detail ignores J/K, in a macro or from another stop",
  "area": "detail",
  "width": 140,
  "height": 30,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "inputs": [{"id": "name", "label": "name", "text": "hello"}],
    "detail": {"lines": 0, "texts": {"a1": [], "a2": ["{item} only line"]}},
    "bind": [{"noun": "app", "keys": "Q", "do": "mode.enter", "args": {"mode": "macro_pending"}}]
  },
  "script": ["Q", "a", "J", "K", "q", "@", "a", "j", "}", "J", "K"],
  "expect": [
    {"after": 4, "focus": "a1", "lacks": [" / ", "Error"]},
    {"after": 7, "focus": "a1", "mode": "normal", "lacks": [" / ", "Error", "J/K detail"]},
    {"after": 9, "focus": "name", "mode": "normal", "contains": ["a2 only line"]},
    {"focus": "name", "mode": "normal", "contains": ["a2 only line"], "lacks": [" / ", "Error", "J/K detail"]}
  ],
  "covers": [
    "detail/detail.scroll(lines=*)/mode=normal,placement=page,focus=focused,outcome=guard-false,data=empty,state=plain,size=wide,modifiers=in-macro",
    "detail/detail.scroll(lines=*)/mode=normal,placement=page,focus=unfocused,outcome=guard-false,data=one,state=plain,size=wide,modifiers=none",
    "detail/~hosted/placement=page,size=wide"
  ]
}
