{
  "name": "detail: J, the palette line and the CLI each scroll the detail one line",
  "area": "detail",
  "width": 80,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "detail": {"lines": 50}
  },
  "script": ["J", ":", {"type": "detail scroll"}, "enter", {"cli": ["detail", "scroll"]}],
  "expect": [
    {"after": 1, "contains": ["detail 2–"]},
    {"after": 4, "modal": "", "focus": "a1", "mode": "normal", "contains": ["detail 3–"]},
    {"focus": "a1", "contains": ["detail 4–"], "cli": ["3"], "lacks": ["Error"]}
  ],
  "covers": [
    "detail/palette:detail.scroll/outcome=success",
    "detail/cli:detail.scroll/outcome=success",
    "detail/parity:detail.scroll/outcome=success"
  ]
}
