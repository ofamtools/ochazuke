{
  "name": "chooser: tab and shift+tab cycle the sources, the query carries over, the title names the current source and the others",
  "area": "chooser",
  "width": 80,
  "height": 14,
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "chooser": {
      "kind": "pick",
      "title": "Pick",
      "sources": [
        {"name": "one", "rows": [{"id": "1a", "label": "alpha"}, {"id": "1b", "label": "beta"}]},
        {"name": "two", "rows": [{"id": "2a", "label": "alpine"}, {"id": "2g", "label": "gamma"}]},
        {"name": "three", "rows": [{"id": "3d", "label": "delta"}]}
      ]
    }
  },
  "script": [{"type": "al"}, "tab", "tab", "shift+tab", "enter"],
  "expect": [
    {"after": 1, "modal": "pick", "contains": ["Pick · [one] two three", "alpha"], "lacks": ["alpine", "beta"]},
    {"after": 2, "contains": ["Pick · one [two] three", "› al", "alpine"], "lacks": ["alpha", "gamma"]},
    {"after": 3, "contains": ["one two [three]", "› al", "no matches"]},
    {"after": 4, "contains": ["one [two] three", "alpine"]},
    {"modal": "", "writes": ["pick 2a"]}
  ]
}
