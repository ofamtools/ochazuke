{
  "name": "path chooser, typed: a path whose folder is missing is still a row that says why, and enter on it fails naming the missing folder, the chooser kept (R7.8)",
  "area": "chooser",
  "width": 100,
  "height": 18,
  "files": ["a.json"],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "records": [
      {"id": "doc", "fields": [{"name": "file", "type": "path", "base": "{{files}}"}]}
    ],
    "focus": "doc/file"
  },
  "script": ["enter", {"job": "chooser.load"}, "tab", "tab", {"type": "/nonexistent-dir/x.json"}, {"job": "chooser.load"}, "enter"],
  "expect": [
    {"after": 6, "contains": ["browse recent [typed]", "/nonexistent-dir/x.json", "/nonexistent-dir does not exist"], "lacks": ["type a path"]},
    {"modal": "path-chooser", "contains": ["/nonexistent-dir does not exist"], "lacks": ["nothing matches"], "writes": []}
  ]
}
