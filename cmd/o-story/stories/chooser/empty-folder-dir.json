{
  "name": "path chooser: empty folder dir",
  "area": "chooser",
  "width": 100,
  "height": 18,
  "files": [
    "sub/"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}/sub",
            "path": "dir"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "chooser.load"
    }
  ],
  "expect": [
    {
      "contains": [
        "type a path to pick one"
      ]
    }
  ]
}