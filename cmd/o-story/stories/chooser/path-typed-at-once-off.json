{
  "name": "path chooser: with chooser.claim-source off, a path query keeps the current source (ctrl+o switches)",
  "area": "chooser",
  "width": 100,
  "height": 18,
  "files": [
    "a.json"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "records": [
      {
        "id": "doc",
        "fields": [
          {
            "name": "file",
            "type": "path",
            "base": "{{files}}"
          }
        ]
      }
    ],
    "focus": "doc/file"
  },
  "script": [
    "enter",
    {
      "job": "chooser.load"
    },
    {
      "type": "/nonexistent-dir/x.json"
    }
  ],
  "expect": [
    {
      "contains": [
        "[browse"
      ],
      "lacks": [
        "[typed]"
      ]
    }
  ],
  "settings": [
    {
      "name": "chooser.claim-source",
      "type": "boolean",
      "default": false
    }
  ]
}