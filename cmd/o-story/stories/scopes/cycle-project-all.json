{
  "name": "a declared project scope opens first, the tag counts the rest, alt+s widens to all; a typed value nothing matches is accepted on a free parameter",
  "area": "scopes",
  "width": 100,
  "height": 24,
  "page": {
    "inputs": [
      {
        "id": "q",
        "label": "query"
      }
    ],
    "verbs": [
      {
        "verb": "swatch.names",
        "description": "List the swatches",
        "parameters": {
          "project": {
            "type": "string"
          }
        },
        "rowsArg": "project",
        "rowsBy": {
          "": [
            "alpha",
            "beta",
            "gamma",
            "delta"
          ],
          "matomeru": [
            "alpha",
            "beta"
          ]
        }
      },
      {
        "verb": "swatch.paint",
        "description": "Paint a swatch",
        "positional": [
          "swatch"
        ],
        "parameters": {
          "swatch": {
            "type": "string",
            "required": true,
            "free": true,
            "source": "swatch.names",
            "description": "The swatch to paint",
            "scopes": [
              {
                "name": "project",
                "fixed": {
                  "project": "matomeru"
                }
              },
              {
                "name": "all"
              }
            ]
          }
        }
      }
    ]
  },
  "script": [
    ":",
    {
      "type": "swatch paint"
    },
    "enter",
    "ctrl+space",
    "alt+s",
    {
      "type": "zzz"
    },
    "enter",
    "enter"
  ],
  "expect": [
    {
      "after": 4,
      "contains": [
        "Suggest swatch",
        "alpha",
        "beta",
        "project",
        "2 more in all"
      ],
      "lacks": [
        "gamma",
        "delta"
      ]
    },
    {
      "after": 5,
      "contains": [
        "alpha",
        "beta",
        "gamma",
        "delta"
      ]
    },
    {
      "after": 6,
      "contains": [
        "use \"zzz\""
      ]
    },
    {
      "modal": "",
      "writes": [
        "swatch.names project=matomeru",
        "swatch.names project=matomeru",
        "swatch.names",
        "swatch.names",
        "swatch.paint swatch=zzz"
      ]
    }
  ]
}