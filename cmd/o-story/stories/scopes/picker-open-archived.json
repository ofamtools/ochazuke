{
  "name": "picker.open on a noun that archives opens on all and alt+s adds the archived ones",
  "area": "scopes",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "store": {"noun": "parcel", "props": [{"name": "id", "key": true}, {"name": "title", "role": "label", "required": true}, {"name": "done", "role": "archive", "type": "boolean"}], "things": [{"id": "t1", "title": "Original"}, {"id": "t3", "title": "Old one", "done": true}]}
  },
  "script": [":", {"type": "picker open parcel"}, "enter", "alt+s"],
  "expect": [
    {"after": 3, "contains": ["Original", "1 more in archived"], "lacks": ["Old one"]},
    {"contains": ["Original", "Old one"], "lacks": ["more in"]}
  ]
}
