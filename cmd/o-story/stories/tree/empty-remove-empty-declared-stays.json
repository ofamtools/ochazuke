{
  "name": "outline: a row that declares remove-empty keeps its text and its place when its line is emptied; nothing is written and u has nothing to undo",
  "area": "tree",
  "page": {
    "trees": [
      {"id": "t", "editable": true, "nodes": [
        {"id": "a", "label": "alpha"},
        {"id": "b", "label": "beta", "fixed": ["remove-empty"]}
      ]}
    ]
  },
  "script": ["j", "i", "backspace", "esc", "u"],
  "expect": [
    {"after": 4, "mode": "normal", "focus": "b", "writes": [], "contains": ["alpha", "beta"]},
    {"focus": "b", "writes": [], "contains": ["beta"]}
  ]
}
