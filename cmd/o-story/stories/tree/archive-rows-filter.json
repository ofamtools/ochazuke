{
  "name": "archive rows in a tree: an archived node hides its subtree, the saved archived filter shows it with its ancestors, clearing hides it again",
  "area": "tree",
  "width": 100,
  "height": 14,
  "chrome": "none",
  "page": {
    "noHeadings": true,
    "nouns": [
      {
        "noun": "lane",
        "props": [
          {"name": "archived", "type": "boolean", "role": "archive"}
        ]
      }
    ],
    "trees": [
      {
        "id": "lanes",
        "height": -1,
        "nodes": [
          {"id": "root", "label": "Live root", "noun": "lane", "data": {"archived": false}},
          {"id": "old", "parent": "root", "label": "Archived child", "noun": "lane", "data": {"archived": true}},
          {"id": "sub", "parent": "old", "label": "Child of archived", "noun": "lane", "data": {"archived": false}},
          {"id": "keep", "parent": "root", "label": "Live child", "noun": "lane", "data": {"archived": false}}
        ]
      }
    ]
  },
  "script": ["z", "]", "z", "C"],
  "expect": [
    {"after": 0, "contains": ["Live root", "Live child"], "lacks": ["Archived child", "Child of archived"]},
    {"after": 2, "contains": ["[archived]", "Live root", "Archived child"], "lacks": ["Live child", "Child of archived"]},
    {"after": 4, "contains": ["Live root", "Live child"], "lacks": ["Archived child", "[archived]"]}
  ]
}
