{
  "name": "form: path.walk-depth bounds the walk below each root: at 2 the walk lists a/b/ but not a/b/c/",
  "area": "forms",
  "width": 100,
  "height": 20,
  "files": ["a/b/c/d/"],
  "settings": [{"name": "path.walk-depth", "type": "integer", "default": 2}],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "records": [
      {"id": "proj", "fields": [{"name": "folder", "type": "path", "path": "dir", "base": "{{files}}"}]}
    ],
    "pathWalk": {"roots": [{"path": "{{files}}", "label": "project"}]},
    "focus": "proj/folder"
  },
  "script": ["enter", {"job": "chooser.load"}],
  "expect": [
    {"modal": "path-chooser", "contains": ["Choose folder · [walk ", "a/b/"], "lacks": ["a/b/c/"]}
  ]
}
