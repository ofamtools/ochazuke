{
  "name": "form: pasting several lines into a single-line field grows it and keeps the text",
  "area": "forms",
  "page": {
    "records": [
      {
        "id": "task",
        "fields": [
          {
            "name": "title",
            "type": "string"
          }
        ],
        "values": {
          "title": ""
        }
      }
    ],
    "focus": "task/title"
  },
  "script": [
    "w",
    "i",
    {
      "paste": "one\ntwo\nthree"
    },
    "esc"
  ],
  "expect": {
    "contains": [
      "one",
      "two",
      "three"
    ],
    "writes": [
      "write title=\"one\\ntwo\\nthree\""
    ]
  }
}
