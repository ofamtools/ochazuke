{
  "name": "form: with forms.outside-write close a write from outside leaves the editor: the focus goes to the list, the footer drops the form's hints, and e edits again",
  "area": "forms",
  "width": 100,
  "height": 24,
  "settings": [{"name": "forms.outside-write", "type": "string", "default": "close", "enum": ["reload", "close"]}],
  "page": {
    "lists": [{"id": "tasks", "items": [{"id": "t1", "label": "t1"}]}],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label"},
        {"name": "status", "enum": ["todo", "doing", "done"]}
      ],
      "things": [{"id": "t1", "title": "Water the plants", "status": "todo"}]
    },
    "records": [
      {
        "id": "task",
        "thing": "t1",
        "reopen": "e",
        "fields": [
          {"name": "title", "type": "string", "required": true},
          {"name": "status", "type": "string", "required": true, "enum": ["todo", "doing", "done"]}
        ]
      }
    ],
    "focus": "task/title"
  },
  "script": [":", {"type": "demo set t1 status done"}, "enter", "e"],
  "expect": [
    {"after": 3, "focus": "t1", "mode": "normal", "modal": "", "lacks": ["form.leave", "form.undo", "Water the plants"], "noNotices": true},
    {"focus": "task/title", "mode": "normal", "contains": ["Water the plants", "done ▾", "q form.leave"], "noNotices": true}
  ]
}
