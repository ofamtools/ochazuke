{
  "name": "path chooser, search.case smart: typed completion of a lower-case name lists either case, a capital narrows it",
  "area": "forms",
  "width": 100,
  "height": 18,
  "files": ["README.md", "readme.txt", "notes.txt"],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "records": [
      {"id": "doc", "fields": [{"name": "file", "type": "path", "base": "{{files}}"}]}
    ],
    "focus": "doc/file"
  },
  "script": ["enter", {"job": "chooser.load"}, "ctrl+o", "ctrl+o", {"type": "read"}, {"job": "chooser.load"}, "ctrl+u", {"type": "READ"}, {"job": "chooser.load"}],
  "expect": [
    {"after": 4, "contains": ["browse recent [typed]"]},
    {"after": 6, "contains": ["README.md", "readme.txt"], "lacks": ["notes.txt"]},
    {"contains": ["README.md"], "lacks": ["readme.txt", "notes.txt"]}
  ]
}
