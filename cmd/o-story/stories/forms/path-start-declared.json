{
  "name": "form: a path field declaring start recent opens its chooser on recent, though the walk source is listed first",
  "area": "forms",
  "width": 100,
  "height": 20,
  "files": ["a/b/c/"],
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "records": [
      {"id": "proj", "fields": [{"name": "folder", "type": "path", "path": "dir", "base": "{{files}}", "start": "recent"}]}
    ],
    "pathWalk": {"roots": [{"path": "{{files}}", "label": "project"}]},
    "focus": "proj/folder"
  },
  "script": ["enter"],
  "expect": [
    {"modal": "path-chooser", "contains": ["Choose folder · walk ", "[recent"], "lacks": ["[walk"]}
  ]
}
