{
  "area": "choosers",
  "width": 100,
  "height": 18,
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 1
      }
    ],
    "nouns": [
      {
        "noun": "note",
        "props": [
          {
            "name": "by"
          },
          {
            "name": "status"
          }
        ],
        "filters": [
          {
            "name": "mine",
            "where": {
              "by": "owner"
            }
          },
          {
            "name": "agents",
            "where": {
              "by": "agent"
            }
          },
          {
            "name": "all"
          }
        ]
      }
    ],
    "chooser": {
      "kind": "notes",
      "title": "Notes",
      "rows": [
        {
          "id": "n1",
          "label": "Owner alpha",
          "noun": "note",
          "props": {
            "by": "owner",
            "status": "todo"
          }
        },
        {
          "id": "n2",
          "label": "Agent beta",
          "noun": "note",
          "props": {
            "by": "agent",
            "status": "todo"
          }
        },
        {
          "id": "n3",
          "label": "Owner gamma",
          "noun": "note",
          "props": {
            "by": "owner",
            "status": "done"
          }
        }
      ]
    }
  },
  "name": "chooser prop filters cycle",
  "script": [
    "alt+]",
    "ctrl+f",
    "alt+[",
    {
      "type": "alpha"
    },
    "alt+]",
    "alt+]"
  ],
  "expect": [
    {
      "after": 1,
      "contains": [
        "[mine]",
        "Owner alpha",
        "Owner gamma"
      ],
      "lacks": [
        "Agent beta"
      ]
    },
    {
      "after": 2,
      "contains": [
        "[agents]",
        "Agent beta"
      ],
      "lacks": [
        "Owner alpha"
      ]
    },
    {
      "after": 3,
      "contains": [
        "[mine]"
      ]
    },
    {
      "after": 5,
      "contains": [
        "\u203a alpha",
        "[agents]",
        "no matches"
      ]
    },
    {
      "contains": [
        "\u203a alpha",
        "[all]",
        "Owner alpha"
      ],
      "lacks": [
        "Owner gamma"
      ]
    }
  ]
}
