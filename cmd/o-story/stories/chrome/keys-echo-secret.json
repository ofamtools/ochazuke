{
  "name": "chrome: keys.echo shows nothing typed into a secret input, not even how much",
  "area": "chrome",
  "width": 80,
  "values": {"keys.echo": "footer", "keys.echo-typing": "count"},
  "page": {
    "id": "work",
    "inputs": [{"id": "pin", "label": "pin", "secret": true}],
    "focus": "pin"
  },
  "script": ["i", {"type": "hunter2"}, "esc"],
  "expect": {"mode": "normal", "contains": ["pin: hunter2"], "lacks": ["\"hunter2\"", "typed", "esc"]}
}
