{
  "name": "chrome: the accent override applies on top of a user scheme; its error colour stays",
  "area": "chrome",
  "width": 80,
  "theme": "kombu",
  "accent": "#E8833A",
  "themes": {
    "kombu": {
      "background": "dark",
      "accent": "#C9A227",
      "error": "#FF6F61"
    }
  },
  "pages": [
    {
      "id": "work",
      "lists": [
        {
          "id": "a",
          "rows": 2
        }
      ],
      "jobs": [
        {
          "verb": "demo.build",
          "key": "w",
          "failOnKey": "X"
        }
      ]
    },
    {
      "id": "notes",
      "lists": [
        {
          "id": "b",
          "rows": 1
        }
      ]
    }
  ],
  "script": [
    "x",
    "n",
    "w",
    "X",
    {
      "job": "demo.build",
      "state": "failed"
    }
  ],
  "expect": [
    {
      "after": 1,
      "modal": "confirm",
      "colored": {
        "› work": "#172720",
        "╭": "#E8833A"
      },
      "noColor": [
        "#C9A227",
        "#78BFA5"
      ]
    },
    {
      "modal": "",
      "colored": {
        "Error:": "#DCE9E3"
      },
      "noColor": [
        "#C9A227"
      ]
    }
  ]
}
