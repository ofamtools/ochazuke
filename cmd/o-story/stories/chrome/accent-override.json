{
  "name": "chrome: an accent override recolours the title, active tab and modal border; errors keep their colour",
  "area": "chrome",
  "width": 80,
  "theme": "adaptive",
  "accent": "#E8833A",
  "pages": [
    {
      "id": "work",
      "lists": [
        {
          "id": "a",
          "rows": 2
        }
      ],
      "jobs": [
        {
          "verb": "demo.build",
          "key": "w",
          "failOnKey": "X"
        }
      ]
    },
    {
      "id": "notes",
      "lists": [
        {
          "id": "b",
          "rows": 1
        }
      ]
    }
  ],
  "script": [
    "x",
    "n",
    "w",
    "X",
    {
      "job": "demo.build",
      "state": "failed"
    }
  ],
  "expect": [
    {
      "after": 1,
      "modal": "confirm",
      "colored": {
        "◆ o-story": "#E8833A",
        "› work": "#E8833A",
        "╭": "#E8833A",
        "Delete a1?": "#E8833A"
      },
      "noColor": [
        "#78BFA5"
      ]
    },
    {
      "modal": "",
      "contains": [
        "Error:"
      ],
      "colored": {
        "Error:": "#E99B8D",
        "› work": "#E8833A"
      },
      "noColor": [
        "#78BFA5"
      ]
    }
  ]
}
