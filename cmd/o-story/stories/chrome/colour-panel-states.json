  "width": 60,
  "height": 22,
  "theme": "dark",
  "page": {
    "layout": "panels",
    "noHeadings": true,
    "lists": [
      {"id": "working", "rows": 1, "panelTone": "state.working"},
      {"id": "needs", "rows": 1, "panelTone": "state.needs-input"},
      {"id": "done", "rows": 1, "panelTone": "state.done"},
      {"id": "shell", "rows": 1}
    ]
  },
  "script": [
    ":", {"type": "set chrome.color=rich"}, "enter",
