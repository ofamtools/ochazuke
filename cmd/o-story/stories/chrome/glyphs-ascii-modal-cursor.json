{
  "name": "ASCII modal keeps the input cursor and mode",
  "area": "chrome",
  "width": 60,
  "height": 20,
  "theme": "dark",
  "config": {
    "settings.json": {
      "chrome.glyphs": "ascii"
    }
  },
  "page": {
    "inputs": [
      {
        "id": "name",
        "text": "日本語",
        "label": "Name"
      }
    ]
  },
  "script": [
    ":",
    {
      "type": "page"
    },
    "esc", "q", "q",
    "esc"
  ],
  "expect": [
    {
      "after": 2,
      "modal": "palette",
      "mode": "insert",
      "contains": [
        ": page"
      ]
    },
    {
      "modal": "",
      "focus": "name",
      "contains": [
        "??????"
      ]
    }
  ]
}
