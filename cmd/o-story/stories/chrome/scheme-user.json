{
  "name": "chrome: a user scheme recolours the accent, borders and errors; roles it leaves out keep the built-in palette",
  "area": "chrome",
  "width": 80,
  "theme": "kombu",
  "themes": {
    "kombu": {
      "background": "dark",
      "accent": "#C9A227",
      "border": "#5C4A1E",
      "error": {
        "light": "#B3261E",
        "dark": "#FF6F61"
      }
    }
  },
  "pages": [
    {
      "id": "work",
      "lists": [
        {
          "id": "a",
          "rows": 2
        }
      ],
      "jobs": [
        {
          "verb": "demo.build",
          "key": "w",
          "failOnKey": "X"
        }
      ]
    },
    {
      "id": "notes",
      "lists": [
        {
          "id": "b",
          "rows": 1
        }
      ]
    }
  ],
  "script": [
    "x",
    "n",
    "w",
    "X",
    {
      "job": "demo.build",
      "state": "failed"
    }
  ],
  "expect": [
    {
      "after": 1,
      "modal": "confirm",
      "colored": {
        "◆ o-story": "#DCE9E3",
        "› work": "#C9A227",
        "╭": "#C9A227"
      },
      "noColor": [
        "#78BFA5",
        "#465D55"
      ]
    },
    {
      "modal": "",
      "contains": [
        "Error:"
      ],
      "colored": {
        "Error:": "#FF6F61",
        "› work": "#C9A227"
      },
      "noColor": [
        "#E99B8D",
        "#78BFA5"
      ],
      "noNotices": true
    }
  ]
}
