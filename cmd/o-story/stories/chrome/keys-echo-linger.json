{
  "name": "chrome: a key echo entry goes keys.echo-linger after its last key, on the linger timer",
  "area": "chrome",
  "width": 80,
  "values": {"keys.echo": "footer", "keys.echo-linger": "2s"},
  "page": {
    "id": "work",
    "lists": [{"id": "a", "rows": 10}]
  },
  "script": ["3", "j", {"tick": "linger"}],
  "expect": [
    {"after": 2, "focus": "a4", "contains": ["3j"]},
    {"after": 3, "focus": "a4", "lacks": ["3j"]}
  ]
}
