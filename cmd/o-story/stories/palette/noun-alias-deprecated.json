{
  "name": "palette: a deprecated noun alias (json-doc, since v0.57.0) still runs, with one notice naming the noun, and is never completed",
  "area": "palette",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "nouns": [
      {"noun": "json.doc", "verbs": ["rows"], "aliases": [{"alias": "doc"}, {"alias": "json-doc", "since": "v0.57.0", "removeAfter": "v0.58.0"}]}
    ]
  },
  "script": [":", {"type": "json"}, {"type": "-doc rows"}, "enter", ":", {"type": "json-doc rows"}, "enter"],
  "expect": [
    {"after": 2, "contains": ["json · namespace"], "lacks": ["json-doc"]},
    {"after": 4, "writes": ["json.doc.rows"], "notices": ["json-doc is an old name of doc (renamed in v0.57.0; removed after v0.58.0)"]},
    {"writes": ["json.doc.rows", "json.doc.rows"], "modal": "", "lacks": ["(+1 more)"]}
  ]
}
