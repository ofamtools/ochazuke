{
  "name": "with palette.marker arrow the palette marks the focused completion with > and highlights nothing until ctrl+n",
  "area": "palette",
  "settings": [
    {
      "name": "palette.marker",
      "type": "string",
      "default": "arrow",
      "enum": ["line", "arrow"]
    }
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 3
      }
    ]
  },
  "script": [
    ":",
    "ctrl+n"
  ],
  "expect": [
    {
      "after": 1,
      "highlighted": 0,
      "dimmed": 1,
      "mode": "insert",
      "lacks": [
        "> "
      ]
    },
    {
      "highlighted": 0,
      "dimmed": 1,
      "contains": [
        "> accept"
      ]
    }
  ]
}
