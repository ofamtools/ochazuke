{
  "name": "board: letters narrow the cells and the one cell left commits itself; the second word is a verb of that noun and runs when one is left",
  "area": "palette",
  "settings": [{"name": "palette.style", "type": "string", "default": "board", "enum": ["classic", "board"]}],
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "nouns": [{"noun": "quad", "verbs": ["warp", "wipe"]}, {"noun": "quill", "verbs": ["wipe"]}]
  },
  "script": [":", {"type": "qu"}, {"type": "a"}, {"type": "wa"}],
  "expect": [
    {"after": 1, "modal": "palette", "contains": ["nouns (", "verbs ("]},
    {"after": 2, "modal": "palette", "contains": ["quad", "quill"]},
    {"after": 3, "modal": "palette", "contains": ["verbs of quad", "warp", "wipe"], "lacks": ["quill"]},
    {"modal": "", "writes": ["quad.warp"]}
  ]
}
