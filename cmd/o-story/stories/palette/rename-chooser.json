{
  "name": "standard rename with no name opens the args form on the old name, selected (rename.select), so typing replaces it; on an untitled row the field starts empty with the fallback (the summary) as its placeholder",
  "area": "palette",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [{"id": "tasks", "items": [{"id": "t1", "label": "t1"}, {"id": "t2", "label": "t2"}]}],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label", "fallback": "summary"},
        {"name": "summary", "readOnly": true}
      ],
      "things": [
        {"id": "t1", "title": "Water the plants", "summary": ""},
        {"id": "t2", "title": "", "summary": "Call the plumber"}
      ]
    }
  },
  "script": [":", {"type": "demo rename"}, "enter", {"type": "Feed the cat"}, "enter", "j", ":", {"type": "demo rename"}, "enter"],
  "expect": [
    {"after": 3, "modal": "args-form", "focus": "args-form/name", "mode": "insert", "attrs": {"Water the plants": "reverse"}, "writes": ["get t1"]},
    {"after": 5, "modal": "", "writes": ["get t1", "set t1 title=Feed the cat"]},
    {"modal": "args-form", "focus": "args-form/name", "mode": "insert", "contains": ["Call the plumber"]}
  ]
}
