{
  "name": "r bound to edit {field: @label} opens a one-field form on the old label, selected (rename.select), so typing replaces it; on an untitled row the field starts empty with the fallback (the summary) as its placeholder",
  "area": "palette",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [
      {
        "id": "tasks",
        "items": [
          {
            "id": "t1",
            "label": "t1",
            "props": {
              "id": "t1"
            }
          },
          {
            "id": "t2",
            "label": "t2",
            "props": {
              "id": "t2"
            }
          }
        ]
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label",
          "fallback": "summary"
        },
        {
          "name": "summary",
          "readOnly": true
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants",
          "summary": ""
        },
        {
          "id": "t2",
          "title": "",
          "summary": "Call the plumber"
        }
      ]
    },
    "bind": [
      {
        "noun": "demo",
        "mode": "normal",
        "keys": "r",
        "do": "demo.edit",
        "args": {
          "field": "@label"
        }
      }
    ]
  },
  "script": [
    "r",
    {
      "type": "Feed the cat"
    },
    "esc",
    "q",
    ":",
    {
      "type": "demo get t1"
    },
    "enter",
    "q",
    "j",
    "r"
  ],
  "expect": [
    {
      "after": 1,
      "modal": "edit-form",
      "focus": "edit-form/title",
      "mode": "insert",
      "attrs": {
        "Water the plants": "reverse"
      }
    },
    {
      "after": 4,
      "modal": ""
    },
    {
      "after": 7,
      "modal": "palette-results",
      "contains": [
        "title",
        "Feed the cat"
      ]
    },
    {
      "modal": "edit-form",
      "focus": "edit-form/title",
      "mode": "insert",
      "contains": [
        "Call the plumber"
      ]
    }
  ]
}
