{
  "name": "m bound to edit {field: @owner} opens the owner reference's chooser (the owner noun's things, the project rows) in place of a one-field form; the pick writes the owner reference, closes the chooser and returns the focus to the row",
  "area": "palette",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [
      {
        "id": "tasks",
        "items": [
          {
            "id": "t1",
            "label": "t1",
            "props": {
              "id": "t1"
            }
          },
          {
            "id": "t2",
            "label": "t2",
            "props": {
              "id": "t2"
            }
          }
        ]
      },
      {
        "id": "projects",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "noun": "project"
          },
          {
            "id": "work",
            "label": "Work",
            "noun": "project"
          }
        ]
      }
    ],
    "store": {
      "props": [
        {
          "name": "id",
          "key": true
        },
        {
          "name": "title",
          "role": "label"
        },
        {
          "name": "project",
          "noun": "project",
          "role": "owner"
        }
      ],
      "things": [
        {
          "id": "t1",
          "title": "Water the plants",
          "project": "home"
        },
        {
          "id": "t2",
          "title": "Write notes",
          "project": "home"
        }
      ]
    },
    "bind": [
      {
        "noun": "demo",
        "mode": "normal",
        "keys": "m",
        "do": "demo.edit",
        "args": {
          "field": "@owner"
        }
      }
    ],
    "focus": "t1"
  },
  "script": [
    "m",
    {
      "type": "Wo"
    },
    "enter",
    ":",
    {
      "type": "demo get t1"
    },
    "enter",
    "q"
  ],
  "expect": [
    {
      "after": 1,
      "modal": "edit-choose",
      "contains": [
        "Edit demo project: t1",
        "Home",
        "Work"
      ]
    },
    {
      "after": 3,
      "modal": "",
      "focus": "t1",
      "mode": "normal"
    },
    {
      "after": 6,
      "modal": "palette-results",
      "contains": [
        "project",
        "work"
      ]
    },
    {
      "modal": "",
      "focus": "t1"
    }
  ]
}
