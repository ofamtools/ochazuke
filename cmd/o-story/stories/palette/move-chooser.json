{
  "name": "standard move with no destination opens the args form on to, a choice of the owner noun's things (the project rows); the pick writes the owner reference",
  "area": "palette",
  "width": 100,
  "height": 30,
  "page": {
    "lists": [
      {"id": "tasks", "items": [{"id": "t1", "label": "t1"}, {"id": "t2", "label": "t2"}]},
      {"id": "projects", "items": [{"id": "home", "label": "Home", "noun": "project"}, {"id": "work", "label": "Work", "noun": "project"}]}
    ],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label"},
        {"name": "project", "noun": "project", "role": "owner"}
      ],
      "things": [
        {"id": "t1", "title": "Water the plants", "project": "home"},
        {"id": "t2", "title": "Write notes", "project": "home"}
      ]
    }
  },
  "script": [":", {"type": "demo move"}, "enter", "enter", {"type": "Wo"}, "enter", "enter"],
  "expect": [
    {"after": 3, "modal": "args-form", "focus": "args-form/to", "contains": ["to"]},
    {"after": 4, "contains": ["Choose to", "Home", "Work"]},
    {"modal": "", "writes": ["set t1 project=work"]}
  ]
}
