{
  "name": "palette: an exact noun alias beats prefix completion: doc rows runs json.doc (aliased doc), though doc is a prefix of docsets; the noun is drawn by its alias",
  "area": "palette",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "nouns": [
      {"noun": "json.doc", "verbs": ["rows"], "aliases": [{"alias": "doc"}, {"alias": "json-doc"}]},
      {"noun": "docsets", "verbs": ["rows"]}
    ]
  },
  "script": [":", {"type": "doc"}, {"type": " rows"}, "enter", ":", {"type": "json-doc rows"}, "enter"],
  "expect": [
    {"after": 2, "contains": ["doc", "docsets"], "lacks": ["json.doc", "json-doc"]},
    {"after": 3, "lacks": ["is ambiguous", "names no"]},
    {"after": 4, "writes": ["json.doc.rows"], "modal": ""},
    {"writes": ["json.doc.rows", "json.doc.rows"], "modal": "", "noNotices": true}
  ]
}
