{
  "name": "a second text result while the text view is open (:demo program, then :demo mapping) shows the new answer in the same view, from the top, never a silent no-op (R4.8); esc closes it back on the row",
  "area": "palette",
  "width": 80,
  "height": 24,
  "page": {"lists": [{"id": "a", "rows": 3}], "focus": "a2"},
  "script": [":", {"type": "demo program"}, "enter", ":", {"type": "demo mapping"}, "enter", "esc"],
  "expect": [
    {"after": 3, "modal": "text-view", "contains": ["demo.program", ".items[] | {name, size: .bytes}"]},
    {"after": 6, "modal": "text-view", "mode": "normal", "contains": ["demo.mapping", "\"name\": \".title\","], "lacks": ["demo.program", ".items[] | {name"]},
    {"modal": "", "focus": "a2", "mode": "normal"}
  ]
}
