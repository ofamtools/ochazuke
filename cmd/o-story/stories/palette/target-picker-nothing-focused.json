{
  "name": "palette: a command on a noun that is not focused asks for the target with the noun's picker, then runs (classic style)",
  "area": "palette",
  "width": 100,
  "height": 30,
  "page": {
    "inputs": [{"id": "q", "label": "query"}],
    "verbs": [{"verb": "swatch.names", "description": "List the swatches", "rows": ["alpha", "beta", "gamma"]},
              {"verb": "swatch.paint", "description": "Paint a swatch", "positional": ["swatch"],
               "parameters": {"swatch": {"type": "string", "noun": "swatch", "focus": true, "free": true, "source": "swatch.names", "description": "The swatch to paint"}}}]
  },
  "script": [":", {"type": "swatch paint"}, "enter", "enter", {"type": "be"}, "enter", "enter"],
  "expect": [
    {"after": 3, "modal": "args-form", "lacks": ["unavailable", "needs a focused", "(optional)"], "contains": ["swatch"]},
    {"after": 4, "contains": ["Choose swatch", "alpha", "beta", "gamma"]},
    {"after": 5, "contains": ["beta"], "lacks": ["gamma"]},
    {"modal": "", "writes": ["swatch.names", "swatch.names", "swatch.paint swatch=beta"]}
  ]
}
