{
  "name": "palette: punctuation narrows the reading (lexicon.punctuation): rows, md.doc is action, noun and json.doc.rows is noun.action",
  "area": "palette",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 2}],
    "nouns": [
      {"noun": "json.doc", "verbs": ["rows"]},
      {"noun": "md.doc", "verbs": ["rows"]}
    ]
  },
  "script": [":", {"type": "rows, md.doc"}, "enter", ":", {"type": "json.doc.rows"}, "enter"],
  "expect": [
    {"after": 3, "writes": ["md.doc.rows"]},
    {"writes": ["md.doc.rows", "json.doc.rows"]}
  ]
}
