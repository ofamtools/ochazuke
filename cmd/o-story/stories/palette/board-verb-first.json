{
  "name": "board: a verb first, then only the nouns that have it; the pair runs the same operation as noun first",
  "area": "palette",
  "settings": [{"name": "palette.style", "type": "string", "default": "board", "enum": ["classic", "board"]}],
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "nouns": [{"noun": "quad", "verbs": ["warp", "wipe"]}, {"noun": "quill", "verbs": ["wipe"]}]
  },
  "script": [":", {"type": "wi"}, {"type": "quil"}],
  "expect": [
    {"after": 2, "modal": "palette", "contains": ["nouns that have wipe", "quad", "quill"], "lacks": ["verbs of"]},
    {"modal": "", "writes": ["quill.wipe"]}
  ]
}
