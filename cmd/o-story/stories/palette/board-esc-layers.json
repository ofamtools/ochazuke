{
  "name": "board: backspace and esc go back a layer; esc from an empty line closes",
  "area": "palette",
  "settings": [{"name": "palette.style", "type": "string", "default": "board", "enum": ["classic", "board"]}],
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "nouns": [{"noun": "quad", "verbs": ["warp", "wipe"]}, {"noun": "quill", "verbs": ["wipe"]}]
  },
  "script": [":", {"type": "quad"}, {"type": "w"}, "esc", "esc", "esc"],
  "expect": [
    {"after": 2, "modal": "palette", "contains": ["verbs of quad"]},
    {"after": 3, "modal": "palette", "contains": ["warp", "wipe"]},
    {"after": 4, "modal": "palette", "contains": ["verbs of quad"]},
    {"after": 5, "modal": "palette", "contains": ["nouns ("], "lacks": ["verbs of"]},
    {"modal": ""}
  ]
}
