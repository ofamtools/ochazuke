{
  "name": "a key whose action lacks only a path opens the path chooser at once (forms.single-path chooser, the default): typing reaches it, enter on a file runs the action with it (R7.8, P9)",
  "area": "palette",
  "width": 100,
  "height": 24,
  "files": [
    "doc.json",
    "other.json",
    "sub/"
  ],
  "page": {
    "lists": [
      {
        "id": "a",
        "rows": 2
      }
    ],
    "verbs": [
      {
        "verb": "demo.load",
        "description": "Open a file",
        "parameters": {
          "path": {
            "type": "path",
            "required": true,
            "base": "{{files}}",
            "description": "The file"
          }
        }
      }
    ],
    "bind": [
      {
        "noun": "app",
        "keys": "e",
        "do": "demo.load"
      }
    ]
  },
  "script": [
    "e",
    {
      "job": "chooser.load"
    },
    {
      "type": "oth"
    },
    "enter"
  ],
  "expect": [
    {
      "after": 1,
      "modal": "path-chooser",
      "mode": "insert"
    },
    {
      "after": 3,
      "modal": "path-chooser",
      "contains": [
        "other.json"
      ],
      "lacks": [
        "doc.json"
      ]
    },
    {
      "modal": "",
      "focus": "a1",
      "writes": [
        "demo.load path={{files}}/other.json"
      ]
    }
  ]
}
