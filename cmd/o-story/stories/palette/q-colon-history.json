{
  "name": "Q: opens the command line on the last command (Vim's command-line window, q: there); esc twice closes it and Q a still records a macro",
  "area": "palette",
  "page": {
    "inputs": [
      {
        "id": "name",
        "label": "name",
        "text": "hello"
      }
    ]
  },
  "script": [
    ":",
    {
      "type": "notice clear"
    },
    "enter",
    "Q",
    ":",
    "esc",
    "esc",
    "Q",
    "a"
  ],
  "expect": [
    {
      "after": 3,
      "modal": ""
    },
    {
      "after": 5,
      "modal": "palette",
      "mode": "insert",
      "contains": [
        "clear notice"
      ]
    },
    {
      "modal": "",
      "mode": "normal",
      "contains": [
        "REC @a"
      ]
    }
  ]
}
