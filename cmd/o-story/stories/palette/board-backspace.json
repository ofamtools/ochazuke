{
  "name": "board: backspace after a committed word takes the word back to the first layer",
  "area": "palette",
  "settings": [{"name": "palette.style", "type": "string", "default": "board", "enum": ["classic", "board"]}],
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "a", "rows": 1}],
    "nouns": [{"noun": "quad", "verbs": ["warp", "wipe"]}, {"noun": "quill", "verbs": ["wipe"]}]
  },
  "script": [":", {"type": "quad"}, "backspace"],
  "expect": [
    {"after": 2, "modal": "palette", "contains": ["verbs of quad"]},
    {"modal": "palette", "contains": ["nouns ("], "lacks": ["verbs of"]}
  ]
}
