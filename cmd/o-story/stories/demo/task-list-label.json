{
  "name": "standard list on a store noun: :demo list (props title: id, label and title columns) opens the results with each task's label, the summary where the title is empty",
  "area": "demo",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "tasks", "items": [{"id": "t1", "label": "t1"}, {"id": "t2", "label": "t2"}, {"id": "t3", "label": "t3"}]}],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label", "fallback": "summary"},
        {"name": "status", "enum": ["todo", "doing", "done"]},
        {"name": "summary", "readOnly": true}
      ],
      "things": [
        {"id": "t1", "title": "Water the plants", "status": "todo", "summary": ""},
        {"id": "t2", "title": "Write notes", "status": "doing", "summary": ""},
        {"id": "t3", "title": "", "status": "todo", "summary": "Call the plumber"}
      ]
    }
  },
  "script": [":", {"type": "demo list 0 title"}, "enter"],
  "expect": {"writes": ["list"], "modal": "palette-results", "contains": ["Water the plants", "Write notes", "Call the plumber"], "noNotices": true, "lacks": ["doing"]}
}
