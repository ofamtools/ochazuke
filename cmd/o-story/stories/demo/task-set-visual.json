{
  "name": "standard set over a visual selection: V j then D (demo.set status done) writes each selected row's task once, in order, one notice counts the rows; the row left out is not written",
  "area": "demo",
  "width": 100,
  "height": 24,
  "page": {
    "lists": [{"id": "tasks", "items": [{"id": "t1", "label": "t1"}, {"id": "t2", "label": "t2"}, {"id": "t3", "label": "t3"}]}],
    "store": {
      "props": [
        {"name": "id", "key": true},
        {"name": "title", "role": "label", "fallback": "summary"},
        {"name": "status", "enum": ["todo", "doing", "done"]},
        {"name": "summary", "readOnly": true}
      ],
      "things": [
        {"id": "t1", "title": "Water the plants", "status": "todo", "summary": ""},
        {"id": "t2", "title": "Write notes", "status": "doing", "summary": ""},
        {"id": "t3", "title": "", "status": "todo", "summary": "Call the plumber"}
      ]
    },
    "bind": [
      {"noun": "demo", "mode": "visual-line", "keys": "D", "do": "demo.set", "args": {"prop": "status", "value": "done"}}
    ]
  },
  "script": ["V", "j", "D"],
  "expect": [
    {"after": 2, "writes": [], "modal": ""},
    {"writes": ["set t1 status=done", "set t2 status=done"], "contains": ["done on 2 rows"], "modal": ""}
  ]
}
