// ochazuke bindings (JSONC): groups by "noun/mode" context; one row per line, {key, action, args, hint, ...} or {key, unbind: true}; a key may repeat: the first row whose action is available answers
{
  "bindings": [
    {"context": "ochazuke.markdown-line/normal", "bindings": [
      {"key": "j", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "down", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "k", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}},
      {"key": "up", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}}
    ]},
    {"context": "ochazuke.markdown-line/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-task/normal", "bindings": [
      {"key": "j", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "down", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "k", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}},
      {"key": "up", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}}
    ]},
    {"context": "ochazuke.markdown-task/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-note/normal", "bindings": [
      {"key": "j", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "down", "action": "ochazuke.markdown.move", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "k", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}},
      {"key": "up", "action": "ochazuke.markdown.move", "args": {"delta": -1}, "from": {"steps": "count"}}
    ]},
    {"context": "ochazuke.markdown-note/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown/normal", "bindings": [
      {"key": "enter", "action": "ochazuke.markdown.link-open", "when": "markdown-on-link"},
      {"key": "g x", "action": "ochazuke.markdown.link-open", "when": "markdown-on-link"},
      {"key": "y l", "action": "ochazuke.markdown.link-copy", "when": "markdown-on-link"},
      {"key": "] u", "action": "ochazuke.markdown.next-link", "from": {"steps": "count"}},
      {"key": "[ u", "action": "ochazuke.markdown.previous-link", "from": {"steps": "count"}},
      {"key": "x", "action": "ochazuke.markdown.toggle", "when": "markdown-on-task"},
      {"key": "i", "action": "ochazuke.markdown.insert", "args": {"at": "cursor"}},
      {"key": "o", "action": "ochazuke.markdown.open", "args": {"where": "below"}},
      {"key": "n", "action": "ochazuke.markdown.note", "when": "markdown-on-item"},
      {"key": "d d", "action": "ochazuke.markdown.delete"},
      {"key": "p", "action": "ochazuke.markdown.paste", "args": {"where": "below"}},
      {"key": "z a", "action": "ochazuke.markdown.fold", "when": "markdown-has-notes"},
      {"key": "g O", "action": "ochazuke.markdown.outline"},
      {"key": "u", "action": "ochazuke.markdown.undo"},
      {"key": "ctrl+r", "action": "ochazuke.markdown.redo"},
      {"key": "}", "action": "ochazuke.markdown.next-block", "from": {"steps": "count"}},
      {"key": "{", "action": "ochazuke.markdown.previous-block", "from": {"steps": "count"}},
      {"key": "] ]", "action": "ochazuke.markdown.next-same", "from": {"steps": "count"}, "hidden": true},
      {"key": "[ [", "action": "ochazuke.markdown.previous-same", "from": {"steps": "count"}, "hidden": true},
      {"key": "a", "action": "ochazuke.markdown.insert", "args": {"at": "after"}, "hidden": true},
      {"key": "I", "action": "ochazuke.markdown.insert", "args": {"at": "start"}, "hidden": true},
      {"key": "A", "action": "ochazuke.markdown.insert", "args": {"at": "end"}, "hidden": true},
      {"key": "O", "action": "ochazuke.markdown.open", "args": {"where": "above"}, "hidden": true},
      {"key": "y y", "action": "ochazuke.markdown.yank", "hidden": true},
      {"key": "P", "action": "ochazuke.markdown.paste", "args": {"where": "above"}, "hidden": true},
      {"key": "] h", "action": "ochazuke.markdown.next-kind", "args": {"kind": "h"}, "from": {"steps": "count"}},
      {"key": "[ h", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "h"}, "from": {"steps": "count"}},
      {"key": "] t", "action": "ochazuke.markdown.next-kind", "args": {"kind": "t"}, "from": {"steps": "count"}},
      {"key": "[ t", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "t"}, "from": {"steps": "count"}},
      {"key": "] x", "action": "ochazuke.markdown.next-kind", "args": {"kind": "x"}, "from": {"steps": "count"}},
      {"key": "[ x", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "x"}, "from": {"steps": "count"}},
      {"key": "] l", "action": "ochazuke.markdown.next-kind", "args": {"kind": "l"}, "from": {"steps": "count"}},
      {"key": "[ l", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "l"}, "from": {"steps": "count"}},
      {"key": "] c", "action": "ochazuke.markdown.next-kind", "args": {"kind": "c"}, "from": {"steps": "count"}},
      {"key": "[ c", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "c"}, "from": {"steps": "count"}},
      {"key": "] q", "action": "ochazuke.markdown.next-kind", "args": {"kind": "q"}, "from": {"steps": "count"}},
      {"key": "[ q", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "q"}, "from": {"steps": "count"}},
      {"key": "] n", "action": "ochazuke.markdown.next-kind", "args": {"kind": "n"}, "from": {"steps": "count"}},
      {"key": "[ n", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "n"}, "from": {"steps": "count"}},
      {"key": "] p", "action": "ochazuke.markdown.next-kind", "args": {"kind": "p"}, "from": {"steps": "count"}},
      {"key": "[ p", "action": "ochazuke.markdown.previous-kind", "args": {"kind": "p"}, "from": {"steps": "count"}}
    ]},
    {"context": "ochazuke.markdown-view/normal", "bindings": [
      {"key": "q", "action": "ochazuke.modal.pop", "hint": "close"},
      {"key": "y a", "action": "ochazuke.markdown-view.copy", "hint": "copy all"},
      {"key": "/", "action": "ochazuke.search.find", "hint": "find"},
      {"key": "n", "action": "ochazuke.search.next", "from": {"count": "count"}, "hidden": true},
      {"key": "N", "action": "ochazuke.search.next", "args": {"reverse": true}, "from": {"count": "count"}, "hidden": true}
    ]},
    {"context": "ochazuke.markdown-view/count_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-edit/insert", "bindings": [
      {"key": "esc", "action": "ochazuke.markdown.leave"},
      {"key": "enter", "action": "ochazuke.markdown.end-list", "when": "markdown-empty-item"},
      {"key": "enter", "action": "ochazuke.markdown.continue-item", "when": "markdown-item-text"},
      {"key": "enter", "action": "ochazuke.markdown.next-row", "when": "markdown-table-line"},
      {"key": "enter", "action": "ochazuke.markdown.after-heading", "when": "markdown-heading-line"},
      {"key": "enter", "action": "ochazuke.markdown.quote-line", "when": "markdown-quote-line"},
      {"key": "tab", "action": "ochazuke.markdown.indent", "when": "markdown-item-line"},
      {"key": "shift+tab", "action": "ochazuke.markdown.outdent", "when": "markdown-item-line"},
      {"key": "tab", "action": "ochazuke.markdown.cell", "args": {"delta": 1}, "when": "markdown-table-line"},
      {"key": "shift+tab", "action": "ochazuke.markdown.cell", "args": {"delta": -1}, "when": "markdown-table-line"},
      {"key": "backspace", "action": "ochazuke.markdown.unmark", "when": "markdown-empty-item"},
      {"key": "alt+/", "action": "ochazuke.markdown.insert-block", "when": "markdown-empty-line"}
    ]},
    {"context": "ochazuke.markdown-note/normal", "bindings": [
      {"key": "x", "action": "ochazuke.markdown.resolve"}
    ]},
    {"context": "ochazuke.markdown/leader_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-line/leader_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-task/leader_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown-note/leader_pending", "extends": "normal", "bindings": []},
    {"context": "ochazuke.markdown/count_pending", "extends": "normal", "bindings": []}
  ]
}
