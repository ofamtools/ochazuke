{
  "pending": ["count_pending", "visual_count_pending", "operator_pending", "operator_g_pending", "g_pending"],
  "extends": {"visual-line": "visual", "visual-block": "visual", "count_pending": "normal", "visual_count_pending": "visual"},
  "maps": {
    "motion": {"h": "left", "left": "left", "l": "right", "right": "right", "j": "down", "down": "down", "k": "up", "up": "up", "w": "word-forward", "b": "word-backward", "e": "word-end", "0": "line-start", "home": "line-start", "$": "line-end", "end": "line-end", "G": "last-line"},
    "insertion": {"i": "insert", "a": "append", "I": "first", "A": "end", "o": "below", "O": "above"},
    "operator": {"y": "y", "d": "d", "c": "c"},
    "shape": {"v": "char", "V": "line", "ctrl+v": "block"},
    "readline-motion": {"ctrl+a": "line-start", "home": "line-start", "ctrl+e": "line-end", "end": "line-end", "ctrl+b": "left", "left": "left", "ctrl+f": "right", "right": "right", "ctrl+p": "up", "up": "up", "ctrl+n": "down", "down": "down", "alt+b": "word-previous", "alt+f": "word-next"},
    "kill": {"ctrl+w": "word-backward", "ctrl+u": "line-start", "ctrl+k": "line-end"}
  },
  "rows": [
    {"mode": "normal", "expand": "motion", "request": {"verb": "move", "noun": "input", "args": {"motion": "$"}}, "from": {"steps": "count", "line": "line"}},
    {"mode": "normal", "expand": "insertion", "request": {"verb": "begin", "noun": "input", "args": {"position": "$"}}},
    {"mode": "normal", "expand": "operator", "request": {"verb": "enter", "noun": "mode", "args": {"mode": "operator_pending", "op": "$"}}, "from": {"opcount": "count"}},
    {"mode": "normal", "expand": "shape", "request": {"verb": "select", "noun": "input", "args": {"shape": "$"}}},
    {"mode": "normal", "keys": "x", "request": {"verb": "delete", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "delete", "request": {"verb": "delete", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "u", "request": {"verb": "undo", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "ctrl+r", "request": {"verb": "redo", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "p", "request": {"verb": "paste", "noun": "input", "args": {"before": false}}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "P", "request": {"verb": "paste", "noun": "input", "args": {"before": true}}, "from": {"steps": "count"}},
    {"mode": "normal", "keys": "g", "request": {"verb": "enter", "noun": "mode", "args": {"mode": "g_pending"}}, "from": {"count": "count"}},

    {"mode": "count_pending", "keys": "esc", "request": {"verb": "cancel", "noun": "input"}},
    {"mode": "count_pending", "pattern": "any", "request": {"verb": "leave", "noun": "mode"}, "replay": true},

    {"mode": "visual", "expand": "motion", "request": {"verb": "move", "noun": "input", "args": {"motion": "$"}}, "from": {"steps": "count", "line": "line"}},
    {"mode": "visual", "expand": "operator", "request": {"verb": "operator", "noun": "input", "args": {"operator": "$"}}},
    {"mode": "visual", "expand": "shape", "request": {"verb": "select", "noun": "input", "args": {"shape": "$"}}},
    {"mode": "visual", "expand": "insertion", "request": {"verb": "cancel", "noun": "input"}},
    {"mode": "visual", "keys": "x", "request": {"verb": "operator", "noun": "input", "args": {"operator": "d"}}},
    {"mode": "visual", "keys": "delete", "request": {"verb": "operator", "noun": "input", "args": {"operator": "d"}}},
    {"mode": "visual", "keys": "u", "request": {"verb": "undo", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "visual", "keys": "ctrl+r", "request": {"verb": "redo", "noun": "input"}, "from": {"steps": "count"}},
    {"mode": "visual", "keys": "p", "request": {"verb": "paste", "noun": "input", "args": {"before": false}}, "from": {"steps": "count"}},
    {"mode": "visual", "keys": "P", "request": {"verb": "paste", "noun": "input", "args": {"before": true}}, "from": {"steps": "count"}},
    {"mode": "visual", "keys": "esc", "request": {"verb": "cancel", "noun": "input"}},
    {"mode": "visual", "keys": "g", "request": {"verb": "enter", "noun": "mode", "args": {"mode": "g_pending"}}, "from": {"count": "count"}},
    {"mode": "visual", "pattern": "digit-0", "request": {"verb": "enter", "noun": "mode", "args": {"mode": "visual_count_pending"}}, "from": {"count": "digit"}},

    {"mode": "visual_count_pending", "keys": "0", "request": {"verb": "append", "noun": "count", "args": {"digit": 0}}},
    {"mode": "visual_count_pending", "pattern": "digit", "request": {"verb": "append", "noun": "count"}, "from": {"digit": "digit"}},
    {"mode": "visual_count_pending", "keys": "esc", "request": {"verb": "cancel", "noun": "input"}},
    {"mode": "visual_count_pending", "pattern": "any", "request": {"verb": "leave", "noun": "mode"}, "replay": true},

    {"mode": "operator_pending", "keys": "0", "when": "count", "request": {"verb": "append", "noun": "count", "args": {"digit": 0}}},
    {"mode": "operator_pending", "expand": "motion", "request": {"verb": "operator", "noun": "input", "args": {"motion": "$"}}, "from": {"operator": "op", "steps": "steps", "line": "line"}},
    {"mode": "operator_pending", "keys": "y", "when": "op:y", "request": {"verb": "operator", "noun": "input", "args": {"operator": "y", "motion": "line"}}, "from": {"steps": "steps"}},
    {"mode": "operator_pending", "keys": "d", "when": "op:d", "request": {"verb": "operator", "noun": "input", "args": {"operator": "d", "motion": "line"}}, "from": {"steps": "steps"}},
    {"mode": "operator_pending", "keys": "c", "when": "op:c", "request": {"verb": "operator", "noun": "input", "args": {"operator": "c", "motion": "line"}}, "from": {"steps": "steps"}},
    {"mode": "operator_pending", "keys": "g", "request": {"verb": "enter", "noun": "mode", "args": {"mode": "operator_g_pending"}}, "from": {"op": "op", "count": "count", "opcount": "opcount"}},
    {"mode": "operator_pending", "pattern": "digit-0", "request": {"verb": "append", "noun": "count"}, "from": {"digit": "digit"}},
    {"mode": "operator_pending", "keys": "esc", "request": {"verb": "cancel", "noun": "input"}},
    {"mode": "operator_pending", "pattern": "any", "request": {"verb": "cancel", "noun": "input"}},

    {"mode": "operator_g_pending", "keys": "g", "request": {"verb": "operator", "noun": "input", "args": {"motion": "first-line"}}, "from": {"operator": "op", "steps": "steps", "line": "steps"}},
    {"mode": "operator_g_pending", "pattern": "any", "request": {"verb": "cancel", "noun": "input"}},

    {"mode": "g_pending", "keys": "g", "request": {"verb": "move", "noun": "input", "args": {"motion": "first-line"}}, "from": {"line": "count"}},
    {"mode": "g_pending", "pattern": "any", "request": {"verb": "cancel", "noun": "input"}},

    {"mode": "insert", "keys": "esc", "request": {"verb": "set", "noun": "mode", "args": {"mode": "normal"}}},
    {"mode": "insert", "keys": "tab", "request": {"verb": "open", "noun": "completion"}},
    {"mode": "insert", "expand": "readline-motion", "request": {"verb": "move", "noun": "input", "args": {"motion": "$"}}},
    {"mode": "insert", "expand": "kill", "request": {"verb": "kill", "noun": "input", "args": {"motion": "$"}}},
    {"mode": "insert", "keys": "ctrl+y", "request": {"verb": "paste", "noun": "input", "args": {"before": true, "literal": true}}},
    {"mode": "insert", "keys": "backspace", "request": {"verb": "delete", "noun": "input", "args": {"direction": "backward"}}},
    {"mode": "insert", "keys": "ctrl+h", "request": {"verb": "delete", "noun": "input", "args": {"direction": "backward"}}},
    {"mode": "insert", "keys": "delete", "request": {"verb": "delete", "noun": "input"}},
    {"mode": "insert", "keys": "ctrl+d", "request": {"verb": "delete", "noun": "input"}},
    {"mode": "insert", "keys": "enter", "when": "multiline", "request": {"verb": "insert", "noun": "input", "args": {"text": "\n"}}},
    {"mode": "insert", "keys": "space", "request": {"verb": "insert", "noun": "input", "args": {"text": " "}}},
    {"mode": "insert", "pattern": "printable", "request": {"verb": "insert", "noun": "input"}, "from": {"text": "text"}},
    {"mode": "insert", "pattern": "paste", "request": {"verb": "insert", "noun": "input"}, "from": {"text": "text"}}
  ]
}
